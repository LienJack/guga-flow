<file path="src/socket/chatMessagesData.d.ts">
 1: import type { ToolCallEventType } from './adapters/agui/types/events';
 2: 
 3: export type ChatMessageStatus = 'pending' | 'streaming' | 'complete' | 'stop' | 'error';
 4: export type AttachmentType = 'image' | 'video' | 'audio' | 'pdf' | 'doc' | 'ppt' | 'txt';
 5: export type ChatComment = 'good' | 'bad' | '';
 6: 
 7: // 基础内容接口
 8: export interface ChatBaseContent<T extends string, D> {
 9:   type: T;
10:   data: D;
11:   status?: ChatMessageStatus;
12:   id?: string;
13:   strategy?: 'merge' | 'append';
14:   ext?: Record<string, any>;
15: }
16: 
17: // 内容类型定义
18: export type TextContent = ChatBaseContent<'text', string>;
19: export type MarkdownContent = ChatBaseContent<'markdown', string>;
20: export type ImageContent = ChatBaseContent<'image', { name?: string; url?: string; width?: number; height?: number }>;
21: export type ThinkingContent = ChatBaseContent<'thinking', { text?: string; title?: string }>;
22: export type SearchContent = ChatBaseContent<'search', { title?: string; references?: { title: string; icon?: string; type?: string; url?: string; content?: string; site?: string; date?: string }[] }>;
23: export type SuggestionContent = ChatBaseContent<'suggestion', { title: string; prompt?: string }[]>;
24: export type AttachmentContent = ChatBaseContent<'attachment', { fileType: AttachmentType; size?: number; name?: string; url?: string; isReference?: boolean; width?: number; height?: number; extension?: string; metadata?: Record<string, any> }[]>;
25: export type ToolCallContent = ChatBaseContent<'toolcall', { toolCallId: string; toolCallName: string; eventType?: ToolCallEventType; parentMessageId?: string; args?: string; chunk?: string; result?: string }>;
26: export type ActivityContent<T = Record<string, any>> = ChatBaseContent<'activity', { activityType: string; messageId?: string; content: T; deltaInfo?: { fromIndex: number; toIndex: number } }>;
27: 
28: // 聚合内容类型
29: export type AIMessageContent = TextContent | MarkdownContent | ImageContent | ThinkingContent | SearchContent | SuggestionContent | ReasoningContent | ToolCallContent | ActivityContent;
30: export type ReasoningContent = ChatBaseContent<'reasoning', AIMessageContent[]>;
31: export type UserMessageContent = TextContent | AttachmentContent;
32: 
33: // 消息类型定义
34: export interface ChatBaseMessage {
35:   id: string;
36:   status?: ChatMessageStatus;
37:   datetime?: string;
38:   ext?: any;
39: }
40: 
41: export interface UserMessage extends ChatBaseMessage {
42:   role: 'user';
43:   content: UserMessageContent[];
44: }
45: 
46: export interface AIMessage extends ChatBaseMessage {
47:   role: 'assistant';
48:   content?: AIMessageContent[];
49:   history?: AIMessageContent[][];
50:   comment?: ChatComment;
51: }
52: 
53: export interface SystemMessage extends ChatBaseMessage {
54:   role: 'system';
55:   content: TextContent[];
56: }
57: 
58: export type ChatMessagesData = UserMessage | AIMessage | SystemMessage;
