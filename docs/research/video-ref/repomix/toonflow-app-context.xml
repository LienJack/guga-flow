121: export async function useSkill(input: SkillInput) {
122:   const { mainSkill, workspace = [], attachedSkills = [] } = input;
123:   const rootDir = getPath("skills");
124:   const normalizedRootDir = path.resolve(rootDir);
125: 
126:   const mainSkills: { path: string; name: string; description: string }[] = [];
127:   for (const skill of mainSkill) {
128:     const skillPath = path.join(rootDir, skill + ".md");
129:     if (!fs.existsSync(skillPath)) throw new Error(`主技能文件不存在: ${skillPath}`);
130:     if (!isPathInside(skillPath, normalizedRootDir)) throw new Error(`技能名称无效：检测到路径穿越。${skillPath}`);
131:     const content = await fs.promises.readFile(skillPath, "utf-8");
132:     const parsed = parseFrontmatter(content);
133:     mainSkills.push({ path: skillPath, ...parsed });
134:   }
135: 
136:   const resolveSafeSkillDir = (dir: string): string | null => {
137:     const resolvedDir = path.resolve(normalizedRootDir, dir);
138:     const isSafeDir = resolvedDir === normalizedRootDir || isPathInside(resolvedDir, normalizedRootDir);
139:     return isSafeDir ? resolvedDir : null;
140:   };
141: 
142:   const getMdFiles = (dir: string, recursive = false): string[] => {
143:     if (!fs.existsSync(dir)) return [];
144:     return fs.readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {
145:       const fullPath = path.join(dir, entry.name);
146:       if (entry.isFile() && entry.name.endsWith(".md")) return [fullPath];
147:       return entry.isDirectory() && recursive ? getMdFiles(fullPath, true) : [];
148:     });
149:   };
150:   const collectMdFiles = (dirs: string[], recursive: boolean) =>
151:     dirs.flatMap((dir) => {
152:       const safeDir = resolveSafeSkillDir(dir);
153:       if (!safeDir) return [];
154:       return getMdFiles(safeDir, recursive).map((file) => toUnixPath(path.relative(normalizedRootDir, file)));
155:     });
156: 
157:   const skillPaths: SkillPaths = {
158:     mainSkill: mainSkills,
159:     secondarySkills: collectMdFiles(workspace, false),
160:     tertiarySkills: collectMdFiles(attachedSkills, true),
161:   };
162: 
163:   return { prompt: buildSkillPrompt(mainSkills), tools: createSkillTools(mainSkills, skillPaths), skillPaths };
164: }
