<file path="src/utils/agent/embedding.ts">
 1: import * as ONNX_WEB from "onnxruntime-web";
 2: import { pipeline, env as transformersEnv, FeatureExtractionPipeline } from "@huggingface/transformers";
 3: import path from "path";
 4: import fs from "fs";
 5: import getPath from "@/utils/getPath";
 6: import db from "@/utils/db";
 7: 
 8: // ── 模型配置 ──
 9: // const modelOnnxFile = ["all-MiniLM-L6-v2", "onnx", "model_fp16.onnx"]; // 模型文件路径
10: // const modelDtype = "fp16" as const; // 量化类型：fp32
11: let extractor: FeatureExtractionPipeline | null = null;
12: 
13: export async function initEmbedding(): Promise<void> {
14:   if (extractor) return;
15: 
16:   const modelConfigData = await db("o_setting").whereIn("key", ["modelOnnxFile", "modelDtype"]);
17:   const modelObj: Record<string, string> = {};
18:   Object.entries(modelConfigData).forEach(([key, value]) => {
19:     modelObj[key] = value as string;
20:   });
21:   let modelOnnxFile = modelObj?.modelOnnxFile ? JSON.parse(modelObj.modelOnnxFile) : ["all-MiniLM-L6-v2", "onnx", "model_fp16.onnx"]; // 模型文件路径
22:   let modelDtype = modelObj?.modelDtype ?? ("fp16" as const); // 量化类型：fp32
23:   const onnxPath = path.join(getPath("models"), ...modelOnnxFile);
24:   if (!fs.existsSync(onnxPath)) {
25:     throw new Error(`Embedding 模型文件不存在: ${onnxPath}`);
26:   }
27: 
28:   transformersEnv.allowRemoteModels = false;
29:   transformersEnv.allowLocalModels = true;
30:   transformersEnv.localModelPath = getPath("models").replace(/\\/g, "/") + "/";
31: 
32:   const modelFolder = modelOnnxFile[0];
33:   // @ts-ignore - pipeline 重载联合类型过于复杂
34:   extractor = await pipeline("feature-extraction", modelFolder, { dtype: modelDtype });
35: }
36: 
37: export async function getEmbedding(text: string): Promise<number[]> {
38:   if (!extractor) await initEmbedding();
39:   const output = await extractor!(text, { pooling: "mean", normalize: true });
40:   return Array.from(output.data as Float32Array);
41: }
42: 
43: export function cosineSimilarity(a: number[], b: number[]): number {
44:   return a.reduce((dot, v, i) => dot + v * b[i], 0);
45: }
46: 
47: export async function disposeEmbedding(): Promise<void> {
48:   await extractor?.dispose?.();
49:   extractor = null;
50: }
</file>

<file path="src/utils/agent/memory.ts">
  1: import u from "@/utils";
  2: import { v4 as uuidv4 } from "uuid";
  3: import { getEmbedding, cosineSimilarity } from "./embedding";
  4: import type { memories as MemoryRow } from "@/types/database";
  5: import { tool, jsonSchema } from "ai";
  6: import { z } from "zod";
  7: 
  8: // ── 可调配置默认值 ──
  9: const DEFAULTS: {
 10:   messagesPerSummary: number;
 11:   summaryMaxLength: number;
 12:   shortTermLimit: number;
 13:   summaryLimit: number;
 14:   ragLimit: number;
 15:   deepRetrieveSummaryLimit: number;
 16: } = {
 17:   messagesPerSummary: 3, // 每累积多少条message触发一次summary生成
 18:   summaryMaxLength: 500, // summary最大字符长度
 19:   shortTermLimit: 5, // get()返回的近期未总结message条数
 20:   summaryLimit: 10, // get()返回的summary条数
 21:   ragLimit: 3, // get()向量相似搜索返回的message条数
 22:   deepRetrieveSummaryLimit: 5, // deepRetrieve()向量召回summary的条数
 23: };
 24: 
 25: // ── 向量搜索辅助 ──
 26: function vectorSearch(rows: MemoryRow[], queryEmbedding: number[], limit: number) {
 27:   return rows
 28:     .map((row) => {
 29:       const emb: number[] = JSON.parse(row.embedding ?? "[]");
 30:       return { ...row, similarity: cosineSimilarity(queryEmbedding, emb) };
 31:     })
 32:     .sort((a, b) => b.similarity - a.similarity)
 33:     .slice(0, limit);
 34: }
