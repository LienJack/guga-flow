300: // 内容流基类
301: class ContentStream<T> {
302:   protected socket: Socket;
303:   protected messageId: string;
304:   protected contentId: string;
305:   protected contentType: ContentType;
306: 
307:   constructor(socket: Socket, messageId: string, contentId: string, contentType: ContentType) {
308:     this.socket = socket;
309:     this.messageId = messageId;
310:     this.contentId = contentId;
311:     this.contentType = contentType;
312:   }
313: 
314:   get id() {
315:     return this.contentId;
316:   }
317: 
318:   // 流式追加数据
319:   append(chunk: string) {
320:     this.socket.emit("content:update", {
321:       messageId: this.messageId,
322:       contentId: this.contentId,
323:       type: this.contentType,
324:       data: chunk,
325:       strategy: "append",
326:       status: "streaming",
327:     });
328:     return this;
