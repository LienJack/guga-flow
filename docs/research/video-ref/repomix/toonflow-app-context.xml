17:     if (!parseResult.success) {
18:       const errors = parseResult.error.issues.map((issue) => `字段 ${issue.path.join(".")} ${issue.message}`);
19:       console.error(errors);
20:       return res.status(400).json({ message: "参数错误", errors });
21:     }
22:     next();
23:   };
24: }
