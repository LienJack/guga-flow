  8:   ImageContent,
  9:   ThinkingContent,
 10:   SearchContent,
 11:   SuggestionContent,
 12:   ToolCallContent,
 13:   ActivityContent,
 14:   ReasoningContent,
 15: } from "./chatMessagesData";
 16: 
 17: type ContentType = AIMessageContent["type"];
 18: 
 19: class ResTool {
 20:   public socket: Socket;
 21:   public data: Record<string, any>;
 22: 
 23:   constructor(socket: Socket, data: Record<string, any> = {}) {
 24:     this.socket = socket;
 25:     this.data = data;
 26:   }
 27: 
 28:   // 创建新消息
 29:   newMessage(role: "assistant" | "user" | "system" = "assistant", name?: string) {
 30:     const messageId = u.uuid();
 31:     const datetime = new Date().toISOString();
 32: 
 33:     this.socket.emit("message", {
 34:       id: messageId,
 35:       role,
 36:       name,
 37:       status: "pending" as ChatMessageStatus,
 38:       datetime,
 39:       content: [],
 40:     });
 41: 
 42:     return new MessageBuilder(this.socket, messageId, role, name, datetime);
 43:   }
 44: 
 45:   // 发送错误消息
 46:   sendError(messageId: string, error: string) {
 47:     this.socket.emit("message:update", {
 48:       id: messageId,
 49:       status: "error" as ChatMessageStatus,
 50:       ext: { error },
 51:     });
 52:   }
 53: 
 54:   // 发送完成状态
 55:   sendComplete(messageId: string) {
 56:     this.socket.emit("message:update", {
 57:       id: messageId,
 58:       status: "complete" as ChatMessageStatus,
 59:     });
 60:   }
 61: }
