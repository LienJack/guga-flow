20:     await u.db("o_novel").where("projectId", id).delete();
21:     // 删除项目下的剧本信息
22:     const scriptData = await u.db("o_script").where("projectId", id).select("id");
23:     const scriptIds = scriptData.map((item: any) => item.id);
24:     if (scriptIds && scriptIds.length > 0) {
25:       await u.db("o_scriptAssets").whereIn("scriptId", scriptIds).delete();
26:     }
27:     await u.db("o_script").where("projectId", id).delete();
28:     // 删除项目下的任务
29:     await u.db("o_tasks").where("projectId", id).delete();
30:     // 删除项目下的分镜
31:     const storyboardData = await u.db("o_storyboard").where("projectId", id).select("id");
32:     const storyboardIds = storyboardData.map((item: any) => item.id);
33:     if (storyboardIds.length > 0) {
34:       await u.db("o_assets2Storyboard").whereIn("storyboardId", storyboardIds).delete();
35:     }
36:     await u.db("o_storyboard").where("projectId", id).delete();
37:     //删除需要删除资产的归属图片
38:     const assetsData = await u.db("o_assets").where("projectId", id).select("id");
39:     const assetsIds = assetsData.map((item: any) => item.id);
