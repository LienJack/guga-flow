400: // 文本内容流：自动把 <think>...</think> 转为 thinking 内容
401: class AutoThinkingTextStream extends ContentStream<string> {
402:   private static readonly OPEN_TAG = "<think>";
403:   private static readonly CLOSE_TAG = "</think>";
404: 
405:   private readonly messageBuilder: MessageBuilder;
406:   private pending = "";
407:   private inThinking = false;
408:   private thinkingStream: ThinkingStream | null = null;
409: 
410:   constructor(socket: Socket, messageId: string, contentId: string, messageBuilder: MessageBuilder) {
411:     super(socket, messageId, contentId, "text");
412:     this.messageBuilder = messageBuilder;
413:   }
414: 
415:   override append(chunk: string) {
416:     if (!chunk) return this;
417: 
418:     let rest = this.pending + chunk;
419:     this.pending = "";
420: 
421:     while (rest.length > 0) {
422:       if (!this.inThinking) {
423:         const openIndex = rest.indexOf(AutoThinkingTextStream.OPEN_TAG);
424:         if (openIndex < 0) {
425:           const keepLen = AutoThinkingTextStream.OPEN_TAG.length - 1;
426:           const flushLen = Math.max(0, rest.length - keepLen);
427:           if (flushLen > 0) {
428:             this.appendText(rest.slice(0, flushLen));
429:             rest = rest.slice(flushLen);
430:           }
431:           this.pending = rest;
432:           break;
433:         }
434: 
435:         this.appendText(rest.slice(0, openIndex));
436:         this.inThinking = true;
437:         this.ensureThinkingStream();
438:         rest = rest.slice(openIndex + AutoThinkingTextStream.OPEN_TAG.length);
439:         continue;
440:       }
441: 
442:       const closeIndex = rest.indexOf(AutoThinkingTextStream.CLOSE_TAG);
443:       if (closeIndex < 0) {
444:         const keepLen = AutoThinkingTextStream.CLOSE_TAG.length - 1;
445:         const flushLen = Math.max(0, rest.length - keepLen);
446:         if (flushLen > 0) {
447:           this.appendThinking(rest.slice(0, flushLen));
448:           rest = rest.slice(flushLen);
449:         }
450:         this.pending = rest;
451:         break;
452:       }
453: 
454:       this.appendThinking(rest.slice(0, closeIndex));
455:       this.finishThinking();
456:       rest = rest.slice(closeIndex + AutoThinkingTextStream.CLOSE_TAG.length);
457:     }
458: 
459:     return this;
460:   }
461: 
462:   override complete(finalData?: string) {
463:     if (finalData) {
464:       this.append(finalData);
465:     }
466: 
467:     if (this.pending) {
468:       if (this.inThinking) {
469:         this.appendThinking(this.pending);
470:       } else {
471:         this.appendText(this.pending);
472:       }
473:       this.pending = "";
474:     }
475: 
476:     this.finishThinking();
477:     super.complete();
478:     return this;
479:   }
480: 
481:   override error() {
482:     if (this.thinkingStream) {
483:       this.thinkingStream.error();
484:       this.thinkingStream = null;
485:     }
486:     this.pending = "";
487:     this.inThinking = false;
488:     return super.error();
489:   }
490: 
491:   private appendText(text: string) {
492:     if (!text) return;
493:     super.append(text);
494:   }
495: 
496:   private appendThinking(text: string) {
497:     if (!text) return;
498:     this.ensureThinkingStream().appendText(text);
499:   }
500: 
501:   private ensureThinkingStream() {
502:     if (!this.thinkingStream) {
503:       this.thinkingStream = this.messageBuilder.thinking("思考中...");
504:     }
505:     return this.thinkingStream;
506:   }
507: 
508:   private finishThinking() {
509:     if (this.thinkingStream) {
510:       this.thinkingStream.complete();
511:       this.thinkingStream = null;
512:     }
513:     this.inThinking = false;
514:   }
515: }
