<file path="src/routes/production/assets/batchGenerateAssetsImage.ts">
  1: import express from "express";
  2: import u from "@/utils";
  3: import { z } from "zod";
  4: import sharp from "sharp";
  5: import { success } from "@/lib/responseFormat";
  6: import { validateFields } from "@/middleware/middleware";
  7: import { Output } from "ai";
  8: const router = express.Router();
  9: 
 10: export default router.post(
 11:   "/",
 12:   validateFields({
 13:     assetIds: z.array(z.number()),
 14:     projectId: z.number(),
 15:     scriptId: z.number(),
 16:     concurrentCount: z.number().min(1).optional(),
 17:   }),
 18:   async (req, res) => {
 19:     const { assetIds, projectId, scriptId, concurrentCount = 5 } = req.body;
 20: 
 21:     const projectSettingData = await u.db("o_project").where("id", projectId).select("imageModel", "imageQuality", "artStyle").first();
 22: 
 23:     const assetsDataArr = await u.db("o_assets").whereIn("id", assetIds).select("id", "describe", "name", "type", "assetsId");
 24:     const parentIds = assetsDataArr.map((item) => item.assetsId).filter((id) => id !== null);
 25:     const parentAssetsData = await u
 26:       .db("o_assets")
 27:       .leftJoin("o_image", "o_assets.imageId", "o_image.id")
 28:       .whereIn("o_assets.id", parentIds as number[])
 29:       .select("o_assets.id", "o_image.filePath", "o_assets.describe");
 30:     assetsDataArr.forEach((i: any) => {
 31:       const parent = parentAssetsData.find((item) => item.id === i.assetsId);
 32:       if (parent) {
 33:         i.parentDescribe = parent.describe;
 34:       }
 35:     });
 36:     const imageUrlRecord: Record<number, string> = {};
 37:     parentAssetsData.forEach((item) => {
 38:       if (item.filePath) imageUrlRecord[item.id] = item.filePath;
 39:     });
 40:     const rolePrompt = u.getArtPrompt(projectSettingData!.artStyle!, "art_skills", "art_character_derivative");
 41:     const toolPrompt = u.getArtPrompt(projectSettingData!.artStyle!, "art_skills", "art_prop_derivative");
 42:     const scenePrompt = u.getArtPrompt(projectSettingData!.artStyle!, "art_skills", "art_scene_derivative");
 43:     const promptRecord: Record<string, { prompt: string }> = {
 44:       role: {
 45:         prompt: rolePrompt,
 46:       },
 47:       tool: {
 48:         prompt: toolPrompt,
 49:       },
 50:       scene: {
 51:         prompt: scenePrompt,
 52:       },
 53:     };
 54:     // 先批量为所有 assets 创建 image 记录并标记为"生成中"
 55:     const imageIdMap: Record<number, number> = {};
 56:     for (const item of assetsDataArr) {
 57:       const [imageId] = await u.db("o_image").insert({
 58:         assetsId: item.id,
 59:         type: item.type,
 60:         state: "生成中",
 61:         resolution: projectSettingData?.imageQuality,
 62:         model: projectSettingData?.imageModel,
 63:       });
 64:       imageIdMap[item.id!] = imageId;
 65:       await u.db("o_assets").where("id", item.id).update({ imageId: imageId });
 66:     }
 67: 
 68:     const imageData: { id: number; state: string; src: string }[] = [];
 69:     res.status(200).send(success("开始生成资产图片"));
 70:     const generateSingleAsset = async (item: any) => {
 71:       const imageId = imageIdMap[item.id!];
 72:       const typeConfig = promptRecord[item.type!] || promptRecord["role"];
 73: 
 74:       const { text } = await u.Ai.Text("universalAi").invoke({
 75:         system: `${typeConfig.prompt}`,
 76:         messages: [
 77:           {
 78:             role: "user",
 79:             content: `
 80:             父级资产描述: ${item.parentDescribe || "无详细描述"}
 81:             当前资产描述: ${item.describe || "无详细描述"}`,
 82:           },
 83:         ],
 84:       });
 85:         await u.db("o_assets").where("id", item.id).update({ prompt: text });
 86: 
 87:       const imageBase64 = imageUrlRecord[item.assetsId!] ? await u.oss.getImageBase64(imageUrlRecord[item.assetsId!]) : null;
 88:       try {
 89:         const repeloadObj = {
 90:           prompt: text,
 91:           size: projectSettingData?.imageQuality as "1K" | "2K" | "4K",
 92:           aspectRatio: "16:9" as `${number}:${number}`,
 93:         };
 94:         const imageCls = await u.Ai.Image(projectSettingData?.imageModel as `${string}:${string}`).run(
 95:           {
 96:             referenceList: imageBase64 ? [{ type: "image", base64: imageBase64 }] : [],
 97:             ...repeloadObj,
 98:           },
 99:           {
100:             taskClass: "生成图片",
101:             describe: "资产图片生成",
102:             relatedObjects: JSON.stringify(repeloadObj),
103:             projectId: projectId,
104:           },
105:         );
106:         const savePath = `/${projectId}/assets/${scriptId}/${item.type}/${u.uuid()}.jpg`;
107:         await imageCls.save(savePath);
108:         await u.db("o_image").where({ id: imageId }).update({ state: "已完成", filePath: savePath });
109:         return {
110:           id: item.id!,
111:           state: "已完成",
112:           src: await u.oss.getSmallImageUrl(savePath),
113:         };
114:       } catch (e) {
115:         await u
116:           .db("o_image")
117:           .where({ id: imageId })
118:           .update({ state: "生成失败", errorReason: u.error(e).message });
119:         return {
120:           id: item.id!,
121:           state: "生成失败",
122:           src: "",
123:         };
124:       }
125:     };
126: 
127:     // 按 concurrentCount 分批并发执行
128:     for (let i = 0; i < assetsDataArr.length; i += concurrentCount) {
129:       const batch = assetsDataArr.slice(i, i + concurrentCount);
130:       const batchResults = await Promise.all(batch.map(generateSingleAsset));
131:       imageData.push(...batchResults);
132:     }
133:   },
134: );
</file>

