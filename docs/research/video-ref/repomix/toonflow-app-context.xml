 70: function createSocketQueue(delayMs = 800) {
 71:   let lastPromise: Promise<any> = Promise.resolve();
 72:   return <T>(fn: () => Promise<T>): Promise<T> => {
 73:     lastPromise = lastPromise.then(
 74:       () =>
 75:         new Promise<T>((resolve, reject) => {
 76:           setTimeout(() => fn().then(resolve, reject), delayMs);
 77:         }),
 78:     );
 79:     return lastPromise;
 80:   };
 81: }
