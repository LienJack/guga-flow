 2: import getPath from "@/utils/getPath";
 3: import fs from "fs";
 4: import path from "path";
 5: import knex from "knex";
 6: import initDB from "@/lib/initDB";
 7: // import fixDB from "@/lib/fixDB";
 8: import type { DB } from "@/types/database";
 9: import crypto from "crypto";
10: import fixDB from "@/lib/fixDB";
11: 
12: type TableName = keyof DB & string;
13: type RowType<TName extends TableName> = DB[TName];
14: 
15: const dbPath = getPath("db2.sqlite");
16: console.log("数据库目录:", dbPath);
17: const dbDir = path.dirname(dbPath);
18: 
19: // 确保数据库目录存在
20: if (!fs.existsSync(dbDir)) {
21:   fs.mkdirSync(dbDir, { recursive: true });
22: }
23: 
24: // 创建空数据库文件
25: if (!fs.existsSync(dbPath)) {
26:   fs.writeFileSync(dbPath, "");
27: }
28: 
29: const db = knex({
30:   client: "better-sqlite3",
31:   connection: {
32:     filename: dbPath,
33:   },
34:   useNullAsDefault: true,
35: });
36: 
37: (async () => {
38:   await initDB(db);
39:   await fixDB(db);
40:   if (process.env.NODE_ENV == "dev") initKnexType(db);
41: })();
42: 
43: const dbClient = Object.assign(<TName extends TableName>(table: TName) => db<RowType<TName>, RowType<TName>[]>(table), db);
44: dbClient.schema = db.schema;
45: export default dbClient;
46: 
47: export { db };
48: 
49: async function initKnexType(knexDb: any) {
50:   const { Client } = await import("@rmp135/sql-ts");
51:   const outFile = "src/types/database.d.ts";
52:   const dbClient = Client.fromConfig({
53:     interfaceNameFormat: "${table}",
54:     typeMap: {
55:       number: ["bigint"],
56:       string: ["text", "varchar", "char"],
57:     },
58:   }).fetchDatabase(knexDb);
59:   const declarations = await dbClient.toTypescript();
60:   const dbObject = await dbClient.toObject();
61:   const customHeader = `//该文件由脚本自动生成，请勿手动修改`;
62:   // 清除上次的注释头
63:   let declBody = declarations.replace(/^\/\*[\s\S]*?\*\/\s*/, "");
64:   declBody = declBody.replace(/(\n\s*)\/\*([^*][\s\S]*?)\*\//g, "$1/**$2*/");
65:   const tableInterfaces = dbObject.schemas.flatMap((schema) => schema.tables.map((table) => table.interfaceName));
66:   const aggregateTypes = `
67: export interface DB {
68: ${tableInterfaces.map((name) => `  ${JSON.stringify(name)}: ${name};`).join("\n")}
69: }
70: `;
71:   // 哈希仅基于结构化信息，header和空格不算
72:   const hashSource = JSON.stringify({
73:     tableInterfaces,
74:     declBody,
75:   });
76:   const hash = crypto.createHash("md5").update(hashSource).digest("hex");
77:   // 文件内容
78:   const content = `// @db-hash ${hash}\n${customHeader}\n\n` + declBody + aggregateTypes;
79:   let needWrite = true;
80:   try {
81:     const current = await readFile(outFile, "utf8");
82:     // 文件头已存在相同 hash，不需要写
83:     const match = current.match(/^\/\/\s*@db-hash\s*([a-zA-Z0-9]+)\n/);
84:     const currentHash = match ? match[1] : null;
85:     if (currentHash === hash) {
86:       needWrite = false;
87:     }
88:   } catch (err) {
89:     needWrite = true;
90:   }
91:   if (needWrite) await writeFile(outFile, content, "utf8");
92: }
</file>

<file path="src/utils/error.ts">
 1: // utils/error.ts
 2: import { serializeError } from "serialize-error";
 3: import { isAxiosError } from "axios";
 4: 
 5: export interface NormalizedError {
 6:   name: string;
 7:   message: string;
 8:   code?: string;
 9:   status?: number;
10:   stack?: string;
11:   cause?: NormalizedError;
12:   responseData?: unknown;
13:   meta?: Record<string, unknown>;
14: }
15: 
16: export function normalizeError(error: unknown): NormalizedError {
17:   // Axios 特殊处理
18:   if (isAxiosError(error)) {
19:     return {
20:       name: "AxiosError",
21:       message: error.response?.data?.error?.message || error.response?.data?.message || error.message,
22:       code: error.code,
23:       status: error.response?.status,
24:       stack: error.stack,
25:       responseData: error.response?.data,
26:       meta: {
27:         url: error.config?.url,
28:         method: error.config?.method,
29:       },
30:     };
31:   }
32: 
33:   // 普通 Error，用 serialize-error 处理
34:   if (error instanceof Error) {
35:     const serialized = serializeError(error);
36:     return {
37:       name: serialized.name || "Error",
38:       message: serialized.message || "未知错误",
39:       code: (serialized as any).code,
40:       stack: serialized.stack,
41:       cause: error.cause ? normalizeError(error.cause) : undefined,
42:       meta: extractMeta(serialized),
43:     };
44:   }
45: 
46:   // 非 Error
47:   return {
48:     name: "UnknownError",
49:     message: String(error),
50:     meta: { raw: serializeError(error) },
51:   };
52: }
53: 
54: // 提取自定义属性
55: function extractMeta(obj: Record<string, unknown>): Record<string, unknown> | undefined {
56:   const standardKeys = ["name", "message", "stack", "cause"];
57:   const meta: Record<string, unknown> = {};
58: 
59:   for (const [key, value] of Object.entries(obj)) {
60:     if (!standardKeys.includes(key) && value !== undefined) {
61:       meta[key] = value;
62:     }
63:   }
64: 
65:   return Object.keys(meta).length > 0 ? meta : undefined;
66: }
67: 
68: export default normalizeError;
</file>

<file path="src/utils/getArtPrompt.ts">
 1: import fs from "fs";
 2: import path from "path";
 3: import getPath from "./getPath";
 4: 
 5: /**
 6:  * 传入一个指定路径参数（风格名称），以及一个指定文件名，递归获取该文件并返回其内容
 7:  * @param styleName - 风格目录名，例如 "chinese_sweet_romance"
 8:  * @param fileName  - 目标文件名（不含 .md 后缀），例如 "art_character"、"prefix"
 9:  * @returns 文件内容字符串，未找到时返回空字符串
10:  */
11: export function getArtPrompt(styleName: string, source: string, fileName: string): string {
12:   const baseDir = getPath(["skills", source, styleName]);
13: 
14:   if (!fs.existsSync(baseDir)) {
15:     return "";
16:   }
17: 
18:   // 获取 prefix.md 内容
19:   const prefixFile = findFileRecursive(baseDir, "prefix.md");
20:   const prefixContent = prefixFile ? fs.readFileSync(prefixFile, "utf-8") : "";
21: 
22:   const target = fileName.endsWith(".md") ? fileName : `${fileName}.md`;
23:   const found = findFileRecursive(baseDir, target);
24: 
25:   if (!found) {
26:     return prefixContent;
27:   }
28: 
29:   const fileContent = fs.readFileSync(found, "utf-8");
30:   return prefixContent ? `${prefixContent}\n${fileContent}` : fileContent;
31: }
32: /**
33:  * 传入风格目录名，获取该风格下所有 .md 文件内容，按文件名映射返回
34:  * @param styleName - 风格目录名，例如 "chinese_sweet_romance"
35:  * @returns Record<文件名(不含后缀), 文件内容>
36:  */
37: export function getAllArtPrompts(styleName: string, source: string): Record<string, string> {
38:   const baseDir = getPath(["skills", source, styleName]);
39: 
40:   if (!fs.existsSync(baseDir)) {
41:     return {};
42:   }
43: 
44:   const result: Record<string, string> = {};
45:   collectMdFiles(baseDir, result);
46:   return result;
47: }
48: 
49: /**
50:  * 递归查找指定文件名的文件，返回第一个匹配的完整路径
51:  */
52: function findFileRecursive(dir: string, targetName: string): string | null {
53:   const entries = fs.readdirSync(dir, { withFileTypes: true });
54: 
55:   for (const entry of entries) {
56:     const fullPath = path.join(dir, entry.name);
57: 
58:     if (entry.isFile() && entry.name === targetName) {
59:       return fullPath;
60:     }
61: 
62:     if (entry.isDirectory()) {
63:       const found = findFileRecursive(fullPath, targetName);
64:       if (found) return found;
65:     }
66:   }
67: 
68:   return null;
69: }
70: 
71: /**
72:  * 递归收集目录下所有 .md 文件内容
73:  */
74: function collectMdFiles(dir: string, result: Record<string, string>): void {
75:   const entries = fs.readdirSync(dir, { withFileTypes: true });
76: 
77:   for (const entry of entries) {
78:     const fullPath = path.join(dir, entry.name);
79: 
80:     if (entry.isFile() && entry.name.endsWith(".md")) {
81:       const key = entry.name.replace(/\.md$/, "");
82:       result[key] = fs.readFileSync(fullPath, "utf-8");
83:     }
84: 
85:     if (entry.isDirectory()) {
86:       collectMdFiles(fullPath, result);
87:     }
88:   }
89: }
</file>

