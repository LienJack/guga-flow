 1: import { EventEmitter } from "events";
 2: import { o_novel } from "@/types/database";
 3: import u from "@/utils";
 4: import { stripThink } from "@/utils/stripThink";
 5: export interface EventType {
 6:   id: number;
 7:   event: string;
 8: }
 9: 
10: /*  文本数据清洗
11:  * @param textData 需要清洗的文本
12:  * @param windowSize 每组数量 默认5
13:  * @param overlap 交叠数量 默认1
14:  * @returns {totalCharacter:所有人物角色卡,totalEvent:所有事件}
15:  */
16: 
17: class CleanNovel {
18:   emitter: EventEmitter;
19:   /** 最大并发数 */
20:   concurrency: number;
21: 
22:   constructor(concurrency: number = 5) {
23:     this.emitter = new EventEmitter();
24:     this.concurrency = concurrency;
25:   }
26: 
27:   private async processChapter(novel: o_novel): Promise<EventType | null> {
28:     try {
29:       const prompt = await u.getPrompts("event");
30:       const promptData = await u.db("o_prompt").where("type", "eventExtraction").first();
31:       let eventExtraction = "" as string | undefined;
32:       if (promptData && promptData.useData) {
33:         eventExtraction = promptData.useData;
34:       } else {
35:         eventExtraction = promptData?.data ?? undefined;
36:       }
37:       const resData = await u.Ai.Text("universalAi").invoke({
38:         system: eventExtraction ? JSON.stringify(eventExtraction) : (prompt as string),
39:         messages: [
40:           {
41:             role: "user",
42:             content:
43:               "请根据以下小说章节数：" +
44:               novel.chapterIndex +
45:               "小说章节券：" +
46:               novel.reel +
47:               "小说章节名称：" +
48:               novel.chapter +
49:               "、小说章节内容生成事件摘要：\n" +
50:               novel.chapterData!,
51:           },
52:         ],
53:       });
54:       const preData = stripThink(resData.text);
55:       this.emitter.emit("item", { id: novel.id, event: preData });
56:       return { id: novel.id!, event: preData };
57:     } catch (e) {
58:       this.emitter.emit("item", { id: novel.id, event: null, errorReason: u.error(e).message });
59:       return null;
60:     }
61:   }
62: 
63:   async start(allChapters: o_novel[], projectId: number): Promise<EventType[]> {
64:     const totalEvent: EventType[] = [];
65: 
66:     // 并发控制：通过信号量限制同时执行的任务数
67:     let running = 0;
68:     let index = 0;
69:     const results: Promise<void>[] = [];
70: 
71:     const runNext = (): Promise<void> => {
72:       if (index >= allChapters.length) return Promise.resolve();
73:       const novel = allChapters[index++];
74:       running++;
75: 
76:       return this.processChapter(novel).then((result) => {
77:         if (result) totalEvent.push(result);
78:         running--;
79:         return runNext();
80:       });
81:     };
82: 
83:     // 启动最多 concurrency 个并发任务
84:     const workers = Array.from({ length: Math.min(this.concurrency, allChapters.length) }, () => runNext());
85: 
86:     await Promise.all(workers);
87: 
88:     return totalEvent;
89:   }
90: }
91: 
92: export default CleanNovel;
</file>

