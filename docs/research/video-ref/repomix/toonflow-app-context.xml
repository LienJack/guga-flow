169:         reason: item?.reason ?? "",
170:         selectVideoId: Number(item?.videoId)!,
171:         medias: (() => {
172:           const storyboardMedias = storyboardTrackRecord[trackId] ?? [];
173:           const assetMedias = storyboardMedias.flatMap((s) => otherDataMap[s.id] ?? []);
174: 
175:           const seenAssetIds = new Set<number>();
176:           const uniqueAssets = assetMedias.filter((a) => {
177:             if (seenAssetIds.has(a.id)) return false;
178:             seenAssetIds.add(a.id);
179:             return true;
180:           });
181: 
182:           // 有 audioReference 时，按数量截取 audio 类型资产
