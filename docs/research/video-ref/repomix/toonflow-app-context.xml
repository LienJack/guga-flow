 98:       id: this.messageId,
 99:       status,
100:     });
101:     return this;
102:   }
103: 
104:   // 添加文本内容
105:   text(initialText = "") {
106:     const contentId = u.uuid();
107:     const content: TextContent = {
108:       type: "text",
109:       id: contentId,
110:       data: "",
111:       status: "pending",
