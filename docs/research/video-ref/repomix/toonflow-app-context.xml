43:         type: z.literal("video"),
44:         mode: z.array(
45:           z.union([
46:             z.enum(["singleImage", "startEndRequired", "endFrameOptional", "startFrameOptional", "text", "audioReference", "videoReference"]),
47:             z.array(z.string().regex(/^(videoReference|imageReference|audioReference):\d+$/)),
48:           ]),
49:         ),
50:         audio: z.union([z.literal("optional"), z.boolean()]),
51:         durationResolutionMap: z.array(
52:           z.object({
53:             duration: z.array(z.number()),
54:             resolution: z.array(z.string()),
55:           }),
56:         ),
57:       }),
58:     ]),
59:   ),
60: });
