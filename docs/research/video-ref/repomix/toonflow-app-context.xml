 19:         label: z.string(),
 20:         value: z.string(),
 21:         data: z.string(),
 22:       }),
 23:     ),
 24:   }),
 25:   async (req, res) => {
 26:     try {
 27:       const { name, stylePath, images, data } = req.body as {
 28:         name: string;
 29:         stylePath: string;
 30:         images: string[];
 31:         data: { label: string; value: string; data: string }[];
 32:       };
 33: 
 34:       // 安全校验：不允许包含路径分隔符、纯数字，防止越级删除或误删项目目录
 35:       if (name.includes("/") || name.includes("\\") || name === "." || name === ".." || /^\d+$/.test(name)) {
 36:         res.status(400).send(error("名称不能包含路径分隔符或为纯数字"));
 37:         return;
 38:       }
 39: 
 40:       const mainPath = u.getPath(["skills", "art_skills", stylePath]);
 41:       if (!fs.existsSync(mainPath)) {
 42:         return res.status(400).send(error("视觉手册不存在"));
 43:       }
 44:       // 字段映射表（与 getVisualManual 保持一致）
 45:       const DATA_MAP: { value: string; subDir?: string }[] = [
 46:         { value: "README" },
 47:         { value: "prefix" },
 48:         { value: "art_character", subDir: "art_prompt" },
 49:         { value: "art_character_derivative", subDir: "art_prompt" },
 50:         { value: "art_prop", subDir: "art_prompt" },
 51:         { value: "art_prop_derivative", subDir: "art_prompt" },
 52:         { value: "art_scene", subDir: "art_prompt" },
 53:         { value: "art_scene_derivative", subDir: "art_prompt" },
 54:         { value: "director_storyboard", subDir: "driector_skills" },
 55:         { value: "art_storyboard_video", subDir: "art_prompt" },
 56:         { value: "director_planning_style", subDir: "driector_skills" },
 57:         { value: "director_storyboard_table_style", subDir: "driector_skills" },
 58:       ];
 59: 
 60:       // 根据 DATA_MAP 构建 value -> subDir 的映射
 61:       const SUB_DIR_MAP = new Map(DATA_MAP.map(({ value, subDir }) => [value, subDir ?? ""]));
 62: 
 63:       // 合法的 value 值集合，用于校验
 64:       const VALID_KEYS = new Set(DATA_MAP.map(({ value }) => value));
 65: 
 66:       for (const item of data) {
 67:         if (!VALID_KEYS.has(item.value)) continue;
 68: 
 69:         const subDir = SUB_DIR_MAP.get(item.value)!;
 70:         const dirArr = subDir ? [mainPath, subDir] : [mainPath];
 71:         const filePath = u.getPath([...dirArr, `${item.value}.md`]);
 72: 
 73:         const fileDir = path.dirname(filePath);
