113:         relatedObjects: JSON.stringify(relatedObjects),
114:       },
115:     );
116:     aiImage.save(imagePath);
117:     // 5. 更新记录 & 返回结果
118:     const imageData = await u.db("o_image").where("id", imageId).select("*").first();
119:     if (!imageData) return res.status(500).send("资产已被删除");
120:     if (imageData.state === "生成失败") return;
121:     await u
122:       .db("o_image")
123:       .where("id", imageId)
124:       .update({
125:         state: "已完成",
126:         filePath: imagePath,
127:         type,
128:         model: model.split(/:(.+)/)[1],
129:         resolution,
130:       });
131: 
132:     const path = await u.oss.getSmallImageUrl(imagePath);
133:     await u.db("o_assets").where("id", id).update({ imageId });
134: 
135:     return res.status(200).send(success({ path, assetsId: id }));
136:   } catch (e) {
137:     await u
138:       .db("o_image")
139:       .where("id", imageId)
140:       .update({ state: "生成失败", errorReason: u.error(e).message });
141:     return res.status(400).send(error(u.error(e).message || "图片生成失败"));
142:   }
143: });
