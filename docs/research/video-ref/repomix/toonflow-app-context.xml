 63: // 消息构建器
 64: class MessageBuilder {
 65:   private socket: Socket;
 66:   private messageId: string;
 67:   private messageRole: "assistant" | "user" | "system";
 68:   private messageName?: string;
 69:   private messageDatetime: string;
 70: 
 71:   constructor(socket: Socket, messageId: string, role: "assistant" | "user" | "system", name?: string, datetime?: string) {
 72:     this.socket = socket;
 73:     this.messageId = messageId;
 74:     this.messageRole = role;
 75:     this.messageName = name;
 76:     this.messageDatetime = datetime ?? new Date().toISOString();
 77:   }
 78: 
 79:   get id() {
 80:     return this.messageId;
 81:   }
 82: 
 83:   get role() {
 84:     return this.messageRole;
 85:   }
 86: 
 87:   get name() {
 88:     return this.messageName;
 89:   }
 90: 
 91:   get datetime() {
 92:     return this.messageDatetime;
 93:   }
 94: 
 95:   // 更新消息状态
 96:   updateStatus(status: ChatMessageStatus) {
