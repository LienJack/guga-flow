33:     const routeKey = path.relative("src/routes", entry).replace(/\\/g, "/");
34:     const routePath = fileNameToRoutePath(routeKey);
35:     routeModulePairs.push({ routePath, varName, entry });
36:   });
37:   const routerData = JSON.stringify(routeModulePairs.map(({ routePath, varName }) => ({ routePath, varName })));
38:   const hash = crypto.createHash("md5").update(routerData).digest("hex");
39: 
40:   let content = `// @routes-hash ${hash}\nimport { Express } from "express";\n\n`;
41:   content += `${importLines.join("\n")}\n\n`;
42:   content += `export default async (app: Express) => {\n`;
43:   for (const { routePath, varName } of routeModulePairs) {
44:     content += `  app.use("/api${routePath}", ${varName});\n`;
45:   }
46:   content += `}\n`;
47: 
48:   let needWrite = true;
49:   try {
50:     const current = await readFile("src/router.ts", "utf8");
51:     const match = current.match(/^\/\/\s*@routes-hash\s*([a-z0-9]+)\n/);
52:     const currentHash = match ? match[1] : null;
53:     if (currentHash === hash) {
54:       needWrite = false;
55:     }
56:   } catch {
57:     needWrite = true;
58:   }
59:   if (needWrite) await writeFile("src/router.ts", content, "utf8");
60: }
</file>

