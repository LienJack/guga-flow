16:   }),
17:   async (req, res) => {
18:     const { type } = req.body;
19:     const basePath = getPath(["skills", "art_skills", "chinese_sweet_romance"]);
20:     // 递归查找 basePath 下名为 `${type}.md` 的文件
21:     const findFile = (dir: string, target: string): string | null => {
22:       const entries = fs.readdirSync(dir, { withFileTypes: true });
23:       for (const entry of entries) {
24:         const fullPath = path.join(dir, entry.name);
25:         if (entry.isDirectory()) {
26:           const found = findFile(fullPath, target);
27:           if (found) return found;
28:         } else if (entry.isFile() && entry.name === target) {
29:           return fullPath;
30:         }
31:       }
32:       return null;
33:     };
34:     const filePath = findFile(basePath, `${type}.md`);
35:     if (!filePath) {
36:       res.status(404).json({ error: `未找到对应的文件: ${type}.md` });
37:       return;
38:     }
39:     const content = fs.readFileSync(filePath, "utf-8");
40:     res.status(200).send(success(content));
