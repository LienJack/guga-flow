35:       .select("o_assets2Storyboard.storyboardId", "o_assets.id as assetId", "o_assets.name", "o_assets.type", "o_image.filePath as avatar");
36: 
37:     // 按 storyboardId 分组，生成 characters 列表
38:     const storyboardCharactersMap = storyboardConfigs.reduce<Record<number, { name: string; type: string; avatar?: string }[]>>((acc, cur) => {
39:       const storyboardId = cur.storyboardId as number;
40:       if (!acc[storyboardId]) {
41:         acc[storyboardId] = [];
42:       }
43:       const character: { name: string; type: string; avatar?: string } = {
44:         name: cur.name ?? "",
45:         type: cur.type ?? "",
46:       };
47:       if (cur.avatar) {
48:         character.avatar = cur.avatar;
49:       }
50:       acc[storyboardId].push(character);
51:       return acc;
52:     }, {});
53: 
54:     // 组装最终数据，符合 Shot 接口格式
55: 
56:     const result = await Promise.all(
57:       data.map(async (item) => {
58:         const characters = storyboardCharactersMap[item.id as number] ?? [];
59:         // 处理 characters 中的 avatar OSS 路径
60:         const charactersWithUrl = await Promise.all(
61:           characters.map(async (c) => {
62:             if (c.avatar) {
63:               return { ...c, avatar: await u.oss.getSmallImageUrl(c.avatar) };
64:             }
65:             return c;
66:           }),
67:         );
68:         return {
69:           id: String(item.id),
70:           createTime: item.createTime ?? undefined,
71:           duration: item.duration ? Number(item.duration) : undefined,
72:           filePath: item.filePath || undefined,
73:           prompt: item.prompt ?? undefined,
74:           scriptId: item.scriptId ?? undefined,
75:           characters: charactersWithUrl,
76:           index: item.index,
77:         };
78:       }),
79:     );
80:     res.status(200).send(success(result));
81:   },
82: );
