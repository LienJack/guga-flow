 40:   async (req, res) => {
 41:     const { scriptId, projectId, prompt, uploadData, model, duration, resolution, audio, mode, trackId } = req.body;
 42:     let modeData = [];
 43:     if (Array.isArray(mode)) {
 44:     } else if (typeof mode === "string" && mode.startsWith('["') && mode.endsWith('"]')) {
 45:       try {
 46:         modeData = JSON.parse(mode);
 47:       } catch (e) {}
 48:     }
 49:     //获取生成视频比例
 50:     const ratio = await u.db("o_project").select("videoRatio").where("id", projectId).first();
 51:     const videoPath = `/${projectId}/video/${uuidv4()}.mp4`; //视频保存路径
 52:     //查询出图片数据
