<file path="src/routes/production/workbench/generateVideoPrompt.ts">
  1: import express from "express";
  2: import u from "@/utils";
  3: import { z } from "zod";
  4: import { success, error } from "@/lib/responseFormat";
  5: import { validateFields } from "@/middleware/middleware";
  6: import fs from "fs/promises";
  7: import path from "path";
  8: const router = express.Router();
  9: 
 10: export default router.post(
 11:   "/",
 12:   validateFields({
 13:     trackId: z.number(),
 14:     projectId: z.number(),
 15:     info: z.array(
 16:       z.object({
 17:         id: z.number(),
 18:         sources: z.string(),
 19:       }),
 20:     ),
 21:     model: z.string(),
 22:     mode: z.string(),
 23:   }),
 24:   async (req, res) => {
 25:     const { trackId, projectId, info, model, mode } = req.body;
 26:     await u.db("o_videoTrack").where({ id: trackId }).update({
 27:       state: "生成中",
 28:     });
 29:     //查询参数
 30:     const images = await Promise.all(
 31:       info.map(async (item: { id: number; sources: string }) => {
 32:         if (item.sources === "storyboard") {
 33:           // 查询分镜主信息
 34:           const storyboard = await u
 35:             .db("o_storyboard")
 36:             .where("o_storyboard.id", item.id)
 37:             .select("videoDesc", "prompt", "track", "duration", "shouldGenerateImage")
 38:             .first();
 39:           // 查询分镜关联的资产ID
 40:           const assetRows = await u.db("o_assets2Storyboard").where("storyboardId", item.id).orderBy("rowid").select("assetId");
 41:           const associateAssetsIds = assetRows.map((row: any) => row.assetId);
 42:           return {
 43:             ...storyboard,
 44:             associateAssetsIds,
 45:             _type: "storyboard", // 标记类型，便于后续区分
 46:           };
 47:         }
 48:         if (item.sources === "assets") {
 49:           // 查询素材
 50:           const assetsData = await u
 51:             .db("o_assets")
 52:             .leftJoin("o_image", "o_image.id", "o_assets.imageId")
 53:             .where("o_assets.id", item.id)
 54:             .select("o_assets.id", "o_assets.type", "o_assets.name", "o_image.filePath")
 55:             .first();
 56:           return {
 57:             ...assetsData,
 58:             _type: "assets", // 标记类型
 59:           };
 60:         }
 61:       }),
 62:     );
 63: 
 64:     // 拆分 assets 和 storyboard
 65:     const assets: any[] = [];
 66:     const storyboard: any[] = [];
 67:     for (const item of images) {
 68:       if (!item) continue; // 忽略空
 69:       if (item._type === "assets")
 70:         assets.push({
 71:           id: item.id,
 72:           type: item.type,
 73:           name: item.name,
 74:           filePath: item.filePath,
 75:         });
 76:       if (item._type === "storyboard")
 77:         storyboard.push({
 78:           videoDesc: item.videoDesc,
 79:           prompt: item.prompt,
 80:           track: item.track,
 81:           duration: item.duration,
 82:           associateAssetsIds: item.associateAssetsIds,
 83:           shouldGenerateImage: item.shouldGenerateImage,
 84:         });
 85:     }
 86:     const assetsNotAudioIds = assets.filter((i) => i.type == "audio").map((i) => i.id);
 87: 
 88:     const assets2Audio = await u
 89:       .db("o_assets")
 90:       .whereIn("o_assets.id", assetsNotAudioIds)
 91:       .join("o_assetsRole2Audio", "o_assetsRole2Audio.assetsAudioId", "o_assets.assetsId")
 92:       .select("o_assets.assetsId", "o_assets.id", "o_assetsRole2Audio.assetsAudioId", "o_assetsRole2Audio.assetsRoleId");
 93: 
 94:     const assetsAudioRecord: Record<number, number> = {};
 95:     assets2Audio.forEach((i) => {
 96:       assetsAudioRecord[i.assetsRoleId!] = i.id!;
 97:     });
 98: 
 99:     const [id, modelData] = model.split(/:(.+)/);
100:     const projectData = await u.db("o_project").select("*").where({ id: projectId }).first();
101:     const videoPrompt = await u.db("o_prompt").where("type", "videoPromptGeneration").first();
102:     let videoPromptGeneration = "" as string | undefined;
103: 
104:     const modelPromptData = await u.db("o_modelPrompt").where("vendorId", id).where("model", modelData).first();
105:     //查询到 有绑定对应视频提示词
106:     if (modelPromptData) {
107:       const modelPromptRoot = u.getPath(["modelPrompt"]);
108:       try {
109:         const fullPath = path.join(modelPromptRoot, modelPromptData?.path!);
110:         const content = await fs.readFile(fullPath, "utf-8");
111:         videoPromptGeneration = content ?? "";
112:       } catch {}
113:     }
114: 
115:     // 未查询到绑定，根据模型名称 + mode 自动匹配 modelPrompt/video/ 下的文件
116:     if (!videoPromptGeneration) {
117:       const modelPromptRoot = u.getPath(["modelPrompt"]);
118:       const videoPromptDir = path.join(modelPromptRoot, "video");
119:       const modelLower = (modelData ?? "").toLowerCase();
120: 
121:       let fileName: string | null = null;
122: 
123:       if (modelLower.includes("wan") && modelLower.includes("2.6")) {
124:         // wan2.6 系列 => 单图首尾帧模式
125:         fileName = "wan2.6Single-imageFirstFrameMode.md";
126:       } else if (/seedance.*2[.\-]0/i.test(modelData)) {
127:         // seedance 2.0 / 2-0 系列
128:         fileName = "seedance2Multi-parameterMode.md";
129:       } else if (mode === "startEndRequired" || mode === "endFrameOptional" || mode === "startFrameOptional") {
130:         // body.mode 为首尾帧相关 => 通用首尾帧模式
131:         fileName = "universalFirstAndLastFrameMode.md";
132:       } else if (typeof mode === "string" && mode.startsWith('["') && mode.endsWith('"]')) {
133:         // 其他 => 通用多参模式
134:         fileName = "universalMulti-parameterMode.md";
135:       }
136:       if (fileName) {
137:         try {
138:           const fullPath = path.join(videoPromptDir, fileName);
139:           videoPromptGeneration = await fs.readFile(fullPath, "utf-8");
140:         } catch {
141:           // 文件不存在则忽略，继续用备选
142:         }
143:       }
144:     }
145: 
146:     //备选
147:     if (!videoPromptGeneration) {
148:       if (videoPrompt && videoPrompt.useData) {
149:         videoPromptGeneration = videoPrompt.useData;
150:       } else {
151:         videoPromptGeneration = videoPrompt?.data ?? undefined;
152:       }
153:     }
154: 
155:     const artStyle = projectData?.artStyle || "无";
156: 
157:     const visualManual = u.getArtPrompt(artStyle, "art_skills", "art_storyboard_video");
158:     const content = `
159:           **模型名称**：${modelData},
160: 
161:           **资产信息**（角色、场景、道具、音频):${assets
162:             .filter((i) => i.filePath)
163:             .map((i) => `[${i.id},${i.type},${i.name} ${assetsAudioRecord[i.id] ? `audio:${assetsAudioRecord[i.id]}` : ""} ] `)
164:             .join("，")},
165:           **分镜信息**：${storyboard.map(
166:             (i) => `<storyboardItem
167:   videoDesc='${i.videoDesc}'
168:   duration='${i.duration}'
169: ></storyboardItem>`,
170:           )},
171:           `;
172: 
173:     try {
174:       const { text } = await u.Ai.Text("universalAi").invoke({
175:         system: videoPromptGeneration,
176:         messages: [
177:           {
178:             role: "assistant",
179:             content: `${visualManual}`,
180:           },
181:           {
182:             role: "user",
183:             content: content,
184:           },
185:         ],
186:       });
187:       await u.db("o_videoTrack").where({ id: trackId }).update({
188:         state: "已完成",
189:         prompt: text,
190:       });
191:       res.status(200).send(success(text));
192:     } catch (e) {
193:       await u
194:         .db("o_videoTrack")
195:         .where({ id: trackId })
196:         .update({
197:           state: "生成失败",
198:           reason: u.error(e).message,
199:         });
200:       res.status(400).send(error(u.error(e).message));
201:     }
202:   },
203: );
</file>

