40:     const platformType: Record<string, string> = {
41:       win32: "windows",
42:       darwin: "macos",
43:       linux: "linux",
44:     };
45: 
46:     const zipItem = sourceData.find((d: any) => d.type === "zip");
47:     const installerItem = sourceData.find((d: any) => d.type === platformType[process.platform]);
48: 
49:     const taggerList = tagger.split(".").map(Number);
50:     const currentVersionList = APP_VERSION.split(".").map(Number);
51:     //对比Major
52:     if (taggerList[0] > currentVersionList[0]) {
53:       if (!installerItem) return res.status(400).send(error("该源暂无适用于当前系统的安装包"));
54:       return res
55:         .status(200)
56:         .send(success({ needUpdate: true, latestVersion: tagger, reinstall: true, time, url: installerItem.url, version: tagger }));
57:     }
58:     //对比Minor
59:     if (taggerList[1] > currentVersionList[1]) {
60:       if (!installerItem) return res.status(400).send(error("该源暂无适用于当前系统的安装包"));
61:       return res
62:         .status(200)
63:         .send(success({ needUpdate: true, latestVersion: tagger, reinstall: true, time, url: installerItem.url, version: tagger }));
64:     }
65:     //Patch
66:     if (taggerList[2] > currentVersionList[2]) {
67:       if (!zipItem) return res.status(400).send(error("该源暂无增量更新包"));
68:       return res.status(200).send(success({ needUpdate: true, latestVersion: tagger, reinstall: false, time, url: zipItem.url, version: tagger }));
69:     }
70:     return res.status(200).send(success({ needUpdate: false, latestVersion: tagger, reinstall: false, time, version: tagger }));
71:   },
72: );
</file>

