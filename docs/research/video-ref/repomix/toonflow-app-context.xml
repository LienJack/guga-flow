 89:   await consumeFullStream(fullStream, currentMsg, () => {
 90:     if (ctx.msg === currentMsg) return currentMsg;
 91:     currentMsg.complete();
 92:     currentMsg = ctx.msg;
 93:     return currentMsg;
 94:   });
 95: }
