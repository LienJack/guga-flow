<file path="src/logger.ts">
  1: import * as fs from "fs";
  2: import * as path from "path";
  3: import getPath from "@/utils/getPath";
  4: 
  5: type LogLevel = "log" | "info" | "warn" | "error" | "debug";
  6: type ConsoleMethod = (...args: unknown[]) => void;
  7: 
  8: const LOG_DIR = getPath("logs");
  9: const LOG_FILE = path.join(LOG_DIR, "app.log");
 10: const MAX_SIZE = 1000 * 1024 * 1024;
 11: const LEVELS: LogLevel[] = ["log", "info", "warn", "error", "debug"];
 12: 
 13: class Logger {
 14:   private stream: fs.WriteStream | null = null;
 15:   private originalConsole: Partial<Record<LogLevel, ConsoleMethod>> = {};
 16:   private originalStdoutWrite: typeof process.stdout.write | null = null;
 17:   private originalStderrWrite: typeof process.stderr.write | null = null;
 18:   private isHijacked = false;
 19: 
 20:   init(): this {
 21:     if (!fs.existsSync(LOG_DIR)) fs.mkdirSync(LOG_DIR, { recursive: true });
 22:     this.stream = fs.createWriteStream(LOG_FILE, { flags: "a" });
 23:     this.hijack();
 24:     return this;
 25:   }
 26: 
 27:   private formatTime(): string {
 28:     const d = new Date();
 29:     const p = (n: number, l = 2) => String(n).padStart(l, "0");
 30:     return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}.${p(
 31:       d.getMilliseconds(),
 32:       3,
 33:     )}`;
 34:   }
 35: 
 36:   private stringify(arg: unknown): string {
 37:     if (arg == null) return String(arg);
 38:     if (arg instanceof Error) return `${arg.message}\n${arg.stack || ""}`;
 39:     if (typeof arg === "object") {
 40:       try {
 41:         return JSON.stringify(arg);
 42:       } catch {
 43:         return String(arg);
 44:       }
 45:     }
 46:     return String(arg);
 47:   }
 48: 
 49:   private writing = false;
 50: 
 51:   private write(level: LogLevel, args: unknown[]): void {
 52:     const line = `[${this.formatTime()}] [${level.toUpperCase()}] ${args.map((a) => this.stringify(a)).join(" ")}\n`;
 53:     if (this.stream && !this.stream.destroyed) this.stream.write(line);
 54:     this.checkRotate();
 55:   }
 56: 
 57:   private writeRaw(chunk: any): void {
 58:     if (this.writing) return;
 59:     this.writing = true;
 60:     try {
 61:       let str = typeof chunk === "string" ? chunk : chunk?.toString?.("utf-8") ?? "";
 62:       str = str.replace(/\x1B\[\d*m/g, ""); // 去除 ANSI 颜色码
 63:       if (str.trim() && this.stream && !this.stream.destroyed) this.stream.write(str.endsWith("\n") ? str : str + "\n");
 64:     } finally {
 65:       this.writing = false;
 66:     }
 67:   }
 68: 
 69:   private checkRotate(): void {
 70:     try {
 71:       if (!fs.existsSync(LOG_FILE) || fs.statSync(LOG_FILE).size < MAX_SIZE) return;
 72:       this.stream?.end();
 73:       // 单文件轮转：保留后半部分日志
 74:       const content = fs.readFileSync(LOG_FILE, "utf-8");
 75:       const half = content.slice(content.length >>> 1);
 76:       const firstNewline = half.indexOf("\n");
 77:       fs.writeFileSync(LOG_FILE, firstNewline >= 0 ? half.slice(firstNewline + 1) : half);
 78:       this.stream = fs.createWriteStream(LOG_FILE, { flags: "a" });
 79:     } catch {}
 80:   }
 81: 
 82:   private hijack(): void {
 83:     if (this.isHijacked) return;
 84:     // 劫持 console 方法
 85:     for (const level of LEVELS) {
 86:       const original = console[level];
 87:       if (typeof original !== "function") continue;
 88:       this.originalConsole[level] = original.bind(console);
 89:       (console as any)[level] = (...args: unknown[]) => {
 90:         this.writing = true;
 91:         try {
 92:           this.write(level, args);
 93:         } catch (err) {
 94:           this.originalConsole.error?.("[Logger Error]", err);
 95:         }
 96:         this.writing = false;
 97: 
 98:         this.originalConsole[level]!(...args);
 99:       };
100:     }
101: 
102:     // 劫持 stdout/stderr（捕获 morgan 等直接写 stdout 的输出）
103:     this.originalStdoutWrite = process.stdout.write.bind(process.stdout);
104:     this.originalStderrWrite = process.stderr.write.bind(process.stderr);
105: 
106:     process.stdout.write = ((chunk: any, ...rest: any[]) => {
107:       this.writeRaw(chunk);
108:       return this.originalStdoutWrite!(chunk, ...rest);
109:     }) as typeof process.stdout.write;
110: 
111:     process.stderr.write = ((chunk: any, ...rest: any[]) => {
112:       this.writeRaw(chunk);
113:       return this.originalStderrWrite!(chunk, ...rest);
114:     }) as typeof process.stderr.write;
115: 
116:     this.isHijacked = true;
117:   }
118: 
119:   /** 导出日志内容 */
120:   exportLogs(): string {
121:     if (!fs.existsSync(LOG_FILE)) return "";
122:     return fs.readFileSync(LOG_FILE, "utf-8");
123:   }
124: 
125:   /** 清空日志 */
126:   clear(): void {
127:     this.stream?.end();
128:     if (fs.existsSync(LOG_FILE)) fs.unlinkSync(LOG_FILE);
129:     this.stream = fs.createWriteStream(LOG_FILE, { flags: "a" });
130:   }
131: 
132:   /** 关闭日志 */
133:   close(): void {
134:     if (this.isHijacked) {
135:       for (const level of LEVELS) {
136:         const original = this.originalConsole[level];
137:         if (original) (console as any)[level] = original;
138:       }
139:       this.originalConsole = {};
140:       if (this.originalStdoutWrite) process.stdout.write = this.originalStdoutWrite;
141:       if (this.originalStderrWrite) process.stderr.write = this.originalStderrWrite;
142:       this.originalStdoutWrite = null;
143:       this.originalStderrWrite = null;
144:       this.isHijacked = false;
145:     }
146:     this.stream?.end();
147:     this.stream = null;
148:   }
149: }
150: 
151: const logger = new Logger().init();
152: export default logger;
</file>

