 69:   const mem = buildMemPrompt(await memory.get(text));
 70: 
 71:   const { fullStream } = await u.Ai.Text("productionAgent:decisionAgent", ctx.thinkConfig.think, ctx.thinkConfig.thinlLevel).stream({
 72:     messages: [
