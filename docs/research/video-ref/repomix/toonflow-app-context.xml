400: // 文本内容流：自动把 <think>...</think> 转为 thinking 内容
401: class AutoThinkingTextStream extends ContentStream<string> {
402:   private static readonly OPEN_TAG = "<think>";
403:   private static readonly CLOSE_TAG = "</think>";
404: 
405:   private readonly messageBuilder: MessageBuilder;
406:   private pending = "";
407:   private inThinking = false;
408:   private thinkingStream: ThinkingStream | null = null;
409:   private thinkingBuffer = "";
410:   private thinkingStartTime: number = 0;
411: 
412:   constructor(socket: Socket, messageId: string, contentId: string, messageBuilder: MessageBuilder) {
413:     super(socket, messageId, contentId, "text");
414:     this.messageBuilder = messageBuilder;
415:   }
416: 
417:   /**
418:    * 检查 str 的尾部是否是 tag 的某个非空真前缀。
419:    * 返回需要保留的尾部字符数（0 表示不需要缓冲）。
420:    */
421:   private static tailPrefixLen(str: string, tag: string): number {
422:     const maxCheck = Math.min(str.length, tag.length - 1);
423:     for (let len = maxCheck; len >= 1; len--) {
424:       if (str.endsWith(tag.slice(0, len))) {
425:         return len;
426:       }
427:     }
428:     return 0;
429:   }
430: 
431:   override append(chunk: string) {
432:     if (!chunk) return this;
433: 
434:     let rest = this.pending + chunk;
435:     this.pending = "";
436: 
437:     while (rest.length > 0) {
438:       if (!this.inThinking) {
439:         // 寻找 <think> 开始标签
440:         const openIndex = rest.indexOf(AutoThinkingTextStream.OPEN_TAG);
441:         if (openIndex >= 0) {
442:           this.flushText(rest.slice(0, openIndex));
443:           this.inThinking = true;
444:           this.thinkingStartTime = Date.now();
445:           this.thinkingBuffer = "";
446:           this.ensureThinkingStream();
447:           rest = rest.slice(openIndex + AutoThinkingTextStream.OPEN_TAG.length);
448:           continue;
449:         }
450: 
451:         // 检查尾部是否可能是标签的部分前缀
452:         const keep = AutoThinkingTextStream.tailPrefixLen(rest, AutoThinkingTextStream.OPEN_TAG);
453:         if (keep > 0) {
454:           this.flushText(rest.slice(0, rest.length - keep));
455:           this.pending = rest.slice(rest.length - keep);
456:         } else {
457:           this.flushText(rest);
458:         }
459:         break;
460:       } else {
461:         // 寻找 </think> 结束标签
462:         const closeIndex = rest.indexOf(AutoThinkingTextStream.CLOSE_TAG);
463:         if (closeIndex >= 0) {
464:           this.flushThinking(rest.slice(0, closeIndex));
465:           this.finishThinking();
466:           rest = rest.slice(closeIndex + AutoThinkingTextStream.CLOSE_TAG.length);
467:           continue;
468:         }
469: 
470:         // 检查尾部是否可能是标签的部分前缀
471:         const keep = AutoThinkingTextStream.tailPrefixLen(rest, AutoThinkingTextStream.CLOSE_TAG);
472:         if (keep > 0) {
473:           this.flushThinking(rest.slice(0, rest.length - keep));
474:           this.pending = rest.slice(rest.length - keep);
475:         } else {
476:           this.flushThinking(rest);
477:         }
478:         break;
479:       }
480:     }
481: 
482:     return this;
483:   }
484: 
485:   override complete(finalData?: string) {
486:     if (finalData) {
487:       this.append(finalData);
488:     }
489: 
490:     if (this.pending) {
491:       if (this.inThinking) {
492:         this.flushThinking(this.pending);
493:       } else {
494:         this.flushText(this.pending);
495:       }
496:       this.pending = "";
497:     }
498: 
499:     this.finishThinking();
500:     super.complete();
501:     return this;
502:   }
503: 
504:   override error() {
505:     if (this.thinkingStream) {
506:       this.thinkingStream.error();
507:       this.thinkingStream = null;
508:     }
509:     this.pending = "";
510:     this.thinkingBuffer = "";
511:     this.inThinking = false;
512:     return super.error();
513:   }
514: 
515:   /** 输出普通文本 */
516:   private flushText(text: string) {
517:     if (!text) return;
518:     super.append(text);
519:   }
520: 
521:   /** 输出思考文本：累积完整内容，用 merge 策略发送，避免前端 append 丢失 */
522:   private flushThinking(text: string) {
523:     if (!text) return;
524:     this.thinkingBuffer += text;
525:     this.ensureThinkingStream().merge({ title: "思考中...", text: this.thinkingBuffer });
526:   }
527: 
528:   private ensureThinkingStream() {
529:     if (!this.thinkingStream) {
530:       this.thinkingStartTime = Date.now();
531:       this.thinkingStream = this.messageBuilder.thinking("思考中...");
532:     }
533:     return this.thinkingStream;
534:   }
535: 
536:   private finishThinking() {
537:     if (this.thinkingStream) {
538:       const elapsed = ((Date.now() - this.thinkingStartTime) / 1000).toFixed(1);
539:       this.thinkingStream.updateTitle(`思考完毕（${elapsed}秒）`);
540:       this.thinkingStream.complete({ title: `思考完毕（${elapsed}秒）`, text: this.thinkingBuffer });
541:       this.thinkingStream = null;
542:       this.thinkingBuffer = "";
543:     }
544:     this.inThinking = false;
545:   }
546: }
