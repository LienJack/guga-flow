<file path="src/utils/replaceUrl.ts">
 1: import path from "node:path";
 2: 
 3: export default function replaceUrl(url: string): string {
 4:   if (typeof url !== "string" || !url.trim()) return "";
 5:   let cleanedPath = "";
 6:   try {
 7:     const pathname = new URL(url).pathname;
 8:     cleanedPath = pathname;
 9:   } catch (e) {
10:     // 如果不是有效的URL，则直接使用原字符串
11:     cleanedPath = url;
12:   }
13:   cleanedPath = cleanedPath.replace(/^\/oss/, "").replace(/^\/smallImage/, "");
14:   // 去除 query 参数
15:   cleanedPath = cleanedPath.split("?")[0];
16:   // 防止路径穿越：对路径进行规范化后，确保不含上溯分量
17:   // 使用 posix 规范化（保持 / 分隔符），去除所有 .. 和 .
18:   const normalized = path.posix.normalize(cleanedPath);
19: 
20:   // 规范化后若路径以 ../ 开头或等于 .. 则说明发生了路径穿越，拒绝并返回空字符串
21:   if (normalized.startsWith("../") || normalized === "..") {
22:     return "";
23:   }
24: 
25:   // 去除前导斜杠，保证返回的是相对路径
26:   return normalized.replace(/^\/+/, "");
27: }
</file>

<file path="src/utils/stripThink.ts">
  1: /**
  2:  * 去除深度思考模型输出的 <think>...</think> 标签及其内容
  3:  *
  4:  * 1. stripThink(text)          — 用于非流式，直接去除完整文本中的 <think> 块
  5:  * 2. createThinkStreamFilter() — 用于流式，返回有状态的过滤器，逐 chunk 过滤
  6:  */
  7: 
  8: /**
  9:  * 非流式：去除完整文本中的 <think>...</think>
 10:  */
 11: export function stripThink(text: string): string {
 12:   return text.replace(/<think>[\s\S]*?<\/think>/g, "").trim();
 13: }
 14: 
 15: /**
 16:  * 流式：创建一个有状态的 chunk 过滤器
 17:  *
 18:  * 用法：
 19:  * ```ts
 20:  * const filter = createThinkStreamFilter();
 21:  * for await (const chunk of textStream) {
 22:  *   const filtered = filter.push(chunk);
 23:  *   if (filtered) msg.send(filtered);
 24:  * }
 25:  * ```
 26:  */
 27: export function createThinkStreamFilter() {
 28:   let insideThink = false;
 29:   let buffer = "";
 30: 
 31:   return {
 32:     /**
 33:      * 输入一个 chunk，返回过滤后需要输出的文本（可能为空字符串）
 34:      */
 35:     push(chunk: string): string {
 36:       let output = "";
 37:       let i = 0;
 38: 
 39:       while (i < chunk.length) {
 40:         if (insideThink) {
 41:           // 正在 <think> 内部，寻找 </think>
 42:           const closeIdx = chunk.indexOf("</think>", i);
 43:           if (closeIdx !== -1) {
 44:             // 找到闭合标签，跳过标签内容
 45:             insideThink = false;
 46:             i = closeIdx + "</think>".length;
 47:           } else {
 48:             // 整个剩余 chunk 都在 think 内，全部丢弃
 49:             break;
 50:           }
 51:         } else {
 52:           // 不在 <think> 内部
 53:           const openIdx = chunk.indexOf("<think>", i);
 54:           if (openIdx !== -1) {
 55:             // 找到开启标签，输出标签之前的内容
 56:             output += buffer + chunk.slice(i, openIdx);
 57:             buffer = "";
 58:             insideThink = true;
 59:             i = openIdx + "<think>".length;
 60:           } else {
 61:             // 没有发现 <think>，但可能 chunk 末尾是不完整的 "<thi..."
 62:             // 缓冲末尾可能是 "<" 开头的不完整标签片段
 63:             const potentialStart = findPartialTag(chunk, i);
 64:             if (potentialStart !== -1) {
 65:               output += buffer + chunk.slice(i, potentialStart);
 66:               buffer = chunk.slice(potentialStart);
 67:             } else {
 68:               output += buffer + chunk.slice(i);
 69:               buffer = "";
 70:             }
 71:             break;
 72:           }
 73:         }
 74:       }
 75: 
 76:       return output;
 77:     },
 78: 
 79:     /**
 80:      * 流结束时调用，刷出缓冲区中残留的内容
 81:      */
 82:     flush(): string {
 83:       const remaining = buffer;
 84:       buffer = "";
 85:       return remaining;
 86:     },
 87:   };
 88: }
 89: 
 90: /**
 91:  * 检查 chunk[startIdx..] 的末尾是否包含 "<think>" 的不完整前缀
 92:  * 如 "<", "<t", "<th", "<thi", "<thin", "<think"
 93:  * 返回不完整前缀的起始位置，未找到则返回 -1
 94:  */
 95: function findPartialTag(chunk: string, startIdx: number): number {
 96:   const tag = "<think>";
 97:   // 只需检查末尾最多 tag.length - 1 个字符
 98:   const searchStart = Math.max(startIdx, chunk.length - (tag.length - 1));
 99:   for (let i = searchStart; i < chunk.length; i++) {
100:     const remaining = chunk.slice(i);
101:     if (tag.startsWith(remaining)) {
102:       return i;
103:     }
104:   }
105:   return -1;
106: }
</file>

