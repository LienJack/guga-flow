<file path="src/routes/novel/event/getEvent.ts">
 1: import express from "express";
 2: import u from "@/utils";
 3: import { db } from "@/utils/db";
 4: import { z } from "zod";
 5: import { success } from "@/lib/responseFormat";
 6: import { validateFields } from "@/middleware/middleware";
 7: const router = express.Router();
 8: 
 9: export default router.post(
10:   "/",
11:   validateFields({
12:     projectId: z.number(),
13:     page: z.number(),
14:     limit: z.number(),
15:     search: z.string().optional(),
16:   }),
17:   async (req, res) => {
18:     const { projectId, page, limit, search } = req.body;
19:     const offset = (page - 1) * limit;
20: 
21:     // 构造基础查询：通过 o_eventChapter -> o_novel 过滤 projectId，再 join o_event 取名称和内容
22:     const baseQuery = u
23:       .db("o_event as e")
24:       .join("o_eventChapter as ec", "ec.eventId", "e.id")
25:       .join("o_novel as n", "n.id", "ec.novelId")
26:       .where("n.projectId", projectId);
27: 
28:     if (search) {
29:       baseQuery.where("e.name", "like", `%${search}%`);
30:     }
31: 
32:     // 统计去重后的事件总数
33:     const [{ total }] = await baseQuery.clone().countDistinct("e.id as total");
34: 
35:     if (!Number(total)) {
36:       return res.status(200).send(success({ list: [], total: 0 }));
37:     }
38: 
39:     // 分页查询：每个事件对应多个 chapterIndex，用 GROUP_CONCAT 聚合
40:     const rows = await baseQuery
41:       .clone()
42:       .select("e.id", "e.name as eventName", "e.detail", "e.createTime", db.raw("GROUP_CONCAT(n.chapterIndex) as chapterIndexes"))
43:       .groupBy("e.id")
44:       .limit(limit)
45:       .offset(offset);
46: 
47:     const list = rows.map((e: { id: number; eventName: string; detail: string; createTime: number; chapterIndexes: string | null }) => ({
48:       id: e.id,
49:       eventName: e.eventName,
50:       detail: e.detail,
51:       createTime: e.createTime,
52:       chapters: e.chapterIndexes ? e.chapterIndexes.split(",").map(Number) : [],
53:     }));
54: 
55:     res.status(200).send(success({ list, total: Number(total) }));
56:   },
57: );
</file>

<file path="src/routes/novel/addNovel.ts">
 1: import express from "express";
 2: import u from "@/utils";
 3: import { z } from "zod";
 4: import { success } from "@/lib/responseFormat";
 5: import { validateFields } from "@/middleware/middleware";
 6: const router = express.Router();
 7: 
 8: // 新增原文数据
 9: export default router.post(
10:   "/",
11:   validateFields({
12:     projectId: z.number(),
13:     data: z.array(
14:       z.object({
15:         index: z.number(),
16:         reel: z.string(),
17:         chapter: z.string(),
18:         chapterData: z.string(),
19:       }),
20:     ),
21:   }),
22:   async (req, res) => {
23:     const { projectId, data } = req.body;
24:     const totalNovelId = [];
25:     const getLastChapterIndex = await u.db("o_novel").where("projectId", projectId).select("chapterIndex").orderBy("chapterIndex", "desc").first();
26:     let lastChapterIndex = 0;
27:     if (getLastChapterIndex) {
28:       lastChapterIndex = getLastChapterIndex.chapterIndex!;
29:     }
30:     for (const item of data) {
31:       const [id] = await u.db("o_novel").insert({
32:         projectId,
33:         chapterIndex: ++lastChapterIndex,
34:         reel: item.reel,
35:         chapter: item.chapter,
36:         chapterData: item.chapterData,
37:         createTime: Date.now(),
38:         eventState: 0,
39:       });
40:       totalNovelId.push(id);
41:     }
42:     const chapterAllList = await u.db("o_novel").where("projectId", projectId).whereIn("id", totalNovelId);
43:     const novelClass = new u.cleanNovel();
44:     novelClass.emitter.on("item", async (item) => {
45:       await u
46:         .db("o_novel")
47:         .where("id", item.id)
48:         .update({ event: item.event, eventState: item.event ? 1 : -1, errorReason: item?.errReason ?? null });
49:     });
50:     novelClass.start(chapterAllList, projectId);
51: 
52:     res.status(200).send(success({ message: "新增原文成功" }));
53:   },
54: );
</file>

