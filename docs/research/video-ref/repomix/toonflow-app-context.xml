26:   models: z.array(
27:     z.discriminatedUnion("type", [
28:       z.object({
29:         name: z.string(),
30:         modelName: z.string(),
31:         type: z.literal("text"),
32:         think: z.boolean(),
33:       }),
34:       z.object({
35:         name: z.string(),
36:         modelName: z.string(),
37:         type: z.literal("image"),
