 9: export function setToken(payload: string | object, expiresIn: string | number, secret: string): string {
10:   if (!payload || typeof secret !== "string" || !secret) {
11:     throw new Error("参数不合法");
12:   }
13:   return (jwt.sign as any)(payload, secret, { expiresIn });
14: }
15: 
16: // 登录
17: export default router.post(
18:   "/",
19:   validateFields({
20:     username: z.string(),
21:     password: z.string(),
22:   }),
23:   async (req, res) => {
24:     const { username, password } = req.body;
25: 
26:     const data = await u.db("o_user").where("name", "=", username).first();
27:     if (!data) return res.status(400).send(error("登录失败"));
28: 
29:     if (data!.password == password && data!.name == username) {
30:       const tokenData = await u.db("o_setting").where("key", "tokenKey").first();
31:       if (!tokenData) return res.status(400).send(error("未找到tokenKey"));
32:       const token = setToken(
33:         {
34:           id: data!.id,
35:           name: data!.name,
36:         },
37:         "180Days",
38:         tokenData?.value as string,
39:       );
40: 
41:       return res.status(200).send(success({ token: "Bearer " + token, name: data!.name, id: data!.id }, "登录成功"));
42:     } else {
43:       return res.status(400).send(error("用户名或密码错误"));
44:     }
45:   },
46: );
</file>

