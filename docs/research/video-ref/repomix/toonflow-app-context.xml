 85:         const allFiles = fs.readdirSync(imagesDir);
 86:         existingFiles = allFiles.filter((f) => /\.(png|jpe?g|gif|webp|svg)$/i.test(f));
 87:       } catch {}
 88: 
 89:       const retainedFileNames = new Set(images.filter((item) => item.startsWith("http")).map((url) => path.basename(new URL(url).pathname)));
 90: 
 91:       for (const file of existingFiles) {
 92:         if (!retainedFileNames.has(file)) {
 93:           const filePath = path.join(imagesDir, file);
 94:           if (fs.existsSync(filePath)) fs.unlinkSync(filePath);
 95:         }
 96:       }
 97: 
 98:       if (!fs.existsSync(imagesDir)) {
 99:         fs.mkdirSync(imagesDir, { recursive: true });
100:       }
101: 
102:       for (const item of images) {
103:         if (!item.startsWith("http")) {
104:           const fileName = `${u.uuid()}.jpg`;
105:           const targetPath = path.join(imagesDir, fileName);
106:           const buffer = Buffer.from(item.replace(/^data:[^;]+;base64,/, ""), "base64");
107:           fs.writeFileSync(targetPath, buffer);
108:         }
109:       }
110: 
111:       res.status(200).send(success());
