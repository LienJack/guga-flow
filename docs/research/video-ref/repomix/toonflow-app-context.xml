<file path="src/routes/production/storyboard/downPreviewImage.ts">
  1: import express from "express";
  2: import u from "@/utils";
  3: import { z } from "zod";
  4: import sharp from "sharp";
  5: import { validateFields } from "@/middleware/middleware";
  6: const router = express.Router();
  7: 
  8: export default router.post(
  9:   "/",
 10:   validateFields({
 11:     storyboardIds: z.array(z.number()),
 12:   }),
 13:   async (req, res) => {
 14:     const { storyboardIds } = req.body;
 15:     const storyboardImage = await u.db("o_storyboard").whereIn("id", storyboardIds).select("id", "filePath");
 16: 
 17:     // 按 storyboardIds 顺序构建 filePath 映射
 18:     const filePathMap: Record<number, string> = {};
 19:     storyboardImage.forEach((i) => {
 20:       filePathMap[i.id!] = i.filePath || "";
 21:     });
 22:     const orderedFilePaths = storyboardIds.map((id: number) => filePathMap[id]);
 23: 
 24:     // 读取所有图片 buffer 并获取元数据
 25:     // sharp 底层 libvips 在 composite 时会将所有 input 解码为内存像素再合成，无需预转格式
 26:     const loaded = await Promise.all(
 27:       orderedFilePaths.map(async (filePath: string) => {
 28:         if (!filePath) return null;
 29:         const buffer = await u.oss.getFile(filePath);
 30:         const metadata = await sharp(buffer).metadata();
 31:         return { buffer, width: metadata.width || 0, height: metadata.height || 0 };
 32:       }),
 33:     );
 34: 
 35:     // 过滤掉无效图片
 36:     const validImages = loaded.filter((img): img is NonNullable<typeof img> => img !== null && img.width > 0 && img.height > 0);
 37:     if (validImages.length === 0) {
 38:       res.status(204).end();
 39:       return;
 40:     }
 41: 
 42:     // 计算网格布局
 43:     const cols = Math.min(5, validImages.length);
 44:     const rows = Math.ceil(validImages.length / cols);
 45: 
 46:     const colWidths: number[] = Array(cols).fill(0);
 47:     const rowHeights: number[] = Array(rows).fill(0);
 48:     validImages.forEach((img, idx) => {
 49:       const c = idx % cols;
 50:       const r = Math.floor(idx / cols);
 51:       colWidths[c] = Math.max(colWidths[c], img.width);
 52:       rowHeights[r] = Math.max(rowHeights[r], img.height);
 53:     });
 54: 
 55:     const canvasWidth = colWidths.reduce((a, b) => a + b, 0);
 56:     const canvasHeight = rowHeights.reduce((a, b) => a + b, 0);
 57: 
 58:     // 为每张图片生成带标号的合成层
 59:     const compositeInputs: sharp.OverlayOptions[] = [];
 60: 
 61:     for (let i = 0; i < validImages.length; i++) {
 62:       const img = validImages[i];
 63:       const c = i % cols;
 64:       const r = Math.floor(i / cols);
 65:       const x = colWidths.slice(0, c).reduce((a, b) => a + b, 0);
 66:       const y = rowHeights.slice(0, r).reduce((a, b) => a + b, 0);
 67: 
 68:       // 添加图片层
 69:       compositeInputs.push({
 70:         input: img.buffer,
 71:         left: x,
 72:         top: y,
 73:       });
 74: 
 75:       // 生成标号标签 SVG
 76:       const label = `S${String(i + 1).padStart(2, "0")}`;
 77:       const fontSize = Math.max(14, Math.min(img.width, img.height) * 0.06);
 78:       const padding = Math.round(fontSize * 0.4);
 79:       const textWidth = Math.round(label.length * fontSize * 0.65);
 80:       const bgW = textWidth + padding * 2;
 81:       const bgH = Math.round(fontSize) + padding * 2;
 82: 
 83:       const labelSvg = Buffer.from(
 84:         `<svg xmlns="http://www.w3.org/2000/svg" width="${bgW}" height="${bgH}">
 85:           <rect x="0" y="0" width="${bgW}" height="${bgH}" rx="4" ry="4" fill="rgba(0,0,0,0.55)"/>
 86:           <text x="${padding}" y="${padding + fontSize * 0.85}" font-family="Arial, sans-serif" font-weight="bold" font-size="${fontSize}" fill="#fff">${label}</text>
 87:         </svg>`,
 88:       );
 89: 
 90:       compositeInputs.push({
 91:         input: labelSvg,
 92:         left: x + 4,
 93:         top: y + 4,
 94:       });
 95:     }
 96: 
 97:     // 使用 sharp 创建画布并合成，输出 PNG 无损格式避免压缩损耗
 98:     const resultBuffer = await sharp({
 99:       create: {
100:         width: canvasWidth,
101:         height: canvasHeight,
102:         channels: 4,
103:         background: { r: 255, g: 255, b: 255, alpha: 1 },
104:       },
105:     })
106:       .composite(compositeInputs)
107:       .png({ compressionLevel: 3 })
108:       .toBuffer();
109: 
110:     // 以文件下载形式返回
111:     res.setHeader("Content-Type", "image/png");
112:     res.setHeader("Content-Disposition", "attachment; filename=storyboard-preview.png");
113:     res.setHeader("Content-Length", resultBuffer.length);
114:     res.status(200).send(resultBuffer);
115:   },
116: );
</file>

