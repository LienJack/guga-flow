 8: export function validateFields(
 9:   shape: Record<string, ZodTypeAny>,
10:   source: "body" | "query" | "params" = "body", // 默认校验 body
11: ) {
12:   const schema = z.object(shape);
13: 
14:   return (req: Request, res: Response, next: NextFunction) => {
15:     const data = req[source];
