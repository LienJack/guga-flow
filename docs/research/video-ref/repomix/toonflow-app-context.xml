  8: const router = express.Router();
  9: 
 10: // 编辑视觉手册
 11: export default router.post(
 12:   "/",
 13:   validateFields({
 14:     name: z.string(),
 15:     stylePath: z.string(),
 16:     images: z.array(z.string()),
 17:     data: z.array(
