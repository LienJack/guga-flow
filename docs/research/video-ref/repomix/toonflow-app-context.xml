<file path="src/socket/routes/productionAgent.ts">
  1: import jwt from "jsonwebtoken";
  2: import u from "@/utils";
  3: import { Namespace, Socket } from "socket.io";
  4: import * as agent from "@/agents/productionAgent/index";
  5: import ResTool from "@/socket/resTool";
  6: 
  7: async function verifyToken(rawToken: string): Promise<Boolean> {
  8:   const setting = await u.db("o_setting").where("key", "tokenKey").select("value").first();
  9:   if (!setting) return false;
 10:   const { value: tokenKey } = setting;
 11:   if (!rawToken) return false;
 12:   const token = rawToken.replace("Bearer ", "");
 13:   try {
 14:     jwt.verify(token, tokenKey as string);
 15:     return true;
 16:   } catch (err) {
 17:     return false;
 18:   }
 19: }
 20: 
 21: export default (nsp: Namespace) => {
 22:   nsp.on("connection", async (socket: Socket) => {
 23:     const token = socket.handshake.auth.token;
 24:     if (!token || !(await verifyToken(token))) {
 25:       console.log("[productionAgent] 连接失败，token无效");
 26:       socket.disconnect();
 27:       return;
 28:     }
 29:     let isolationKey = socket.handshake.auth.isolationKey;
 30:     if (!isolationKey) {
 31:       console.log("[productionAgent] 连接失败，缺少 isolationKey");
 32:       socket.disconnect();
 33:       return;
 34:     }
 35: 
 36:     console.log("[productionAgent] 已连接:", socket.id);
 37: 
 38:     let resTool = new ResTool(socket, {
 39:       projectId: socket.handshake.auth.projectId,
 40:       scriptId: socket.handshake.auth.scriptId,
 41:     });
 42:     let abortController: AbortController | null = null;
 43: 
 44:     const thinkConfig: agent.AgentContext["thinkConfig"] = {
 45:       think: false,
 46:       thinlLevel: 0,
 47:     };
 48: 
 49:     socket.on("updateContext", (data: { isolationKey: string; projectId: number; scriptId: number }, callback) => {
 50:       isolationKey = data.isolationKey;
 51:       resTool = new ResTool(socket, {
 52:         projectId: data.projectId,
 53:         scriptId: data.scriptId,
 54:       });
 55:       console.log("[productionAgent] 上下文已更新:", isolationKey);
 56:       callback?.({ success: true });
 57:     });
 58: 
 59:     socket.on("chat", async (data: { content: string }) => {
 60:       const { content } = data;
 61:       abortController?.abort();
 62:       abortController = new AbortController();
 63:       const currentController = abortController;
 64: 
 65:       const msg = resTool.newMessage("assistant", "视频策划");
 66:       const ctx: agent.AgentContext = {
 67:         socket,
 68:         isolationKey,
 69:         text: content,
 70:         userMessageTime: new Date(msg.datetime).getTime() - 1,
 71:         abortSignal: currentController.signal,
 72:         resTool,
 73:         msg,
 74:         thinkConfig,
 75:       };
 76: 
 77:       try {
 78:         await agent.runDecisionAI(ctx);
 79:       } catch (err: any) {
 80:         if (err.name !== "AbortError" && !currentController.signal.aborted) {
 81:           console.error("[productionAgent] chat error:", u.error(err).message);
 82:         }
 83:       } finally {
 84:         if (abortController === currentController) {
 85:           abortController = null;
 86:         }
 87:       }
 88:     });
 89: 
 90:     socket.on("updateThinkConfig", (data: { think: boolean; thinlLevel: 0 | 1 | 2 | 3 }) => {
 91:       thinkConfig.think = data.think;
 92:       thinkConfig.thinlLevel = data.thinlLevel;
 93:       console.log("[productionAgent] 更新思考配置:", thinkConfig);
 94:     });
 95: 
 96:     socket.on("stop", () => {
 97:       abortController?.abort();
 98:       abortController = null;
 99:     });
100:   });
101:   nsp.on("disconnect", (socket: Socket) => {
102:     console.log("[productionAgent] 已断开连接:", socket.id);
103:   });
104: };
</file>

