 6: /**
 7:  * 图片缩放选项
 8:  */
 9: export interface ResizeOptions {
10:   /** 最大宽度（默认 256 */
11:   width?: number;
12:   /** 最大高度（默认 256 */
13:   height?: number;
14:   /** 缩放策略，默认等比缩放不超出边界 */
15:   fit?: keyof sharp.FitEnum;
16:   /** 是否禁止放大（默认 true） */
17:   withoutEnlargement?: boolean;
18: }
19: 
20: const defaultResizeOptions: Required<ResizeOptions> = {
21:   width: 256,
22:   height: 256,
23:   fit: "inside",
24:   withoutEnlargement: true,
25: };
26: 
27: /**
28:  * 将图片缩放后写入目标路径（自动创建父目录）。
29:  * @param srcPath 源图片绝对路径
30:  * @param dstPath 目标图片绝对路径
31:  * @param opts 缩放选项
32:  */
33: export async function resizeImage(srcPath: string, dstPath: string, opts?: ResizeOptions): Promise<void> {
34:   const { width, height, fit, withoutEnlargement } = { ...defaultResizeOptions, ...opts };
35:   await fs.mkdir(path.dirname(dstPath), { recursive: true });
36:   await sharp(srcPath).resize(width, height, { fit, withoutEnlargement }).toFile(dstPath);
37: }
38: 
39: /**
40:  * 缩略图自定义尺寸选项
41:  */
42: export type ThumbnailSize =
43:   | { type: "dimensions"; width: number; height: number }
44:   | { type: "percentage"; value: number };
45: 
46: /**
47:  * 生成缩略图。
48:  * - 若缩略图已存在，直接返回其路径。
49:  * - 若不存在，生成后返回目标路径；生成失败返回 null。
50:  *
51:  * @param originalPath 原图绝对路径
52:  * @param thumbnailPath 缩略图绝对路径
53:  * @param size 可选的自定义尺寸：固定宽高 或 百分比（默认 256x256 inside）
54:  * @returns 缩略图路径，失败返回 null
55:  */
56: export async function ensureThumbnail(
57:   originalPath: string,
58:   thumbnailPath: string,
59:   size?: ThumbnailSize,
60: ): Promise<string | null> {
61:   // 小图已存在，直接返回
62:   if (fss.existsSync(thumbnailPath)) {
63:     return thumbnailPath;
64:   }
65:   // 原图不存在，无法生成
66:   if (!fss.existsSync(originalPath)) {
67:     return null;
68:   }
69:   try {
70:     if (size?.type === "percentage") {
71:       // 百分比缩放：先获取原图尺寸，再等比计算目标尺寸
72:       const meta = await sharp(originalPath).metadata();
73:       if (!meta.width || !meta.height) {
74:         console.warn("[image] 无法获取原图尺寸:", originalPath);
75:         return null;
76:       }
77:       const pct = size.value / 100;
78:       const w = Math.round(meta.width * pct);
79:       const h = Math.round(meta.height * pct);
80:       await resizeImage(originalPath, thumbnailPath, { width: w, height: h });
81:     } else if (size?.type === "dimensions") {
82:       // 固定宽高：等比缩放适配到指定边界
83:       await resizeImage(originalPath, thumbnailPath, {
84:         width: size.width,
85:         height: size.height,
86:       });
87:     } else {
88:       // 默认 256x256 inside
89:       await resizeImage(originalPath, thumbnailPath);
90:     }
91:     console.info(`[${thumbnailPath}] 小图生成成功`);
92:     return thumbnailPath;
93:   } catch (e) {
94:     console.warn("[image] 生成缩略图失败:", e);
95:     return null;
96:   }
97: }
