 44: export function parseFrontmatter(content: string): { name: string; description: string } {
 45:   const match = content.match(/^\uFEFF?---[ \t]*\r?\n([\s\S]*?)\r?\n---[ \t]*(?:\r?\n|$)/);
 46:   if (!match?.[1]) {
 47:     throw new Error(`技能文件缺少有效的 frontmatter，确保以 --- 包裹并包含 name 和 description 字段。${content}`);
 48:   }
 49: 
 50:   const result: Record<string, string> = {};
 51:   const lines = match[1].split(/\r?\n/);
 52: 
 53:   for (let i = 0; i < lines.length; ) {
 54:     const line = lines[i];
 55:     const trimmed = line.trim();
 56: 
 57:     if (!trimmed || trimmed.startsWith("#")) {
 58:       i++;
 59:       continue;
 60:     }
 61: 
 62:     const keyMatch = line.match(/^([A-Za-z0-9_-]+)\s*:\s*(.*)$/);
 63:     if (!keyMatch) {
 64:       i++;
 65:       continue;
 66:     }
 67: 
 68:     const key = keyMatch[1].trim();
 69:     const rawValue = (keyMatch[2] ?? "").trim();
 70:     i++;
 71: 
 72:     if (!key) continue;
 73: 
 74:     if (/^[>|][+-]?[0-9]*$/.test(rawValue)) {
 75:       const isFolded = rawValue.startsWith(">");
 76:       const blockLines: string[] = [];
 77:       let blockIndent: number | null = null;
 78: 
 79:       while (i < lines.length) {
 80:         const current = lines[i];
 81:         const currentTrimmed = current.trim();
 82: 
 83:         if (currentTrimmed === "") {
 84:           if (blockIndent !== null) blockLines.push("");
 85:           i++;
 86:           continue;
 87:         }
 88: 
 89:         const currentIndent = current.match(/^\s*/)?.[0].length ?? 0;
 90:         if (blockIndent === null) {
 91:           blockIndent = currentIndent;
 92:         }
 93: 
 94:         if (currentIndent < blockIndent) break;
 95: 
 96:         blockLines.push(current.slice(blockIndent));
 97:         i++;
 98:       }
 99: 
100:       result[key] = isFolded
101:         ? blockLines
102:             .join("\n")
103:             .replace(/\n{2,}/g, "\n\n")
104:             .replace(/([^\n])\n([^\n])/g, "$1 $2")
105:             .trim()
106:         : blockLines.join("\n").trim();
107:       continue;
108:     }
109: 
110:     const unquoted = rawValue.replace(/^(['"])([\s\S]*)\1$/, "$2");
111:     result[key] = unquoted;
112:   }
113: 
114:   if (!result.name || !result.description) {
115:     throw new Error(`技能文件缺少必要字段: name 或 description，确保 frontmatter 包含这两个字段。${content}`);
116:   }
117: 
118:   return { name: result.name, description: result.description };
119: }
