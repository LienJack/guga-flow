 99:         .leftJoin("o_image", "o_image.id", "o_assets.imageId")
100:         .whereIn("o_assets2Storyboard.storyboardId", storyIds as number[])
101:         .select("o_assets.*", "o_image.filePath", "o_assets2Storyboard.storyboardId");
102: 
103:       const queryAudioIds = [...assetDatas.map((i) => i.id!), ...assetDatas.map((i) => i.assetsId!)].filter(Boolean);
104:       const assets2AudioData = await u
105:         .db("o_assetsRole2Audio")
106:         .leftJoin("o_assets", "o_assets.assetsId", "o_assetsRole2Audio.assetsAudioId")
107:         .leftJoin("o_image", "o_image.id", "o_assets.imageId")
108:         .whereIn("o_assetsRole2Audio.assetsRoleId", queryAudioIds)
109:         .select(
110:           "o_assets.id",
111:           "o_assets.name",
112:           "o_assetsRole2Audio.assetsRoleId",
113:           "o_assets.describe",
114:           "o_assets.type",
115:           "o_assets.prompt",
116:           "o_image.filePath",
117:         );
118:       const audioRecord: Record<string, any> = {};
119:       await Promise.all(
120:         assets2AudioData.map(async (i) => {
121:           if (!audioRecord[i.assetsRoleId]) audioRecord[i.assetsRoleId] = [];
122:           audioRecord[i.assetsRoleId].push({
123:             id: i.id,
124:             name: i.name,
125:             describe: i.describe,
126:             type: i.type,
127:             fileType: "audio" as const,
128:             sources: "assets",
129:             prompt: i.prompt,
