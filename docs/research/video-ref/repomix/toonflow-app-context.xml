41:       // 先将 o_assets.imageId 置空，解除对 o_image 的外键引用
42:       await u.db("o_assets").whereIn("id", assetsIds).update({ imageId: null });
43:       await u.db("o_image").whereIn("assetsId", assetsIds).delete();
44:     }
45:     // 删除项目下的资产
46:     await u.db("o_assets").where("projectId", id).delete();
47:     //删除项目下的视频轨道和视频
48:     await u.db("o_videoTrack").where("projectId", id).delete();
49:     await u.db("o_video").where("projectId", id).delete();
50:     //删除项目下的资源
51: 
52:     await u.db("memories").where("isolationKey", "like", `${id}:%`).delete();
