  7: // 规范化路径：去除前导斜杠，并将路径分隔符统一转换为系统分隔符
  8: function normalizeUserPath(userPath: string): string {
  9:   // 去除前导的 / 或 \
 10:   const trimmedPath = userPath.replace(/^[/\\]+/, "");
 11:   // 将所有 / 替换为系统路径分隔符（path.sep）
 12:   // 这样在 Windows 上会转为 \，在 Unix 上保持 /
 13:   return trimmedPath.split("/").join(path.sep);
 14: }
 15: 
 16: // 校验路径
 17: function resolveSafeLocalPath(userPath: string, rootDir: string): string {
 18:   const safePath = normalizeUserPath(userPath);
 19:   const absPath = path.join(rootDir, safePath);
 20:   if (!isPathInside(absPath, rootDir)) {
 21:     throw new Error(`${userPath} 不在 OSS 根目录内`);
 22:   }
 23:   return absPath;
 24: }
