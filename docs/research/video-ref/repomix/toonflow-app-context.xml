<file path="src/routes/production/workbench/batchGeneratePrompt.ts">
  1: import express from "express";
  2: import u from "@/utils";
  3: import pLimit from "p-limit";
  4: import { z } from "zod";
  5: import { success, error } from "@/lib/responseFormat";
  6: import { validateFields } from "@/middleware/middleware";
  7: import fs from "fs/promises";
  8: import path from "path";
  9: const router = express.Router();
 10: 
 11: export default router.post(
 12:   "/",
 13:   validateFields({
 14:     projectId: z.number(),
 15:     trackData: z.array(
 16:       z.object({
 17:         trackId: z.number(),
 18:         info: z.array(
 19:           z.object({
 20:             id: z.number(),
 21:             sources: z.string(),
 22:           }),
 23:         ),
 24:       }),
 25:     ),
 26:     mode: z.string(),
 27:     model: z.string(),
 28:     concurrentCount: z.number().optional(), //并发数
 29:   }),
 30:   async (req, res) => {
 31:     const { trackData, projectId, mode, model, concurrentCount = 5 } = req.body;
 32:     try {
 33:       // 预加载公共数据
 34:       const [id, modelData] = model.split(/:(.+)/);
 35:       const projectData = await u.db("o_project").select("*").where({ id: projectId }).first();
 36:       const videoPrompt = await u.db("o_prompt").where("type", "videoPromptGeneration").first();
 37:       let videoPromptGeneration = "" as string | undefined;
 38: 
 39:       const modelPromptData = await u.db("o_modelPrompt").where("vendorId", id).where("model", modelData).first();
 40:       //查询到 有绑定对应视频提示词
 41:       if (modelPromptData) {
 42:         const modelPromptRoot = u.getPath(["modelPrompt"]);
 43:         try {
 44:           const fullPath = path.join(modelPromptRoot, modelPromptData?.path!);
 45:           const content = await fs.readFile(fullPath, "utf-8");
 46:           videoPromptGeneration = content ?? "";
 47:         } catch {}
 48:       }
 49: 
 50:       // 未查询到绑定，根据模型名称 + mode 自动匹配 modelPrompt/video/ 下的文件
 51:       if (!videoPromptGeneration) {
 52:         const modelPromptRoot = u.getPath(["modelPrompt"]);
 53:         const videoPromptDir = path.join(modelPromptRoot, "video");
 54:         const modelLower = (modelData ?? "").toLowerCase();
 55: 
 56:         let fileName: string | null = null;
 57: 
 58:         if (modelLower.includes("wan") && modelLower.includes("2.6")) {
 59:           // wan2.6 系列 => 单图首尾帧模式
 60:           fileName = "wan2.6Single-imageFirstFrameMode.md";
 61:         } else if (/seedance.*2[.\-]0/i.test(modelLower)) {
 62:           // seedance 2.0 / 2-0 系列
 63:           fileName = "seedance2Multi-parameterMode.md";
 64:         } else if (mode === "startEndRequired" || mode === "endFrameOptional" || mode === "startFrameOptional") {
 65:           // body.mode 为首尾帧相关 => 通用首尾帧模式
 66:           fileName = "universalFirstAndLastFrameMode.md";
 67:         } else if (typeof mode === "string" && mode.startsWith('["') && mode.endsWith('"]')) {
 68:           // 其他 => 通用多参模式
 69:           fileName = "universalMulti-parameterMode.md";
 70:         }
 71:         if (fileName) {
 72:           try {
 73:             const fullPath = path.join(videoPromptDir, fileName);
 74:             videoPromptGeneration = await fs.readFile(fullPath, "utf-8");
 75:           } catch {
 76:             // 文件不存在则忽略，继续用备选
 77:           }
 78:         }
 79:       }
 80: 
 81:       //备选
 82:       if (!videoPromptGeneration) {
 83:         if (videoPrompt && videoPrompt.useData) {
 84:           videoPromptGeneration = videoPrompt.useData;
 85:         } else {
 86:           videoPromptGeneration = videoPrompt?.data ?? undefined;
 87:         }
 88:       }
 89: 
 90:       const artStyle = projectData?.artStyle || "无";
 91:       const visualManual = u.getArtPrompt(artStyle, "art_skills", "art_storyboard_video");
 92:       await u
 93:         .db("o_videoTrack")
 94:         .whereIn(
 95:           "id",
 96:           trackData.map((t: { trackId: number }) => t.trackId),
 97:         )
 98:         .update({ state: "生成中" });
 99:       // 并发控制：每个 track 独立走 查询→拼装→AI调用→更新 流程
100:       const limit = pLimit(concurrentCount ?? 5);
101:       const tasks = trackData.map((track: { trackId: number; info: { id: number; sources: string }[] }) =>
102:         limit(async () => {
103:           // 查询参数
104:           const images = await Promise.all(
105:             track.info.map(async (item: { id: number; sources: string }) => {
106:               if (item.sources === "storyboard") {
107:                 // 查询分镜主信息
108:                 const storyboard = await u
109:                   .db("o_storyboard")
110:                   .where("o_storyboard.id", item.id)
111:                   .select("videoDesc", "prompt", "track", "duration", "shouldGenerateImage")
112:                   .first();
113:                 // 查询分镜关联的资产ID
114:                 const assetRows = await u.db("o_assets2Storyboard").where("storyboardId", item.id).orderBy("rowid").select("assetId");
115:                 const associateAssetsIds = assetRows.map((row: any) => row.assetId);
116:                 return {
117:                   ...storyboard,
118:                   associateAssetsIds,
119:                   _type: "storyboard",
120:                 };
121:               }
122:               if (item.sources === "assets") {
123:                 // 查询素材
124:                 const assetsData = await u
125:                   .db("o_assets")
126:                   .leftJoin("o_image", "o_image.id", "o_assets.imageId")
127:                   .where("o_assets.id", item.id)
128:                   .select("o_assets.id", "o_assets.type", "o_assets.name", "o_image.filePath")
129:                   .first();
130:                 return {
131:                   ...assetsData,
132:                   _type: "assets",
133:                 };
134:               }
135:             }),
136:           );
137: 
138:           // 拆分 assets 和 storyboard
139:           const assets: any[] = [];
140:           const storyboard: any[] = [];
141:           for (const item of images) {
142:             if (!item) continue;
143:             if (item._type === "assets")
144:               assets.push({
145:                 id: item.id,
146:                 type: item.type,
147:                 name: item.name,
148:                 filePath: item.filePath,
149:               });
150:             if (item._type === "storyboard")
151:               storyboard.push({
152:                 videoDesc: item.videoDesc,
153:                 prompt: item.prompt,
154:                 track: item.track,
155:                 duration: item.duration,
156:                 associateAssetsIds: item.associateAssetsIds,
157:                 shouldGenerateImage: item.shouldGenerateImage,
158:               });
159:           }
160: 
161:           const content = `
162:           **模型名称**：${modelData},
163:           **资产信息**（角色、场景、道具、音频):${assets
164:             .filter((i: any) => i.filePath)
165:             .map((i: any) => `[${i.id},${i.type},${i.name}]`)
166:             .join("，")},
167:           **分镜信息**：${storyboard.map(
168:             (i: any) => `<storyboardItem
169:   videoDesc='${i.videoDesc}'
170:   duration='${i.duration}'
171: ></storyboardItem>`,
172:           )},
173:           `;
174: 
175:           try {
176:             const { text } = await u.Ai.Text("universalAi").invoke({
177:               system: videoPromptGeneration,
178:               messages: [
179:                 {
180:                   role: "assistant",
181:                   content: `${visualManual}`,
182:                 },
183:                 {
184:                   role: "user",
185:                   content: content,
186:                 },
187:               ],
188:             });
189: 
190:             await u.db("o_videoTrack").where({ id: track.trackId }).update({
191:               prompt: text,
192:               state: "已完成",
193:             });
194: 
195:             return { trackId: track.trackId, text };
196:           } catch (e: any) {
197:             await u
198:               .db("o_videoTrack")
199:               .where({ id: track.trackId })
200:               .update({ state: "生成失败", reason: u.error(e).message });
201:           }
202:         }),
203:       );
204: 
205:       // 后台执行，不等待结果
206:       Promise.all(tasks);
207:       res.status(200).send(success("开始生成提示词"));
208:     } catch (e) {
209:       res.status(400).send(error(u.error(e).message));
210:     }
211:   },
212: );
</file>

