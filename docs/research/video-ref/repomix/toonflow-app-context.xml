<file path="src/routes/agents/clearMemory.ts">
 1: import express from "express";
 2: import u from "@/utils";
 3: import { z } from "zod";
 4: import { success } from "@/lib/responseFormat";
 5: import { validateFields } from "@/middleware/middleware";
 6: const router = express.Router();
 7: 
 8: export default router.post(
 9:   "/",
10:   validateFields({
11:     projectId: z.number(),
12:     episodesId: z.number().optional(),
13:     agentType: z.enum(["scriptAgent", "productionAgent"]),
14:     type: z.enum(["message", "summary", "all"]).optional(),
15:   }),
16:   async (req, res) => {
17:     const { projectId, episodesId,agentType, type = "all" } = req.body;
18:     const isolationKey = `${projectId}:${agentType}${episodesId ? `:${episodesId}` : ""}`;
19: 
20:     if (type === "all") {
21:       await u.db("memories").where({ isolationKey }).del();
22:     } else if (type === "message") {
23:       // 删 message 时同步删关联的 summary，避免悬挂引用
24:       await u.db("memories").where({ isolationKey, type: "message" }).del();
25:       await u.db("memories").where({ isolationKey, type: "summary" }).del();
26:     } else {
27:       // 删 summary 时将关联的 message 重置为未总结，使其重新进入 shortTerm
28:       await u
29:         .db("memories")
30:         .where({ isolationKey, type: "message", summarized: 1 })
31:         .update({ summarized: 0 });
32:       await u.db("memories").where({ isolationKey, type: "summary" }).del();
33:     }
34: 
35:     res.status(200).send(success(null));
36:   },
37: );
</file>

