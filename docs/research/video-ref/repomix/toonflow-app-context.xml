 90: export async function pollTask(
 91:   fn: () => Promise<{ completed: boolean; data?: string; error?: string }>,
 92:   interval = 3000,
 93:   timeout = 3000000,
 94: ): Promise<{ completed: boolean; data?: string; error?: string }> {
 95:   const start = Date.now();
 96:   while (Date.now() - start < timeout) {
 97:     try {
 98:       const result = await fn();
 99:       if (result.completed) return result;
100:       if (result?.error) return result;
101:     } catch (e: any) {
102:       return { completed: false, error: u.error(e).message || "poll error" };
103:     }
104:     await new Promise((res) => setTimeout(res, interval));
105:   }
106:   return { completed: false, error: "timeout" };
107: }
