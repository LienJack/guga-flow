<file path="src/routes/assetsGenerate/batchGenerateImageAssets.ts">
  1: import express from "express";
  2: import pLimit from "p-limit";
  3: import u from "@/utils";
  4: import { z } from "zod";
  5: import { v4 as uuidv4 } from "uuid";
  6: import { error, success } from "@/lib/responseFormat";
  7: import { validateFields } from "@/middleware/middleware";
  8: 
  9: const router = express.Router();
 10: 
 11: type AssetType = "role" | "scene" | "tool";
 12: 
 13: interface AssetTypeConfig {
 14:   label: string;
 15:   taskClass: string;
 16:   dir: string;
 17:   promptTitle: string;
 18:   promptEnd: string;
 19: }
 20: 
 21: const assetTypeConfig: Record<AssetType, AssetTypeConfig> = {
 22:   role: {
 23:     label: "角色",
 24:     taskClass: "角色图生成",
 25:     dir: "role",
 26:     promptTitle: "角色标准四视图",
 27:     promptEnd: "人物角色四视图",
 28:   },
 29:   scene: {
 30:     label: "场景",
 31:     taskClass: "场景图生成",
 32:     dir: "scene",
 33:     promptTitle: "标准场景图",
 34:     promptEnd: "标准场景图",
 35:   },
 36:   tool: {
 37:     label: "道具",
 38:     taskClass: "道具图生成",
 39:     dir: "props",
 40:     promptTitle: "标准道具图",
 41:     promptEnd: "标准道具图",
 42:   },
 43: };
 44: 
 45: function buildPrompt(cfg: AssetTypeConfig, artStyle: string, name: string, prompt: string): string {
 46:   return `
 47:     请根据以下参数生成${cfg.promptTitle}：
 48: 
 49:     **基础参数：**
 50:     - 画风风格: ${artStyle || "未指定"}
 51: 
 52:     **${cfg.label}设定：**
 53:     - 名称:${name},
 54:     - 提示词:${prompt},
 55: 
 56:     请严格按照系统规范生成${cfg.promptEnd}。
 57:   `;
 58: }
 59: 
 60: const requestSchema = {
 61:   projectId: z.number(),
 62:   model: z.string(),
 63:   resolution: z.string(),
 64:   concurrentCount: z.number().int().min(1).optional(),
 65:   items: z.array(
 66:     z.object({
 67:       id: z.number(),
 68:       type: z.enum(["role", "scene", "tool", "storyboard"]),
 69:       name: z.string(),
 70:       prompt: z.string(),
 71:       base64: z.string().optional().nullable(),
 72:     }),
 73:   ),
 74: };
 75: 
 76: export default router.post("/", validateFields(requestSchema), async (req, res) => {
 77:   const { projectId, model, resolution, concurrentCount, items } = req.body;
 78: 
 79:   // 1. 查询项目
 80:   const project = await u.db("o_project").where("id", projectId).select("artStyle", "type", "intro").first();
 81:   if (!project) return res.status(500).send(error("项目为空"));
 82: 
 83:   // 2. 逐条插入 o_image 占位记录，收集 imageId 列表
 84:   const totalNovelId: number[] = [];
 85:   for (const item of items) {
 86:     const [imageId] = await u.db("o_image").insert({
 87:       type: item.type,
 88:       state: "生成中",
 89:       assetsId: item.id,
 90:     });
 91:     await u.db("o_assets").where("id", item.id).update({ imageId });
 92:     totalNovelId.push(imageId);
 93:   }
 94: 
 95:   // 3. 后台异步并发生成，不阻塞响应
 96:   const limit = pLimit(concurrentCount ?? 1);
 97: 
 98:   const tasks = items.map((item: { id: number; type: string; name: string; prompt: string; base64: string | null | undefined }, index: number) =>
 99:     limit(async () => {
100:       const imageId = totalNovelId[index];
101:       const data = await u.db("o_image").where("id", imageId).select("state").first();
102:       if (data?.state === "生成失败") {
103:         return;
104:       }
105:       const cfg = assetTypeConfig[item.type as AssetType];
106:       if (!cfg) return;
107: 
108:       await u.db("o_assets").where("id", item.id).update({ imageId });
109: 
110:       const imagePath = `/${projectId}/${cfg.dir}/${uuidv4()}.jpg`;
111:       const userPrompt = buildPrompt(cfg, project.artStyle ?? "", item.name, item.prompt);
112:       const describe = `生成${cfg.label}图，名称：${item.name}，提示词：${item.prompt}`;
113:       const relatedObjects = { id: item.id, projectId, type: cfg.label };
114:       try {
115:         const aiImage = u.Ai.Image(model);
116:         await aiImage.run(
117:           {
