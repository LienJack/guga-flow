 84:     const otherDataMap: Record<number, any[]> = {};
 85:     // 解析 videoMode 中 audioReference 的数量，例如 'audioReference:3' => 3
 86:     const audioReferenceCount = (() => {
 87:       if (!Array.isArray(videoMode)) return 0;
 88:       const item = (videoMode as string[]).find((v) => v.toLowerCase().startsWith("audioreference:"));
 89:       if (!item) return 0;
 90:       const num = parseInt(item.split(":")[1], 10);
 91:       return isNaN(num) ? 0 : num;
 92:     })();
 93:     if (isRef) {
 94:       const storyIds = storyboardList.map((s) => s.id);
 95: 
 96:       const assetDatas = await u
 97:         .db("o_assets2Storyboard")
