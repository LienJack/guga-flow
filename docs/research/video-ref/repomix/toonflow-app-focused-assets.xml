<file path="src/routes/assets/updateAudioAssets.ts">
  1: import express from "express";
  2: import u from "@/utils";
  3: import { z } from "zod";
  4: import { success } from "@/lib/responseFormat";
  5: import { validateFields } from "@/middleware/middleware";
  6: const router = express.Router();
  7: 
  8: // 新增资产
  9: export default router.post(
 10:   "/",
 11:   validateFields({
 12:     id: z.number(),
 13:     name: z.string(),
 14:     describe: z.string(),
 15:     projectId: z.number(),
 16:     assetsItem: z.array(
 17:       z.object({
 18:         src: z.string().optional(),
 19:         id: z.number().optional(),
 20:         base64: z.string().optional(),
 21:         prompt: z.string(),
 22:         describe: z.string(),
 23:         name: z.string(),
 24:       }),
 25:     ),
 26:   }),
 27:   async (req, res) => {
 28:     const { id, name, describe, projectId, assetsItem } = req.body;
 29:     await Promise.all(
 30:       assetsItem.map(async (i: { src?: string; id?: number; base64: string; prompt: string }) => {
 31:         if (i.src) {
 32:           i.src = u.replaceUrl(i.src);
 33:         }
 34:         if (i.base64) {
 35:           const mimeMatch = i.base64.match(/^data:audio\/([^;]+);base64,/);
 36:           const mimeExt = mimeMatch ? mimeMatch[1] : "mp3";
 37:           const mimeToExt: Record<string, string> = {
 38:             mpeg: "mp3",
 39:             "x-wav": "wav",
 40:             "x-aiff": "aiff",
 41:             "x-m4a": "m4a",
 42:             "x-flac": "flac",
 43:           };
 44:           const ext = mimeToExt[mimeExt] ?? mimeExt;
 45:           const savePath = `/${projectId}/assets/audio/${u.uuid()}.${ext}`;
 46:           const base64Data = i.base64.replace(/^data:[^;]+;base64,/, "");
 47:           await u.oss.writeFile(savePath, base64Data);
 48:           i.src = savePath;
 49:         }
 50:       }),
 51:     );
 52: 
 53:     await u.db("o_assets").where("id", id).update({
 54:       name,
 55:       describe,
 56:     });
 57: 
 58:     // 删除不在 assetsItem 中的子项
 59:     const existingItems = await u.db("o_assets").where("assetsId", id).select("id");
 60:     const existingIds = existingItems.map((i: { id?: number }) => i.id!);
 61:     const incomingIds = assetsItem.filter((i: { id?: number }) => i.id).map((i: { id?: number }) => i.id);
 62:     const toDeleteIds = existingIds.filter((eid: number) => !incomingIds.includes(eid));
 63:     if (toDeleteIds.length > 0) {
 64:       const deleteItems = await u.db("o_assets").whereIn("id", toDeleteIds).select("imageId");
 65:       const deleteImageIds = deleteItems.map((i: { imageId?: number | null }) => i.imageId!).filter(Boolean);
 66:       // 先将 o_assets.imageId 置空，解除外键约束，再删除 o_image，最后删除 o_assets
 67:       await u.db("o_assets").whereIn("id", toDeleteIds).update({ imageId: null });
 68:       if (deleteImageIds.length > 0) {
 69:         await u.db("o_image").whereIn("id", deleteImageIds).delete();
 70:       }
 71:       await u.db("o_assets").whereIn("id", toDeleteIds).delete();
 72:     }
 73: 
 74:     for (const item of assetsItem) {
 75:       if (item.id) {
 76:         await u.db("o_assets").where("id", item.id).update({
 77:           prompt: item.prompt,
 78:           describe: item.describe,
 79:           name: item.name,
 80:         });
 81:         const itemData = await u.db("o_assets").where("id", item.id).select("imageId").first();
 82:         await u.db("o_image").where("id", itemData?.imageId).update({
 83:           filePath: item.src,
 84:         });
 85:       } else {
 86:         const [assetsId] = await u.db("o_assets").insert({
 87:           prompt: item.prompt,
 88:           assetsId: id,
 89:           type: "audio",
 90:           projectId,
 91:           describe: item.describe,
 92:           name: item.name,
 93:           startTime: Date.now(),
 94:         });
 95:         const [imageId] = await u.db("o_image").insert({
 96:           filePath: item.src,
 97:           type: "audio",
 98:           assetsId,
 99:           state: "已完成",
100:         });
101:         await u.db("o_assets").where("id", assetsId).update({
102:           imageId,
103:         });
104:       }
105:     }
106: 
107:     res.status(200).send(success({ message: "新增资产成功" }));
108:   },
109: );
</file>

