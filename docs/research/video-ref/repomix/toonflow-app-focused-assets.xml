 6: const router = express.Router();
 7: 
 8: // 新增资产
 9: export default router.post(
10:   "/",
11:   validateFields({
12:     name: z.string(),
13:     describe: z.string(),
14:     projectId: z.number(),
15:     assetsItem: z.array(
16:       z.object({
17:         base64: z.string(),
18:         prompt: z.string(),
19:         describe: z.string(),
20:         name: z.string(),
21:       }),
22:     ),
23:   }),
24:   async (req, res) => {
25:     const { name, describe, projectId, assetsItem } = req.body;
26:     await Promise.all(
27:       assetsItem.map(async (i: { src?: string; base64: string; prompt: string }) => {
28:         if (i.base64) {
29:           const mimeMatch = i.base64.match(/^data:audio\/([^;]+);base64,/);
30:           const mimeExt = mimeMatch ? mimeMatch[1] : "mp3";
31:           const mimeToExt: Record<string, string> = {
32:             mpeg: "mp3",
33:             "x-wav": "wav",
34:             "x-aiff": "aiff",
35:             "x-m4a": "m4a",
36:             "x-flac": "flac",
37:           };
38:           const ext = mimeToExt[mimeExt] ?? mimeExt;
39:           const savePath = `/${projectId}/assets/audio/${u.uuid()}.${ext}`;
40:           const base64Data = i.base64.replace(/^data:[^;]+;base64,/, "");
41:           await u.oss.writeFile(savePath, base64Data);
42:           i.src = savePath;
43:         }
44:       }),
45:     );
46: 
47:     const [id] = await u.db("o_assets").insert({
48:       name,
49:       describe,
50:       type: "audio",
51:       projectId,
52:       startTime: Date.now(),
53:     });
54:     for (const item of assetsItem) {
55:       const [assetsId] = await u.db("o_assets").insert({
56:         prompt: item.prompt,
57:         assetsId: id,
58:         type: "audio",
59:         describe: item.describe,
60:         name: item.name,
61:         projectId,
62:         startTime: Date.now(),
63:       });
64:       const [imageId] = await u.db("o_image").insert({
65:         filePath: item.src,
66:         type: "audio",
67:         assetsId,
68:         state: "已完成",
69:       });
70:       await u.db("o_assets").where("id", assetsId).update({
71:         imageId,
72:       });
73:     }
74: 
75:     res.status(200).send(success({ message: "新增资产成功" }));
76:   },
