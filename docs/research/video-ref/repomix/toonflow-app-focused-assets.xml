<file path="src/routes/cornerScape/batchBindAudio.ts">
  1: import express from "express";
  2: import u from "@/utils";
  3: import { z } from "zod";
  4: import { error, success } from "@/lib/responseFormat";
  5: import { validateFields } from "@/middleware/middleware";
  6: import { tool, jsonSchema } from "ai";
  7: const router = express.Router();
  8: 
  9: // 获取资产
 10: export default router.post(
 11:   "/",
 12:   validateFields({
 13:     projectId: z.number(),
 14:     assetsIds: z.array(z.number()),
 15:     concurrentCount: z.number().min(1).optional(),
 16:   }),
 17:   async (req, res) => {
 18:     const { projectId, assetsIds, concurrentCount } = req.body;
 19:     const assetsData = await u.db("o_assets").whereIn("id", assetsIds).andWhere("projectId", projectId).select("id", "name", "describe", "type");
 20: 
 21:     const audioData = await u
 22:       .db("o_assets")
 23:       .where("type", "audio")
 24:       .whereNull("assetsId")
 25:       .andWhere("projectId", projectId)
 26:       .select("id", "name", "describe");
 27: 
 28:     if (!audioData.length) return res.status(400).send(error("暂无设置音频，请先前往资产中心上传音频"));
 29: 
 30:     const batchSize = concurrentCount ?? 1;
 31: 
 32:     async function processAsset(asset: (typeof assetsData)[number]) {
 33:       try {
 34:         const resultTool = tool({
 35:           description: "匹配完成后必须调用此工具提交结果",
 36:           inputSchema: jsonSchema<{ id: number; audioId: number }>(
 37:             z
 38:               .object({
 39:                 audioId: z.number().nullable().optional().describe("与该资产匹配的音频ID列表，若无合适匹配则返回空数组"),
 40:               })
 41:               .toJSONSchema(),
 42:           ),
 43:           execute: async (result) => {
 44:             await u.db("o_assetsRole2Audio").where("assetsRoleId", asset.id).delete();
 45:             if (result?.audioId) await u.db("o_assetsRole2Audio").insert({ assetsRoleId: asset.id, assetsAudioId: result.audioId });
 46:             await u.db("o_assets").where("id", asset.id).update("audioBindState", "已完成");
 47:             return "无需回复用户任何内容";
 48:           },
 49:         });
 50: 
 51:         const audioList = audioData.map((i) => `- ID:${i.id} | 名称:${i.name} | 描述:${i.describe ?? "无"}`).join("\n");
 52:         const promptData = await u.db("o_prompt").where("type", "audioBindPrompt").first();
 53:         let audioBindPrompt = "" as string | undefined;
 54:         if (promptData && promptData.useData) {
 55:           audioBindPrompt = promptData.useData;
 56:         } else {
 57:           audioBindPrompt = promptData?.data ?? undefined;
 58:         }
 59:         const { text } = await u.Ai.Text("universalAi").invoke({
 60:           messages: [
 61:             {
 62:               role: "system",
 63:               content: `
 64:               ${audioBindPrompt}
 65:               `,
 66:             },
 67:             {
 68:               role: "user",
 69:               content: `
 70:                 ## 候选音频列表
 71:                 ${audioList}
 72:                 ## 待匹配资产
 73:                 - ID:${asset.id} | 名称:${asset.name} | 描述:${asset.describe ?? "无"} | 类型：${asset.type}
 74:                 请从候选音频列表中为该资产选出来一个最符合该角色设定的音色，并调用 resultTool 提交结果。
 75:            `,
 76:             },
 77:           ],
 78:           tools: { resultTool },
 79:         });
 80:       } catch (e) {
 81:         await u.db("o_assets").where("id", asset.id).update("audioBindState", "生成失败");
 82:         console.error(`[bindAudio] 资产 ${asset.id} 处理失败:`, e);
 83:       }
 84:     }
 85: 
 86:     async function runWithConcurrency() {
 87:       for (let i = 0; i < assetsData.length; i += batchSize) {
 88:         const batch = assetsData.slice(i, i + batchSize);
 89: 
 90:         await Promise.all(batch.map((asset) => processAsset(asset)));
 91:       }
 92:     }
 93:     await u
 94:       .db("o_assets")
 95:       .whereIn(
 96:         "id",
 97:         assetsData.map((i) => i.id),
 98:       )
 99:       .update("audioBindState", "生成中");
100:     runWithConcurrency();
101:     res.status(200).send(success());
102:   },
103: );
</file>

