49:     const [imageId] = await u.db("o_image").insert({
50:       filePath: savePath,
51:       type,
52:       assetsId: id,
53:       state: "已完成",
54:     });
55:     await u.db("o_assets").where("id", id).update({
56:       imageId: imageId,
57:     });
58:     res.status(200).send(success("上传成功"));
59:   },
