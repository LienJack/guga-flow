 8: 
 9: // 根据 base64 头部获取文件扩展名
10: function getExtFromBase64(base64Data: string): string {
11:   const mime = base64Data.match(/^data:([^;]+);base64,/)?.[1] ?? "";
12:   const mimeMap: Record<string, string> = {
13:     // 图片
14:     "image/jpeg": "jpeg",
15:     "image/jpg": "jpg",
16:     "image/png": "png",
17:     // 音频
18:     "audio/mpeg": "mp3",
19:     "audio/mp3": "mp3",
20:     "audio/wav": "wav",
21:     // 视频
22:     "video/mp4": "mp4",
23:     "video/webm": "webm",
24:   };
25:   return mimeMap[mime] ?? "bin";
26: }
27: 
28: // 文件上传（支持图片、音频、视频）
29: export default router.post(
30:   "/",
31:   validateFields({
32:     projectId: z.number(),
33:     base64Data: z.string(),
34:     type: z.string().optional().default("clip"),
35:     name: z.string(),
36:   }),
37:   async (req, res) => {
38:     const { base64Data, projectId, type = "clip", name } = req.body;
39:     const ext = getExtFromBase64(base64Data);
40:     const savePath = `/${projectId}/assets/${uuid()}.${ext}`;
41: 
42:     await u.oss.writeFile(savePath, Buffer.from(base64Data.match(/base64,([A-Za-z0-9+/=]+)/)[1] ?? "", "base64"));
43:     const [id] = await u.db("o_assets").insert({
44:       type: type,
45:       projectId: projectId,
46:       name,
47:       startTime: Date.now(),
