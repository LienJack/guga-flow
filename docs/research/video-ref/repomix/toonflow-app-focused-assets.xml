<file path="src/routes/assets/getAssetsApi.ts">
 1: import express from "express";
 2: import u from "@/utils";
 3: import { z } from "zod";
 4: import { success } from "@/lib/responseFormat";
 5: import { validateFields } from "@/middleware/middleware";
 6: const router = express.Router();
 7: 
 8: // 获取资产
 9: export default router.post(
10:   "/",
11:   validateFields({
12:     projectId: z.number(),
13:     type: z.string(),
14:     name: z.string().optional(),
15:     page: z.number(),
16:     limit: z.number(),
17:   }),
18:   async (req, res) => {
19:     const { projectId, type, name, page = 1, limit = 10 } = req.body;
20:     const offset = (page - 1) * limit;
21:     let query = u
22:       .db("o_assets")
23:       .leftJoin("o_image", "o_assets.imageId", "o_image.id")
24:       .select("o_assets.*", "o_image.filePath", "o_image.state")
25:       .where("o_assets.projectId", projectId)
26:       .andWhere("o_assets.type", type);
27:     if (name) {
28:       query = query.andWhere("name", "like", `%${name}%`);
29:     }
30:     // 分页查询
31:     const parentAssets = await query.where("o_assets.assetsId", null).offset(offset).limit(limit);
32: 
33:     // 获取所有子资产供关联使用
34:     let childQuery = u
35:       .db("o_assets")
36:       .leftJoin("o_image", "o_assets.imageId", "o_image.id")
37:       .select("o_assets.*", "o_image.filePath", "o_image.state", "o_image.errorReason")
38:       .where("o_assets.projectId", projectId)
39:       .andWhere("o_assets.type", type)
40:       .whereNotNull("o_assets.assetsId");
41:     if (name) {
42:       childQuery = childQuery.andWhere("o_assets.name", "like", `%${name}%`);
43:     }
44:     const childAssets = await childQuery;
45: 
46:     // 为每个子资产添加图片地址
47:     const childAssetsWithSrc = await Promise.all(
48:       childAssets.map(async (child) => ({
49:         ...child,
50:         src: child.filePath && (await filterTypeGetFileUrl(child.filePath!, child.type)),
51:       })),
52:     );
53: 
54:     // 为每个父资产添加子资产
55:     const result = await Promise.all(
56:       parentAssets.map(async (parent) => ({
57:         ...parent,
58:         sonAssets: childAssetsWithSrc.filter((child) => child.assetsId === parent.id),
59:         src: parent.filePath && (await filterTypeGetFileUrl(parent.filePath!, parent.type)),
60:         ...(parent.type == "audio" ? { sex: parent.describe?.split("|")[0], describe: parent.describe?.split("|")[1] } : {}),
61:       })),
62:     );
63: 
64:     // 统计总数
65:     const totalQuery = (await u
66:       .db("o_assets")
67:       .where("projectId", projectId)
68:       .andWhere("type", type)
69:       .andWhere("assetsId", null)
70:       .andWhere((qb) => {
71:         if (name) {
72:           qb.andWhere("name", "like", `%${name}%`);
73:         }
74:       })
75:       .count("* as total")
76:       .first()) as any;
77:     res.status(200).send(success({ data: result, total: totalQuery?.total }));
78:   },
79: );
80: 
81: async function filterTypeGetFileUrl(url: string, type: string) {
82:   if (type == "role" || type == "tool" || type == "scene") {
83:     return await u.oss.getSmallImageUrl(url);
84:   } else {
85:     return await u.oss.getFileUrl(url);
86:   }
87: }
</file>

