 34:     items: zod.array(
 35:       zod.object({
 36:         assetsId: zod.number(),
 37:         type: zod.string(),
 38:         name: zod.string(),
 39:         describe: zod.string(),
 40:       }),
 41:     ),
 42:     projectId: zod.number(),
 43:     concurrentCount: zod.number().int().min(1).optional(),
 44:     otherTextPrompt: zod.string(),
 45:   }),
 46:   async (req, res) => {
 47:     const { projectId, items, concurrentCount, otherTextPrompt } = req.body;
 48:     //获取风格
 49:     const project = await u.db("o_project").where("id", projectId).select("artStyle", "type", "intro").first();
 50:     //如果没有找到对应的项目，返回错误
 51:     if (!project) return res.status(500).send(success({ message: "项目为空" }));
 52: 
 53:     // 预加载公共数据
 54:     const assetsIds = items.map((item: { assetsId: number }) => item.assetsId);
 55:     //查询所有资产，用于判断每个资产是否是衍生资产
 56:     const assetsDataList = await u.db("o_assets").whereIn("id", assetsIds).select("id", "assetsId");
 57:     if (!assetsDataList || assetsDataList.length === 0) return res.status(500).send(error("资产不存在"));
 58:     const assetsDataMap = new Map(assetsDataList.map((a: any) => [a.id, a]));
 59:     // 所有前置检测通过后，再批量更新状态为生成中
 60:     await u.db("o_assets").whereIn("id", assetsIds).update({ promptState: "生成中" });
 61: 
 62:     const getTypeConfig = (
 63:       isDerivative: boolean,
 64:     ): Record<string, { promptKey: string; itemType: ItemType; label: string; nameLabel: string; visualManual: string }> => ({
 65:       role: {
 66:         promptKey: "role-polish",
 67:         itemType: "characters",
 68:         label: "角色标准四视图",
 69:         nameLabel: "角色",
 70:         visualManual: isDerivative ? "art_character_derivative" : "art_character",
 71:       },
 72:       scene: {
 73:         promptKey: "scene-polish",
 74:         itemType: "scenes",
 75:         label: "场景图",
 76:         nameLabel: "场景",
 77:         visualManual: isDerivative ? "art_scene_derivative" : "art_scene",
 78:       },
 79:       tool: {
 80:         promptKey: "tool-polish",
 81:         itemType: "props",
 82:         label: "道具图",
 83:         nameLabel: "道具",
 84:         visualManual: isDerivative ? "art_prop_derivative" : "art_prop",
 85:       },
 86:     });
 87: 
 88:     // 后台异步并发生成，不阻塞响应
 89:     const limit = pLimit(concurrentCount ?? 1);
 90:     const tasks = items.map((item: { assetsId: number; type: string; name: string; describe: string }) =>
 91:       limit(async () => {
 92:         const assetData = assetsDataMap.get(item.assetsId);
 93:         if (!assetData) return;
 94:         const typeConfig = getTypeConfig(!!assetData.assetsId);
 95:         const config = typeConfig[item.type];
 96:         if (!config) return;
 97:         //获取到视觉手册
 98:         const visualManual = await u.getArtPrompt(project.artStyle as string, "art_skills", config.visualManual);
 99:         if (!visualManual) {
100:           await u.db("o_assets").where("id", item.assetsId).update({ promptState: "生成失败", promptErrorReason: "视觉手册未定义" });
101:           return;
102:         }
103:         const systemPrompt = visualManual;
104:         try {
105:           const { _output } = (await u.Ai.Text("universalAi").invoke({
106:             system: systemPrompt + "\n" + otherTextPrompt,
107:             messages: [
108:               {
109:                 role: "user",
110:                 content: `
111:                     **基础参数：**
112:       **${config.nameLabel}设定：**
113:       - ${config.nameLabel}名称:${item.name},
114:       - ${config.nameLabel}描述:${item.describe},`,
115:               },
116:             ],
117:           })) as any;
118: 
119:           if (!_output) {
120:             await u.db("o_assets").where("id", item.assetsId).update({ promptState: "生成失败" });
121:             return;
122:           }
123: 
124:           await u.db("o_assets").where("id", item.assetsId).update({ prompt: _output, promptState: "已完成" });
125:         } catch (e: any) {
126:           await u
127:             .db("o_assets")
128:             .where("id", item.assetsId)
129:             .update({ promptState: "失败", promptErrorReason: u.error(e).message });
130:         }
131:       }),
132:     );
133: 
134:     // 后台执行，不等待结果
135:     Promise.all(tasks).catch((err: any) => {
136:       res.status(500).send(error(err));
137:     });
138: 
139:     return res.status(200).send(success({ total: items.length }));
140:   },
141: );
</file>

