180: export function createSkillTools(skills: { name: string; description: string }[], skillPaths: SkillPaths, rootDir: string = getPath("skills")) {
181:   const activated = new Set<string>(); // 已激活技能集合，防止重复加载
182:   const skillsRootDir = path.resolve(rootDir);
183:   const skillNames = skills.map((s) => s.name);
184:   const skillMap = new Map(skillPaths.mainSkill.map((s) => [s.name, s]));
185:   return {
186:     activate_skill: tool({
187:       description: `激活一个技能，加载其完整指令和捆绑资源列表到上下文。可用技能：${skillNames.join(", ")}`,
188:       inputSchema: jsonSchema<{ name: string }>(
189:         z
190:           .object({
191:             name: z.enum(skillNames as [string, ...string[]]).describe("要激活的技能名称"),
192:           })
193:           .toJSONSchema(),
194:       ),
195:       execute: async ({ name }) => {
196:         if (activated.has(name)) {
197:           console.log(`⚡[主技能] ℹ️ 技能 "${name}" 已激活，跳过重复注入`);
198:           return { alreadyActive: true, message: `技能 "${name}" 已激活，无需重复加载` };
199:         }
200:         const matched = skillMap.get(name);
201:         if (!matched) return { error: `未找到技能 "${name}"` };
202:         let raw = "";
203:         try {
204:           raw = await fs.promises.readFile(matched.path, "utf-8");
205:           console.log(`⚡[主技能] ✓ 已读取主技能文件： ${matched.path}（${raw.length} 字符）`);
206:         } catch (error) {
207:           console.log(`⚡[主技能] ✗ 读取失败：未找到文件 "${matched.path}"`);
208:         }
209:         activated.add(name);
210:         console.log(`⚡[主技能] ✓ 技能 "${name}" 已激活`);
211:         const body = ensureNonEmptyBody(raw.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/, ""), "该技能文件无正文内容。");
212:         let content = "";
213:         content = `<skill_content name="${name}">\n`;
214:         content += body + "\n\n";
215:         content += "使用 read_skill_file 工具读取资源文件。\n";
216:         if (skillPaths.secondarySkills.length > 0) {
217:           content += "\n<skill_resources>\n";
218:           for (const path of skillPaths.secondarySkills) {
219:             content += `  <file>${path}</file>\n`;
220:           }
221:           content += "</skill_resources>\n";
222:         }
223:         content += "</skill_content>";
224:         return { content };
225:       },
226:     }),
227:     read_skill_file: tool({
228:       description: "读取已激活技能目录下的资源文件。传入 activate_skill 返回的 skill_resources 中的文件路径。",
229:       inputSchema: jsonSchema<{ filePath: string }>(
230:         z
231:           .object({
232:             filePath: z.string().describe("资源文件的相对路径，来自 activate_skill 返回的 skill_resources"),
233:           })
234:           .toJSONSchema(),
235:       ),
236:       execute: async ({ filePath }) => {
237:         const normalizedInputPath = toUnixPath(filePath).trim();
238:         if (!normalizedInputPath) {
239:           console.log(`📖[技法文件] ✗ filePath 不能为空`);
240:           return { error: "filePath 不能为空" };
241:         }
242: 
243:         const fullPath = path.resolve(path.join(skillsRootDir, normalizedInputPath));
244:         if (!(fullPath === skillsRootDir || isPathInside(fullPath, skillsRootDir))) {
245:           console.log(`📖[技法文件] ✗ 路径越界已拦截："${filePath}" 超出技能目录范围`);
246:           return { error: "Access denied: path is outside skill directory" };
247:         }
248:         let body = "";
249:         try {
250:           body = await fs.promises.readFile(fullPath, "utf-8");
251:           console.log(`📖[技法文件] ✓ 已读取文件： ${filePath}（${body.length} 字符）`);
252:         } catch {
253:           console.log(`📖[技法文件] ✗ 读取失败：未找到文件 "${filePath}"`);
254:           return { error: `File not found: ${filePath}` };
255:         }
256:         const safeBody = ensureNonEmptyBody(body, "该资源文件为空。");
257:         let content = "";
258:         content = `<skill_content>\n`;
259:         content += safeBody + "\n\n";
260:         content += "可以使用 read_skill_file 工具读取资源文件。\n";
261:         if (skillPaths.tertiarySkills.length > 0) {
262:           content += "\n<skill_resources>\n";
263:           for (const path of skillPaths.tertiarySkills) {
264:             content += `  <file>${path}</file>\n`;
265:           }
266:           content += "</skill_resources>\n";
267:         }
268:         content += "</skill_content>";
269:         return { content };
270:       },
271:     }),
272:   };
273: }
