377: async function createArtSkills(artName: string, storyName: string) {
378:   const artWorkerPath = u.getPath(["skills", "art_skills", artName, "driector_skills"]);
379:   const storyWorkerPath = u.getPath(["skills", "story_skills", storyName, "driector_skills"]);
380:   const skillList = [...(await scanSkills(artWorkerPath + "/*.md")), ...(await scanSkills(storyWorkerPath + "/*.md"))];
381:   const mainSkills: { path: string; name: string; description: string }[] = [];
382:   for (const skillPath of skillList) {
383:     if (!fs.existsSync(skillPath)) throw new Error(`主技能文件不存在: ${skillPath}`);
384:     const content = await fs.promises.readFile(skillPath, "utf-8");
385:     const parsed = parseFrontmatter(content);
386:     mainSkills.push({ path: skillPath, ...parsed });
387:   }
388:   const res = {
389:     prompt: `## Skills
390: 以下技能提供了专业任务的专用指令。
391: 当任务与某个技能的描述匹配时，调用 activate_skill 工具并传入技能名称来加载完整指令。
392: ${buildSkillPrompt(mainSkills)}`,
393:     tools: createSkillTools(mainSkills, { mainSkill: mainSkills, secondarySkills: [], tertiarySkills: [] }),
394:   };
395:   return res;
396: }
397: async function consumeFullStream(
398:   fullStream: AsyncIterable<any>,
399:   initialMsg: ReturnType<ResTool["newMessage"]>,
400:   syncMsg?: () => ReturnType<ResTool["newMessage"]>,
401: ): Promise<string> {
402:   let msg = initialMsg;
403:   let text = msg.text();
404:   let thinking: ReturnType<typeof msg.thinking> | null = null;
405:   let thinkTime = 0;
406:   let fullResponse = "";
407: 
408:   try {
409:     for await (const chunk of fullStream) {
410:       if (syncMsg) {
411:         const newMsg = syncMsg();
412:         if (newMsg !== msg) {
413:           msg = newMsg;
414:           text = msg.text();
415:         }
416:       }
417:       if (chunk.type === "reasoning-start") {
418:         thinkTime = Date.now();
419:         thinking = msg.thinking("思考中...");
420:       } else if (chunk.type === "reasoning-delta") {
421:         thinking?.append(chunk.text);
422:       } else if (chunk.type === "reasoning-end") {
423:         thinkTime = Date.now() - thinkTime;
424:         thinking?.updateTitle(`思考完毕（${(thinkTime / 1000).toFixed(1)} 秒）`);
425:         thinking?.complete();
426:         thinking = null;
427:       } else if (chunk.type === "text-delta") {
428:         text.append(chunk.text);
429:         fullResponse += chunk.text;
430:       } else if (chunk.type === "error") {
431:         throw chunk.error;
432:       } else if (chunk.type == "finish") {
433:         break;
434:       }
435:     }
436:     text.complete();
437:     msg.complete();
438:   } catch (err: any) {
439:     thinking?.complete();
440:     const errMsg = err?.message ?? String(err);
441:     text.append(errMsg);
442:     text.error();
443:     msg.error();
444:     throw err;
445:   }
446: 
447:   return fullResponse;
448: }
449: function removeAllXmlTags(text: string): string {
450:   text = text.replace(/<([a-zA-Z][\w-]*)(\s+[^>]*)?>([\s\S]*?)<\/\1>/g, "");
451:   text = text.replace(/<([a-zA-Z][\w-]*)(\s+[^>]*)?\/>/g, "");
452:   text = text.replace(/<\/?[a-zA-Z][\w-]*(\s+[^>]*)?>/g, "");
453:   return text.trim();
454: }
