456: export function buildSkillPrompt(skills: { name: string; description: string }[]): string {
457:   const skillEntries = skills
458:     .map((s) => `  <skill>\n    <name>${s.name}</name>\n    <description>${s.description}</description>\n  </skill>`)
459:     .join("\n");
460:   return `
461: <available_skills>
462: ${skillEntries}
463: </available_skills>`;
464: }
