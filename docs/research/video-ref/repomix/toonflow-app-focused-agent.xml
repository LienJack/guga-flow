142: async function withTaskRecord<T>(
143:   modelKey: AiType | `${string}:${string}`,
144:   taskClass: string,
145:   describe: string,
146:   relatedObjects: string,
147:   projectId: number,
148:   fn: (modelName: `${string}:${string}`, think: Boolean, thinkLevel: 0 | 1 | 2 | 3) => Promise<T>,
149: ): Promise<T> {
150:   const modelName = await resolveModelName(modelKey);
151:   const [_, model] = modelName.split(/:(.+)/);
152:   const taskRecord = await u.task(projectId, taskClass, model, { describe: describe, content: relatedObjects });
153:   try {
154:     const result = await fn(modelName, false, 0);
155: 
156:     taskRecord(1);
157:     return result;
158:   } catch (e) {
159:     taskRecord(-1, u.error(e).message);
160:     throw new Error(u.error(e).message);
161:   }
162: }
