468:   const storyWorkerPath = u.getPath(["skills", "story_skills", storyName, "driector_skills"]);
469:   const productionPath = u.getPath(["skills", "production_skills"]);
470:   const skillList = [
471:     ...(await scanSkills(artWorkerPath + "/*.md")),
472:     ...(await scanSkills(storyWorkerPath + "/*.md")),
473:     ...(await scanSkills(productionPath + "/*.md")),
474:   ];
475:   const mainSkills: { path: string; name: string; description: string }[] = [];
476:   for (const skillPath of skillList) {
