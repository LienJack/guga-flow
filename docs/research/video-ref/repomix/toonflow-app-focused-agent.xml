166: export function buildSkillPrompt(skills: { name: string; description: string }[]): string {
167:   const skillEntries = skills
168:     .map((s) => `  <skill>\n    <name>${s.name}</name>\n    <description>${s.description}</description>\n  </skill>`)
169:     .join("\n");
170:   return `## Skills
171: 以下技能提供了专业任务的专用指令。
172: 当任务与某个技能的描述匹配时，调用 activate_skill 工具并传入技能名称来加载完整指令。
173: 加载后遵循技能指令执行任务，需要时调用 read_skill_file 读取资源文件内容。
174: 
175: <available_skills>
176: ${skillEntries}
177: </available_skills>`;
178: }
