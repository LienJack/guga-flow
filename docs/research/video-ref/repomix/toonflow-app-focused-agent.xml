 27: function buildMemPrompt(mem: Awaited<ReturnType<Memory["get"]>>): string {
 28:   let memoryContext = "";
 29:   if (mem.rag.length) {
 30:     memoryContext += `[相关记忆]\n${mem.rag.map((r) => r.content).join("\n")}`;
 31:   }
 32:   if (mem.summaries.length) {
 33:     if (memoryContext) memoryContext += "\n\n";
 34:     memoryContext += `[历史摘要]\n${mem.summaries.map((s, i) => `${i + 1}. ${s.content}`).join("\n")}`;
 35:   }
 36:   if (mem.shortTerm.length) {
 37:     if (memoryContext) memoryContext += "\n\n";
 38:     memoryContext += `[近期对话]\n${mem.shortTerm.map((m) => `${m.role}: ${m.content}`).join("\n")}`;
 39:   }
 40:   return `## Memory\n以下是你对用户的记忆，可作为参考但不要主动提及：\n${memoryContext}`;
 41: }
