164: async function urlToBase64(url: string, retries = 3, delay = 1000): Promise<string> {
165:   for (let attempt = 1; attempt <= retries; attempt++) {
166:     try {
167:       const res = await axios.get(url, { responseType: "arraybuffer" });
168:       const base64 = Buffer.from(res.data).toString("base64");
169:       return `${base64}`;
170:     } catch (e) {
171:       if (attempt === retries) throw e;
172:       await new Promise((resolve) => setTimeout(resolve, delay * attempt));
173:     }
174:   }
175:   throw new Error("urlToBase64 failed");
176: }
177: class AiText {
178:   private AiType: AiType | `${string}:${string}`;
179:   private think?: boolean;
180:   private thinkLevel: 0 | 1 | 2 | 3;
181:   constructor(AiType: AiType | `${string}:${string}`, think?: boolean, thinkLevel: 0 | 1 | 2 | 3 = 0) {
182:     this.AiType = AiType;
183:     this.think = think;
184:     this.thinkLevel = thinkLevel;
185:   }
186:   private async resolveModel(middleware?: any | any[]) {
187:     const switchAiDevTool = await u.db("o_setting").where("key", "switchAiDevTool").first();
188:     const modelName = await resolveModelName(this.AiType);
189:     const sdkFn = await getVendorTemplateFn("textRequest", modelName);
190:     const baseModel = await sdkFn(this.think, this.thinkLevel);
191:     const mws = [
192:       ...(switchAiDevTool?.value === "1" ? [devToolsMiddleware()] : []),
193:       ...(middleware ? (Array.isArray(middleware) ? middleware : [middleware]) : []),
194:     ];
195:     return mws.length > 0 ? wrapLanguageModel({ model: baseModel, middleware: mws.length === 1 ? mws[0] : mws }) : baseModel;
196:   }
197:   async invoke(input: Omit<Parameters<typeof generateText>[0], "model">) {
198:     const config = await getModelConfig(this.AiType);
199: 
200:     return generateText({
201:       ...(input.tools && { stopWhen: stepCountIs(Object.keys(input.tools).length * 50) }),
202:       ...input,
203:       model: await this.resolveModel(),
204:       ...(config?.temperature && { temperature: config.temperature }),
205:       ...(config?.maxOutputTokens && { maxOutputTokens: config.maxOutputTokens }),
206:     } as Parameters<typeof generateText>[0]);
207:   }
208:   async stream(input: Omit<Parameters<typeof streamText>[0], "model">) {
209:     const config = await getModelConfig(this.AiType);
210: 
211:     return streamText({
212:       ...(input.tools && { stopWhen: stepCountIs(Object.keys(input.tools).length * 50) }),
213:       ...input,
214:       model: await this.resolveModel(extractReasoningMiddleware({ tagName: "reasoning_content", separator: "\n" })),
215:       ...(config?.temperature && { temperature: config.temperature }),
216:       ...(config?.maxOutputTokens && { maxOutputTokens: config.maxOutputTokens }),
217:     } as Parameters<typeof streamText>[0]);
218:   }
219: }
