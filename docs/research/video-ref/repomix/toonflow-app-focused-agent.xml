236: async function consumeFullStream(
237:   fullStream: AsyncIterable<any>,
238:   initialMsg: ReturnType<ResTool["newMessage"]>,
239:   syncMsg?: () => ReturnType<ResTool["newMessage"]>,
240: ): Promise<string> {
241:   let msg = initialMsg;
242:   let text = msg.text();
243:   let thinking: ReturnType<typeof msg.thinking> | null = null;
244:   let thinkTime = 0;
245:   let fullResponse = "";
246: 
247:   try {
248:     for await (const chunk of fullStream) {
249:       if (syncMsg) {
250:         const newMsg = syncMsg();
251:         if (newMsg !== msg) {
252:           msg = newMsg;
253:           text = msg.text();
254:         }
255:       }
256:       if (chunk.type === "reasoning-start") {
257:         thinkTime = Date.now();
258:         thinking = msg.thinking("思考中...");
259:       } else if (chunk.type === "reasoning-delta") {
260:         thinking?.append(chunk.text);
261:       } else if (chunk.type === "reasoning-end") {
262:         thinkTime = Date.now() - thinkTime;
263:         thinking?.updateTitle(`思考完毕（${(thinkTime / 1000).toFixed(1)} 秒）`);
264:         thinking?.complete();
265:         thinking = null;
266:       } else if (chunk.type === "text-delta") {
267:         text.append(chunk.text);
268:         fullResponse += chunk.text;
269:       } else if (chunk.type === "error") {
270:         throw chunk.error;
271:       }
272:     }
273:     text.complete();
274:     msg.complete();
275:   } catch (err: any) {
276:     thinking?.complete();
277:     const errMsg = err?.message ?? String(err);
278:     text.append(errMsg);
279:     text.error();
280:     msg.error();
281:     throw err;
282:   }
283: 
284:   return fullResponse;
285: }
286: 
287: function removeAllXmlTags(text: string): string {
288:   text = text.replace(/<([a-zA-Z][\w-]*)(\s+[^>]*)?>([\s\S]*?)<\/\1>/g, "");
289:   text = text.replace(/<([a-zA-Z][\w-]*)(\s+[^>]*)?\/>/g, "");
290:   text = text.replace(/<\/?[a-zA-Z][\w-]*(\s+[^>]*)?>/g, "");
291:   return text.trim();
292: }
</file>

