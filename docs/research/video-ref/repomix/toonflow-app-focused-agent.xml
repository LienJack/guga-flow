 65:   const { fullStream } = await u.Ai.Text("scriptAgent:decisionAgent", ctx.thinkConfig.think, ctx.thinkConfig.thinlLevel).stream({
 66:     messages: [
 67:       { role: "system", content: prompt },
 68:       { role: "assistant", content: projectInfo + "\n" + mem },
 69:       { role: "user", content: text },
