<file path="src/utils/agent/embedding.ts">
 1: import * as ONNX_WEB from "onnxruntime-web";
 2: import { pipeline, env as transformersEnv, FeatureExtractionPipeline } from "@huggingface/transformers";
 3: import path from "path";
 4: import fs from "fs";
 5: import getPath from "@/utils/getPath";
 6: import db from "@/utils/db";
 7: 
 8: // ── 模型配置 ──
 9: // const modelOnnxFile = ["all-MiniLM-L6-v2", "onnx", "model_fp16.onnx"]; // 模型文件路径
10: // const modelDtype = "fp16" as const; // 量化类型：fp32
11: let extractor: FeatureExtractionPipeline | null = null;
12: 
13: export async function initEmbedding(): Promise<void> {
14:   if (extractor) return;
15: 
16:   const modelConfigData = await db("o_setting").whereIn("key", ["modelOnnxFile", "modelDtype"]);
17:   const modelObj: Record<string, string> = {};
18:   Object.entries(modelConfigData).forEach(([key, value]) => {
19:     modelObj[key] = value as string;
20:   });
21:   let modelOnnxFile = modelObj?.modelOnnxFile ? JSON.parse(modelObj.modelOnnxFile) : ["all-MiniLM-L6-v2", "onnx", "model_fp16.onnx"]; // 模型文件路径
22:   let modelDtype = modelObj?.modelDtype ?? ("fp16" as const); // 量化类型：fp32
23:   const onnxPath = path.join(getPath("models"), ...modelOnnxFile);
24:   if (!fs.existsSync(onnxPath)) {
25:     throw new Error(`Embedding 模型文件不存在: ${onnxPath}`);
26:   }
27: 
28:   transformersEnv.allowRemoteModels = false;
29:   transformersEnv.allowLocalModels = true;
30:   transformersEnv.localModelPath = getPath("models").replace(/\\/g, "/") + "/";
31: 
32:   const modelFolder = modelOnnxFile[0];
33:   // @ts-ignore - pipeline 重载联合类型过于复杂
34:   extractor = await pipeline("feature-extraction", modelFolder, { dtype: modelDtype });
35: }
36: 
37: export async function getEmbedding(text: string): Promise<number[]> {
38:   if (!extractor) await initEmbedding();
39:   const output = await extractor!(text, { pooling: "mean", normalize: true });
40:   return Array.from(output.data as Float32Array);
41: }
42: 
43: export function cosineSimilarity(a: number[], b: number[]): number {
44:   return a.reduce((dot, v, i) => dot + v * b[i], 0);
45: }
46: 
47: export async function disposeEmbedding(): Promise<void> {
48:   await extractor?.dispose?.();
49:   extractor = null;
50: }
</file>

<file path="src/utils/agent/memory.ts">
  1: import u from "@/utils";
  2: import { v4 as uuidv4 } from "uuid";
  3: import { getEmbedding, cosineSimilarity } from "./embedding";
  4: import type { memories as MemoryRow } from "@/types/database";
  5: import { tool, jsonSchema } from "ai";
  6: import { z } from "zod";
  7: 
  8: // ── 可调配置默认值 ──
  9: const DEFAULTS: {
 10:   messagesPerSummary: number;
 11:   summaryMaxLength: number;
 12:   shortTermLimit: number;
 13:   summaryLimit: number;
 14:   ragLimit: number;
 15:   deepRetrieveSummaryLimit: number;
 16: } = {
 17:   messagesPerSummary: 3, // 每累积多少条message触发一次summary生成
 18:   summaryMaxLength: 500, // summary最大字符长度
 19:   shortTermLimit: 5, // get()返回的近期未总结message条数
 20:   summaryLimit: 10, // get()返回的summary条数
 21:   ragLimit: 3, // get()向量相似搜索返回的message条数
 22:   deepRetrieveSummaryLimit: 5, // deepRetrieve()向量召回summary的条数
 23: };
 24: 
 25: // ── 向量搜索辅助 ──
 26: function vectorSearch(rows: MemoryRow[], queryEmbedding: number[], limit: number) {
 27:   return rows
 28:     .map((row) => {
 29:       const emb: number[] = JSON.parse(row.embedding ?? "[]");
 30:       return { ...row, similarity: cosineSimilarity(queryEmbedding, emb) };
 31:     })
 32:     .sort((a, b) => b.similarity - a.similarity)
 33:     .slice(0, limit);
 34: }
 35: 
 36: class Memory {
 37:   private agentType: string;
 38:   private isolationKey: string;
 39: 
 40:   constructor(agentType: string, isolationKey: string) {
 41:     this.agentType = agentType;
 42:     this.isolationKey = isolationKey;
 43:   }
 44: 
 45:   private async generateSummary(contents: string[]): Promise<string> {
 46:     const { summaryMaxLength } = await this.getConfigData({ summaryMaxLength: DEFAULTS.summaryMaxLength });
 47:     const { text } = await u.Ai.Text(this.agentType as any).invoke({
 48:       system: `你是一个记忆压缩助手。请将以下多条记忆内容压缩为一段简洁的摘要，不超过${summaryMaxLength}个字符。只输出摘要内容，不要加任何前缀或解释。`,
 49:       messages: [{ role: "user", content: contents.map((c, i) => `${i + 1}. ${c}`).join("\n") }],
 50:     });
 51:     return text.slice(0, Number(summaryMaxLength));
 52:   }
 53: 
 54:   private async judgeSummaryRelevance(keyword: string, summaries: { id: string; content: string }[]): Promise<string[]> {
 55:     const list = summaries.map((s) => `[${s.id}] ${s.content}`).join("\n");
 56:     const { text } = await u.Ai.Text(this.agentType as any).invoke({
 57:       system:
 58:         '你是一个信息检索助手。用户会给你一个关键词和一组摘要，请判断哪些摘要可能包含与关键词相关的详细信息。只返回相关摘要的id列表，用JSON数组格式，例如 ["id1","id2"]。不要解释。',
 59:       messages: [{ role: "user", content: `关键词: ${keyword}\n\n摘要列表:\n${list}` }],
 60:     });
 61:     try {
 62:       const ids = JSON.parse(text);
 63:       if (Array.isArray(ids)) return ids.map(String);
 64:     } catch {}
 65:     return [];
 66:   }
 67:   private async getConfigData<T extends Record<string, string | number>>(defaults: T): Promise<T> {
 68:     const keys = Object.keys(defaults) as (keyof T & string)[];
 69:     const rows = await u.db("o_setting").whereIn("key", keys);
 70: 
 71:     const dbMap: Record<string, string | null> = {};
 72:     for (const row of rows) {
 73:       if (row.key != null) dbMap[row.key] = row.value ?? null;
 74:     }
 75: 
 76:     const result = { ...defaults };
 77:     for (const key of keys) {
 78:       const raw = dbMap[key];
 79:       if (raw == null) continue; // null / undefined 使用默认值
 80:       const num = Number(raw);
 81:       (result as Record<string, string | number>)[key] = Number.isNaN(num) ? raw : num;
 82:     }
 83:     return result;
 84:   }
 85: 
 86:   async add(role: string = "user", content: string, options?: { name?: string; createTime?: number }) {
 87:     const { messagesPerSummary } = await this.getConfigData({ messagesPerSummary: DEFAULTS.messagesPerSummary });
 88:     const id = uuidv4();
 89:     const embedding = await getEmbedding(content);
 90:     const isolationKey = this.isolationKey;
 91: 
 92:     await u.db("memories").insert({
 93:       id,
 94:       isolationKey,
 95:       type: "message",
 96:       role,
 97:       name: options?.name,
 98:       content,
 99:       embedding: JSON.stringify(embedding),
100:       relatedMessageIds: null,
101:       summarized: 0,
102:       createTime: options?.createTime ?? Date.now(),
103:     } as any);
104: 
105:     // 检查未总结消息数量
106:     const unsummarized = await u.db("memories").where({ isolationKey, type: "message", summarized: 0 }).orderBy("createTime", "asc");
107: 
108:     if (unsummarized.length >= Number(messagesPerSummary)) {
109:       const batch = unsummarized.slice(0, Number(messagesPerSummary));
110:       const batchIds = batch.map((m) => m.id);
111:       const batchContents = batch.map((m) => m.content);
112: 
113:       const summaryContent = await this.generateSummary(batchContents);
114:       const summaryEmbedding = await getEmbedding(summaryContent);
115:       const summaryId = uuidv4();
116: 
117:       await u.db("memories").insert({
118:         id: summaryId,
119:         isolationKey,
120:         type: "summary",
121:         content: summaryContent,
122:         embedding: JSON.stringify(summaryEmbedding),
123:         relatedMessageIds: JSON.stringify(batchIds),
124:         summarized: 0,
125:         createTime: Date.now(),
126:       } as any);
127: 
128:       // 标记已总结
129:       await u.db("memories").whereIn("id", batchIds).update({ summarized: 1 });
130:     }
131:   }
132: 
133:   async get(text: string) {
134:     const { shortTermLimit, summaryLimit, ragLimit } = await this.getConfigData({
135:       shortTermLimit: DEFAULTS.shortTermLimit,
136:       summaryLimit: DEFAULTS.summaryLimit,
137:       ragLimit: DEFAULTS.ragLimit,
138:     });
139: 
140:     const isolationKey = this.isolationKey;
141:     // shortTerm: 最近未被总结的 messages
142:     const shortTerm = await u
143:       .db("memories")
144:       .where({ isolationKey, type: "message", summarized: 0 })
145:       .orderBy("createTime", "desc")
146:       .limit(Number(shortTermLimit));
147:     shortTerm.reverse(); // 最旧在前
148: 
149:     // summaries: 最近的 summary
150:     const summaries = await u.db("memories").where({ isolationKey, type: "summary" }).orderBy("createTime", "desc").limit(Number(summaryLimit));
151:     summaries.reverse();
152: 
153:     // rag: 向量搜索所有 messages
154:     const queryEmbedding = await getEmbedding(text);
155:     const allMessages = await u.db("memories").where({ isolationKey, type: "message" });
156:     const ragResults = vectorSearch(allMessages, queryEmbedding, Number(ragLimit));
157: 
158:     return {
159:       shortTerm: shortTerm.map((m: any) => ({ id: m.id, role: m.role, name: m.name, content: m.content, createTime: m.createTime })),
160:       summaries: summaries.map((s) => ({
161:         id: s.id,
162:         content: s.content,
163:         relatedMessageIds: JSON.parse(s.relatedMessageIds || "[]"),
164:         createTime: (s as any).createTime,
165:       })),
166:       rag: ragResults.map((r) => ({ id: r.id, content: r.content, similarity: r.similarity })),
167:     };
168:   }
169: 
170:   async deepRetrieve(keyword: string) {
171:     const { deepRetrieveSummaryLimit } = await this.getConfigData({ deepRetrieveSummaryLimit: DEFAULTS.deepRetrieveSummaryLimit });
172: 
173:     const isolationKey = this.isolationKey;
174:     // 步骤1: 向量搜索 summary
175:     const queryEmbedding = await getEmbedding(keyword);
176:     const allSummaries = await u.db("memories").where({ isolationKey, type: "summary" });
177:     const topSummaries = vectorSearch(allSummaries, queryEmbedding, Number(deepRetrieveSummaryLimit));
178: 
179:     if (topSummaries.length === 0) return [];
180: 
181:     // 步骤2: AI 判断相关性
182:     const relevantIds = await this.judgeSummaryRelevance(
183:       keyword,
184:       topSummaries.map((s) => ({ id: s.id!, content: s.content })),
185:     );
186: 
187:     if (relevantIds.length === 0) return [];
188: 
189:     // 步骤3: 展开查询原始 messages
190:     const relevantSummaries = topSummaries.filter((s) => relevantIds.includes(s.id!));
191:     const messageIds = relevantSummaries.flatMap((s) => JSON.parse(s.relatedMessageIds || "[]") as string[]);
192: 
193:     if (messageIds.length === 0) return [];
194: 
195:     const messages = await u.db("memories").whereIn("id", messageIds).orderBy("createTime", "asc");
196: 
197:     return messages.map((m) => ({ id: m.id, content: m.content, createTime: m.createTime }));
198:   }
199: 
200:   getTools() {
201:     return {
202:       deepRetrieve: tool({
203:         description: "深度检索记忆：当你需要回忆与某个关键词相关的详细历史信息时使用此工具",
204:         inputSchema: jsonSchema<{ keyword: string }>(
205:           z
206:             .object({
207:               keyword: z.string().describe("要检索的关键词"),
208:             })
209:             .toJSONSchema(),
210:         ),
211:         execute: async ({ keyword }) => {
212:           const results = await this.deepRetrieve(keyword);
213:           if (results.length === 0) return { found: false, message: "未找到相关记忆" };
214:           return { found: true, memories: results.map((r) => r.content) };
215:         },
216:       }),
217:     };
218:   }
219: }
