 27:   if (mem.rag.length) {
 28:     memoryContext += `[相关记忆]\n${mem.rag.map((r) => r.content).join("\n")}`;
 29:   }
 30:   if (mem.summaries.length) {
 31:     if (memoryContext) memoryContext += "\n\n";
 32:     memoryContext += `[历史摘要]\n${mem.summaries.map((s, i) => `${i + 1}. ${s.content}`).join("\n")}`;
 33:   }
 34:   if (mem.shortTerm.length) {
 35:     if (memoryContext) memoryContext += "\n\n";
 36:     memoryContext += `[近期对话]\n${mem.shortTerm.map((m) => `${m.role}: ${m.content}`).join("\n")}`;
