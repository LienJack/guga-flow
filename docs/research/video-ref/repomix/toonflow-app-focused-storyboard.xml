 18:   prompt?: string;
 19: }
 20: 
 21: export default router.post(
 22:   "/",
 23:   validateFields({
 24:     projectId: z.number(),
 25:     scriptId: z.number(),
 26:     uploadData: z.array(
 27:       z.object({
 28:         id: z.number(),
 29:         sources: z.string(),
 30:       }),
 31:     ),
 32:     prompt: z.string(),
 33:     model: z.string(),
 34:     mode: z.string(),
 35:     resolution: z.string(),
 36:     duration: z.number(),
 37:     audio: z.boolean().optional(),
 38:     trackId: z.number(),
 39:   }),
 40:   async (req, res) => {
 41:     const { scriptId, projectId, prompt, uploadData, model, duration, resolution, audio, mode, trackId } = req.body;
 42:     let modeData = [];
 43:     if (Array.isArray(mode)) {
 44:     } else if (typeof mode === "string" && mode.startsWith('["') && mode.endsWith('"]')) {
 45:       try {
 46:         modeData = JSON.parse(mode);
 47:       } catch (e) {}
 48:     }
 49:     //获取生成视频比例
 50:     const ratio = await u.db("o_project").select("videoRatio").where("id", projectId).first();
 51:     const videoPath = `/${projectId}/video/${uuidv4()}.mp4`; //视频保存路径
 52:     //查询出图片数据
 53:     const images = await Promise.all(
 54:       uploadData.map(async (item: UploadItem) => {
 55:         if (item.sources === "storyboard") {
 56:           const filePath = await u.db("o_storyboard").where("id", item.id).select("filePath").first();
 57:           return { path: filePath?.filePath, sources: "storyBoard" };
 58:         }
 59:         if (item.sources === "assets") {
 60:           const filePath = await u
 61:             .db("o_assets")
 62:             .where("o_assets.id", item.id)
 63:             .leftJoin("o_image", "o_assets.imageId", "o_image.id")
 64:             .select("o_image.filePath", "o_image.type")
 65:             .first();
 66:           return { path: filePath?.filePath, sources: filePath.type };
 67:         }
 68:       }),
 69:     );
 70:     //把images里面的图片转成base64格式
 71:     const base64 = await Promise.all(
 72:       images.map(async (item) => {
 73:         if (!item) return null;
 74:         return { base64: await u.oss.getImageBase64(item.path), type: item.sources == "audio" ? "audio" : "image" };
 75:       }),
 76:     );
 77:     //新增
 78:     const [videoId] = await u.db("o_video").insert({
 79:       filePath: videoPath,
 80:       time: Date.now(),
 81:       state: "生成中",
 82:       scriptId,
 83:       projectId,
 84:       videoTrackId: trackId,
 85:     });
 86:     res.status(200).send(success(videoId));
 87:     const relatedObjects = {
 88:       projectId,
 89:       videoId,
 90:       scriptId,
 91:       type: "视频",
 92:     };
 93:     const aiVideo = u.Ai.Video(model);
 94:     aiVideo
 95:       .run(
 96:         {
 97:           prompt,
