  8: const router = express.Router();
  9: 
 10: type Type = "imageReference" | "startImage" | "endImage" | "videoReference" | "audioReference";
 11: interface UploadItem {
 12:   fileType: "image" | "video" | "audio";
 13:   type: Type;
 14:   sources?: "assets" | "storyboard";
 15:   id?: number;
 16:   src?: string;
