  8: const router = express.Router();
  9: 
 10: type Type = "imageReference" | "startImage" | "endImage" | "videoReference" | "audioReference";
 11: interface UploadItem {
 12:   fileType: "image" | "video" | "audio";
 13:   type: Type;
 14:   sources?: "assets" | "storyboard";
 15:   id?: number;
 16:   src?: string;
 17:   label?: string;
 18:   prompt?: string;
 19: }
 20: 
 21: export default router.post(
 22:   "/",
 23:   validateFields({
 24:     projectId: z.number(),
 25:     scriptId: z.number(),
 26:     trackData: z.array(
 27:       z.object({
 28:         uploadData: z.array(
 29:           z.object({
 30:             id: z.number(),
 31:             sources: z.string(),
 32:           }),
 33:         ),
 34:         trackId: z.number(),
 35:         prompt: z.string(),
 36:         duration: z.number(),
 37:       }),
 38:     ),
 39:     model: z.string(),
 40:     mode: z.string(),
 41:     resolution: z.string(),
 42:     audio: z.boolean().optional(),
 43:   }),
 44:   async (req, res) => {
 45:     const { scriptId, projectId, trackData, model, resolution, audio, mode } = req.body;
 46: 
 47:     let modeData = [];
 48:     if (Array.isArray(mode)) {
 49:     } else if (typeof mode === "string" && mode.startsWith('["') && mode.endsWith('"]')) {
 50:       try {
 51:         modeData = JSON.parse(mode);
 52:       } catch (e) {}
 53:     }
 54: 
 55:     // 获取生成视频比例
 56:     const ratio = await u.db("o_project").select("videoRatio").where("id", projectId).first();
 57: 
 58:     // 为每个 track 预处理数据并插入数据库，返回任务列表
 59:     const tasks = await Promise.all(
 60:       (trackData as { uploadData: { id: number; sources: string }[]; trackId: number; prompt: string; duration: number }[]).map(async (track) => {
 61:         const { uploadData, trackId, prompt, duration } = track;
 62: 
 63:         // 查询出图片数据
 64:         const images = await Promise.all(
 65:           uploadData.map(async (item) => {
 66:             if (item.sources === "storyboard") {
 67:               const filePath = await u.db("o_storyboard").where("id", item.id).select("filePath").first();
 68:               return { path: filePath?.filePath, sources: "storyBoard" };
 69:             }
 70:             if (item.sources === "assets") {
 71:               const filePath = await u
 72:                 .db("o_assets")
 73:                 .where("o_assets.id", item.id)
 74:                 .leftJoin("o_image", "o_assets.imageId", "o_image.id")
 75:                 .select("o_image.filePath", "o_image.type")
 76:                 .first();
 77:               return { path: filePath?.filePath, sources: filePath.type };
 78:             }
 79:           }),
 80:         );
 81: 
 82:         const videoPath = `/${projectId}/video/${uuidv4()}.mp4`;
 83:         const [videoId] = await u.db("o_video").insert({
 84:           filePath: videoPath,
 85:           time: Date.now(),
 86:           state: "生成中",
 87:           scriptId,
 88:           projectId,
 89:           videoTrackId: trackId,
 90:         });
 91: 
 92:         return { videoId, videoPath, prompt, duration, images, trackId };
 93:       }),
 94:     );
 95: 
 96:     res.status(200).send(success(tasks.map((t) => ({ videoId: t.videoId, trackId: t.trackId }))));
 97:     for (const { videoId, videoPath, prompt, duration, images } of tasks) {
 98:       // 所有任务全部并发后台执行，完全不阻塞任何进程
 99:       const base64 = await Promise.all(
100:         images.map(async (item) => {
101:           if (!item) return null;
102:           return { base64: await u.oss.getImageBase64(item.path), type: item.sources == "audio" ? "audio" : "image" };
103:         }),
104:       );
105:       const relatedObjects = { projectId, videoId, scriptId, type: "视频" };
106:       const aiVideo = u.Ai.Video(model);
107:       aiVideo
108:         .run(
109:           {
110:             prompt,
111:             referenceList: base64.filter(Boolean) as ReferenceList[],
112:             mode: modeData.length > 0 ? modeData : mode,
113:             duration,
114:             aspectRatio: (ratio?.videoRatio as "16:9" | "9:16") || "16:9",
115:             resolution,
116:             audio,
117:           },
118:           {
119:             projectId,
120:             taskClass: "视频生成",
121:             describe: "根据提示词生成视频",
122:             relatedObjects: JSON.stringify(relatedObjects),
123:           },
124:         )
125:         .then(async () => await aiVideo.save(videoPath))
126:         .then(async () => await u.db("o_video").where("id", videoId).update({ state: "生成成功" }))
127:         .catch(async (error: any) => {
128:           await u
129:             .db("o_video")
130:             .where("id", videoId)
131:             .update({
132:               state: "生成失败",
133:               errorReason: u.error(error).message,
134:             });
135:         });
136:     }
137:   },
138: );
</file>

