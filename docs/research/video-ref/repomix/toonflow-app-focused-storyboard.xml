 6: import axios from "axios";
 7: const router = express.Router();
 8: 
 9: async function urlToBase64(imageUrl: string): Promise<string> {
10:   if (imageUrl.startsWith("/oss/")) {
11:     return await u.oss.getImageBase64(u.replaceUrl(imageUrl).replace("/smallImage", ""));
12:   }
13:   imageUrl = await u.oss.getFileUrl(u.replaceUrl(imageUrl));
14:   const response = await axios.get(imageUrl, { responseType: "arraybuffer" });
15:   const contentType = response.headers["content-type"] || "image/png";
16:   const base64 = Buffer.from(response.data, "binary").toString("base64");
17:   return `data:${contentType};base64,${base64}`;
18: }
19: export default router.post(
20:   "/",
21:   validateFields({
22:     model: z.string(),
23:     references: z.array(z.string()).optional(),
24:     quality: z.string(),
25:     ratio: z.string(),
26:     prompt: z.string(),
27:     projectId: z.number(),
28:   }),
29:   async (req, res) => {
30:     const { model, references = [], quality, ratio, prompt, projectId } = req.body;
31:     try {
32:       const imageClass = await u.Ai.Image(model).run(
33:         {
34:           prompt: prompt,
35:           referenceList: await (async () => {
36:             const list: { type: "image"; base64: string }[] = [];
37:             for (const url of references) {
38:               list.push({ type: "image" as const, base64: await urlToBase64(url) });
39:             }
40:             return list;
41:           })(),
42:           size: quality,
43:           aspectRatio: ratio,
44:         },
45:         {
46:           taskClass: "工作流图片生成",
47:           describe: "工作流图片生成",
48:           relatedObjects: JSON.stringify(req.body),
49:           projectId: projectId,
50:         },
51:       );
52:       const savePath = `${projectId}/workFlow/${u.uuid()}.jpg`;
53:       await imageClass.save(savePath);
54: 
55:       const url = await u.oss.getSmallImageUrl(savePath);
56:       return res.status(200).send(success({ url }));
57:     } catch (e) {
58:       res.status(400).send(error(u.error(e).message));
59:     }
60:   },
61: );
</file>

