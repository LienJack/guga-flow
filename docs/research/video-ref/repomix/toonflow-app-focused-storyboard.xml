  1: import express from "express";
  2: import u from "@/utils";
  3: import { z } from "zod";
  4: import { error, success } from "@/lib/responseFormat";
  5: import { validateFields } from "@/middleware/middleware";
  6: import { useSkill } from "@/utils/agent/skillsTools";
  7: import { tool, jsonSchema } from "ai";
  8: import { o_script } from "@/types/database";
  9: 
 10: const router = express.Router();
 11: 
 12: /** 新资产：AI 首次识别到的资产，需要完整信息 */
 13: const NewAssetSchema = z.object({
 14:   name: z.string().describe("资产名称,仅为名称不做其他任何表述"),
 15:   desc: z.string().describe("资产描述"),
 16:   type: z.enum(["role", "tool", "scene"]).describe("资产类型"),
 17:   scriptIds: z.array(z.number()).describe("使用该资产的剧本id数组"),
 18: });
 19: 
 20: /** 已有资产：数据库中已存在的资产，只需给出名称和关联的剧本 */
 21: const ExistingAssetRefSchema = z.object({
 22:   name: z.string().describe("已有资产的名称,必须与已有资产列表中的名称完全一致"),
 23:   scriptIds: z.array(z.number()).describe("使用该资产的剧本id数组"),
 24: });
 25: 
 26: export const AssetSchema = z.object({
 27:   name: z.string().describe("资产名称,仅为名称不做其他任何表述"),
 28:   desc: z.string().describe("资产描述"),
 29:   type: z.enum(["role", "tool", "scene"]).describe("资产类型"),
 30: });
 31: 
 32: type NewAsset = z.infer<typeof NewAssetSchema>;
 33: type ExistingAssetRef = z.infer<typeof ExistingAssetRefSchema>;
 34: type Asset = z.infer<typeof AssetSchema>;
 35: 
 36: /** 每批 AI 调用的结果 */
 37: type GroupResult = {
 38:   batchScriptIds: number[];
 39:   newAssets: NewAsset[];
 40:   existingRefs: ExistingAssetRef[];
 41: } | null;
 42: 
 43: /** 将 scriptIds 数组按 groupSize 分组 */
 44: function chunkArray(arr: number[], groupSize: number): number[][][] {
 45:   const chunks: number[][] = [];
 46:   for (let i = 0; i < arr.length; i += 5) {
 47:     chunks.push(arr.slice(i, i + 5));
 48:   }
 49:   const groupChunks = [];
 50:   for (let i = 0; i < chunks.length; i += groupSize) {
 51:     groupChunks.push(chunks.slice(i, i + groupSize));
 52:   }
 53:   return groupChunks;
 54: }
 55: 
 56: export default router.post(
 57:   "/",
 58:   validateFields({
 59:     scriptIds: z.array(z.number()),
 60:     projectId: z.number(),
 61:     groupSize: z.number().min(1).optional(),
 62:   }),
 63:   async (req, res) => {
 64:     const { scriptIds, projectId, groupSize = 5 } = req.body;
 65: 
 66:     if (!scriptIds.length) return res.status(400).send(error("请先选择剧本"));
 67:     const scripts = await u.db("o_script").whereIn("id", scriptIds);
 68: 
 69:     // 构建 scriptId -> script 内容的映射
 70:     const scriptMap = new Map(scripts.map((s: o_script) => [s.id, s]));
 71: 
 72:     await u.db("o_script").whereIn("id", scriptIds).update({
 73:       extractState: 2,
 74:     });
 75: 
 76:     const errors: { scriptId: number; error: string }[] = [];
 77:     let successCount = 0;
 78: 
 79:     // 将 scriptIds 按 groupSize（默认5）分组，每组一起发给 AI
 80:     const scriptGroups = chunkArray(scriptIds as number[], groupSize);
 81: 
 82:     /** 一组剧本提取完成后统一入库并建立关联 */
 83:     async function persistGroupResult(result: GroupResult) {
 84:       if (!result) return;
 85:       const { batchScriptIds, newAssets, existingRefs } = result;
 86:       if (!newAssets.length && !existingRefs.length) return;
 87: 
 88:       // 查询已有资产
 89:       const existingAssets = await u.db("o_assets").where("projectId", projectId).select("id", "name");
 90:       const existingMap = new Map(existingAssets.map((a) => [a.name!, a.id!]));
 91: 
 92:       // 插入新资产（不在已有列表中的）
 93:       const toInsert = newAssets.filter((asset) => !existingMap.has(asset.name));
 94:       if (toInsert.length) {
 95:         await u.db("o_assets").insert(
 96:           toInsert.map((asset) => ({
 97:             name: asset.name,
 98:             type: asset.type,
 99:             describe: asset.desc,
100:             projectId: projectId,
101:             startTime: Date.now(),
102:           })),
103:         );
104:       }
105: 
106:       // 重新查询获取完整的 name -> id 映射
107:       const allAssets = await u.db("o_assets").where("projectId", projectId).select("id", "name");
108:       const nameToId = new Map(allAssets.map((a) => [a.name, a.id]));
109: 
110:       // 收集所有资产与剧本的关联关系
111:       const scriptAssetRows: { scriptId: number; assetId: number }[] = [];
112: 
113:       // 新资产的关联
114:       for (const asset of newAssets) {
115:         const assetId = nameToId.get(asset.name);
116:         if (assetId) {
117:           for (const sid of asset.scriptIds) {
118:             scriptAssetRows.push({ scriptId: sid, assetId });
119:           }
120:         }
121:       }
122: 
123:       // 已有资产的关联
124:       for (const ref of existingRefs) {
125:         const assetId = nameToId.get(ref.name);
126:         if (assetId) {
127:           for (const sid of ref.scriptIds) {
128:             scriptAssetRows.push({ scriptId: sid, assetId });
129:           }
130:         }
131:       }
132: 
133:       // 去重：相同 scriptId + assetId 只保留一条
134:       const uniqueRows = [...new Map(scriptAssetRows.map((r) => [`${r.scriptId}_${r.assetId}`, r])).values()];
135: 
136:       // 先删除本批 scriptId 的旧关联，再插入新的
137:       await u.db("o_scriptAssets").whereIn("scriptId", batchScriptIds).delete();
138:       if (uniqueRows.length) {
139:         await u.db("o_scriptAssets").insert(uniqueRows);
140:       }
141: 
142:       // 本批成功的剧本状态更新为 1（成功）
143:       await u.db("o_script").whereIn("id", batchScriptIds).where("projectId", projectId).update({
144:         extractState: 1,
145:         errorReason: null,
146:       });
147:     }
148:     res.send(success("开始提取资产"));
149: 
150:     function processGroup(group: number[][][]) {
151:       group.map(async (itemIds) => {
152:         const validScripts: { id: number; script: o_script }[] = [];
153:         for (const scriptIds of itemIds as number[][]) {
154:           for (const scriptId of scriptIds) {
155:             const script = scriptMap.get(scriptId);
156:             if (!script) {
157:               errors.push({ scriptId, error: "未找到对应剧本" });
158:               await u.db("o_script").where("id", scriptId).where("projectId", projectId).update({ extractState: -1, errorReason: "未找到对应剧本" });
159:             } else {
160:               // 查看状态是否为等待提取，仅对等待提取进行生成
161:               const item = await u.db("o_script").where("projectId", projectId).where("id", scriptId).select("extractState").first();
162:               if (item?.extractState == 2) {
163:                 validScripts.push({ id: scriptId, script });
164:               }
165:             }
166:           }
167:         }
168:         if (!validScripts.length) return;
169:         const validScriptIds = validScripts.map((v) => v.id);
170:         // 修改状态为正在提取中
171:         await u.db("o_script").where("projectId", projectId).whereIn("id", validScriptIds).update({
172:           extractState: 0, // 正在提取
173:         });
174:         // 查询当前项目已有的资产列表，提供给 AI 参考
175:         const existingAssets = await u.db("o_assets").where("projectId", projectId).select("name", "type");
176:         const existingAssetsList = existingAssets.map((a) => `${a.name}(${a.type})`).join("、");
177: 
178:         // 拼接多集剧本内容，每集用分隔标记
179:         const scriptsContent = validScripts
180:           .map(({ id, script }) => `===== 【剧本ID: ${id}】${script.name || ""} =====\n${script.content}`)
181:           .join("\n\n");
182: 
183:         let collectedNew: NewAsset[] = [];
184:         let collectedExisting: ExistingAssetRef[] = [];
185:         try {
186:           const resultTool = tool({
187:             description: "返回结果时必须调用这个工具",
188:             inputSchema: jsonSchema<{ newAssets: NewAsset[]; existingAssetRefs: ExistingAssetRef[] }>(
189:               z
190:                 .object({
191:                   newAssets: z
192:                     .array(NewAssetSchema)
193:                     .describe("新发现的资产列表（不在已有资产列表中的），需要完整的 prompt、name、desc、type 和使用该资产的 scriptIds"),
194:                   existingAssetRefs: z
195:                     .array(ExistingAssetRefSchema)
196:                     .describe("已有资产的引用列表（在已有资产列表中已存在的），只需给出资产名称和使用该资产的 scriptIds"),
197:                 })
198:                 .toJSONSchema(),
199:             ),
200:             execute: async ({ newAssets, existingAssetRefs }) => {
201:               if (newAssets?.length) collectedNew = newAssets;
202:               if (existingAssetRefs?.length) collectedExisting = existingAssetRefs;
203:               return "无需回复用户任何内容";
204:             },
205:           });
206:           const promptData = await u.db("o_prompt").where("type", "scriptAssetExtraction").first();
207:           let scriptAssetExtraction = "" as string | undefined;
208:           if (promptData && promptData.useData) {
209:             scriptAssetExtraction = promptData.useData;
210:           } else {
211:             scriptAssetExtraction = promptData?.data ?? undefined;
212:           }
213:           const existingHint = existingAssetsList
214:             ? `\n\n【已有资产列表】：${existingAssetsList}\n对于已有资产，如果在剧本中出现，只需在 existingAssetRefs 中给出资产名称和对应的 scriptIds 数组即可，无需重复生成 desc/type。对于新发现的资产（不在已有列表中），请在 newAssets 中给出完整信息。`
215:             : "";
216:           const output = await u.Ai.Text("universalAi").invoke({
217:             messages: [
218:               {
219:                 role: "system",
220:                 content:
221:                   scriptAssetExtraction +
222:                   "\n\n提取剧本中涉及的资产（角色、场景、道具），参考技能 script_assets_extract 规范，结果必须通过 resultTool 工具返回。" +
223:                   "\n\n注意：本次会同时提供多集剧本，每集剧本以 ===== 【剧本ID: xxx】 ===== 分隔。你需要分析每集剧本使用了哪些资产，并在输出中用 scriptIds 数组标明每个资产在哪些剧本中出现。",
224:               },
225:               {
226:                 role: "user",
227:                 content: `当前已有资产列表：${existingHint}\n\n请根据以下${validScripts.length}集剧本提取对应的剧本资产（角色、场景、道具）:\n\n${scriptsContent}`,
228:               },
229:             ],
230:             tools: { resultTool },
231:           });
232:           await persistGroupResult({
233:             batchScriptIds: validScriptIds,
234:             newAssets: collectedNew,
235:             existingRefs: collectedExisting,
236:           });
237:         } catch (e) {
238:           console.error(`[extractAssets] group=[${validScriptIds.join(",")}] 提取失败:`, e);
239:           for (const { id, script } of validScripts) {
240:             errors.push({ scriptId: id, error: (script.name || "") + ":" + u.error(e).message });
241:             await u
242:               .db("o_script")
243:               .where("id", id)
244:               .where("projectId", projectId)
245:               .update({ extractState: -1, errorReason: u.error(e).message });
246:           }
247:           return;
248:         }
249:         if (!collectedNew.length && !collectedExisting.length) {
250:           for (const { id } of validScripts) {
251:             errors.push({ scriptId: id, error: "AI 未返回任何资产" });
252:             await u.db("o_script").where("id", id).where("projectId", projectId).update({ extractState: -1, errorReason: "AI 未返回任何资产" });
253:           }
254:           return;
255:         }
256:       });
257:     }
258:     processGroup(scriptGroups);
259:   },
260: );
</file>

