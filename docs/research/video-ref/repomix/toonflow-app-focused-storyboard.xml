 23:     const orderedFilePaths = storyboardIds.map((id: number) => filePathMap[id]);
 24: 
 25:     // 读取所有图片 buffer 并获取元数据
 26:     const loaded = await Promise.all(
 27:       orderedFilePaths.map(async (filePath: string) => {
 28:         if (!filePath) return null;
 29:         const buffer = await u.oss.getFile(filePath);
 30:         const metadata = await sharp(buffer).metadata();
 31:         return { buffer, width: metadata.width || 0, height: metadata.height || 0 };
 32:       }),
 33:     );
 34: 
 35:     // 过滤掉无效图片
 36:     const validImages = loaded.filter((img): img is NonNullable<typeof img> => img !== null && img.width > 0 && img.height > 0);
 37:     if (validImages.length === 0) {
 38:       return res.status(200).send(success(null));
 39:     }
 40: 
 41:     // 将每张图片缩放到合理尺寸，单张最大宽度 512px
 42:     const maxThumbWidth = 512;
 43:     const resizedImages = await Promise.all(
 44:       validImages.map(async (img) => {
 45:         if (img.width <= maxThumbWidth) {
 46:           return img;
 47:         }
 48:         const scale = maxThumbWidth / img.width;
 49:         const newWidth = maxThumbWidth;
 50:         const newHeight = Math.round(img.height * scale);
 51:         const buffer = await sharp(img.buffer).resize(newWidth, newHeight).toBuffer();
 52:         return { buffer, width: newWidth, height: newHeight };
 53:       }),
 54:     );
 55: 
 56:     // 计算网格布局
 57:     const cols = Math.min(5, resizedImages.length);
 58:     const rows = Math.ceil(resizedImages.length / cols);
 59: 
 60:     const colWidths: number[] = Array(cols).fill(0);
 61:     const rowHeights: number[] = Array(rows).fill(0);
 62:     resizedImages.forEach((img, idx) => {
 63:       const c = idx % cols;
 64:       const r = Math.floor(idx / cols);
 65:       colWidths[c] = Math.max(colWidths[c], img.width);
 66:       rowHeights[r] = Math.max(rowHeights[r], img.height);
 67:     });
 68: 
 69:     const canvasWidth = colWidths.reduce((a, b) => a + b, 0);
 70:     const canvasHeight = rowHeights.reduce((a, b) => a + b, 0);
 71: 
 72:     // 为每张图片生成带标号的合成层
 73:     const compositeInputs: sharp.OverlayOptions[] = [];
 74: 
 75:     for (let i = 0; i < resizedImages.length; i++) {
 76:       const img = resizedImages[i];
 77:       const c = i % cols;
 78:       const r = Math.floor(i / cols);
 79:       const x = colWidths.slice(0, c).reduce((a, b) => a + b, 0);
 80:       const y = rowHeights.slice(0, r).reduce((a, b) => a + b, 0);
 81: 
 82:       // 添加图片层
 83:       compositeInputs.push({
 84:         input: img.buffer,
 85:         left: x,
 86:         top: y,
 87:       });
 88: 
 89:       // 生成标号标签 SVG
 90:       const label = `S${String(i + 1).padStart(2, "0")}`;
 91:       const fontSize = Math.max(14, Math.min(img.width, img.height) * 0.06);
 92:       const padding = Math.round(fontSize * 0.4);
 93:       // 估算文字宽度（等宽近似）
 94:       const textWidth = Math.round(label.length * fontSize * 0.65);
 95:       const bgW = textWidth + padding * 2;
 96:       const bgH = Math.round(fontSize) + padding * 2;
 97: 
 98:       const labelSvg = Buffer.from(
 99:         `<svg xmlns="http://www.w3.org/2000/svg" width="${bgW}" height="${bgH}">
100:           <rect x="0" y="0" width="${bgW}" height="${bgH}" rx="4" ry="4" fill="rgba(0,0,0,0.55)"/>
101:           <text x="${padding}" y="${padding + fontSize * 0.85}" font-family="Arial, sans-serif" font-weight="bold" font-size="${fontSize}" fill="#fff">${label}</text>
102:         </svg>`,
103:       );
104: 
105:       compositeInputs.push({
106:         input: labelSvg,
107:         left: x + 4,
108:         top: y + 4,
109:       });
110:     }
111: 
112:     // 使用 sharp 创建画布并合成
113:     const resultBuffer = await sharp({
114:       create: {
115:         width: canvasWidth,
116:         height: canvasHeight,
117:         channels: 4,
118:         background: { r: 255, g: 255, b: 255, alpha: 1 },
119:       },
120:     })
121:       .composite(compositeInputs)
122:       .jpeg({ quality: 80 })
123:       .toBuffer();
124: 
125:     const base64 = resultBuffer.toString("base64");
126:     const dataUrl = `data:image/jpeg;base64,${base64}`;
127: 
128:     return res.status(200).send(success(dataUrl));
129:   },
130: );
</file>

