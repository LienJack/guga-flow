 18:     concurrentCount: z.number().min(1).optional(),
 19:     compulsory: z.boolean().optional(),
 20:   }),
 21:   async (req, res) => {
 22:     const {
 23:       storyboardIds,
 24:       projectId,
 25:       scriptId,
 26:       concurrentCount = 5,
 27:       compulsory = false,
 28:     }: {
 29:       storyboardIds: number[];
 30:       projectId: number;
 31:       scriptId: number;
 32:       concurrentCount: number;
 33:       compulsory: boolean;
 34:     } = req.body;
 35:     if (!storyboardIds || storyboardIds.length === 0) return res.status(400).send(error("storyboardIds不能为空"));
 36:     // 当没有 storyboardIds 时，通过 AI 生成新的分镜面板数据
 37:     let finalStoryboardIds: number[] = storyboardIds || [];
 38:     // shouldGenerateImage === 0 的分镜标记为「未生成」，其余标记为「生成中」
 39:     const storyboardData = await u.db("o_storyboard").where("scriptId", scriptId).where("projectId", projectId).whereIn("id", finalStoryboardIds);
 40:     if (!storyboardData.length) return res.status(500).send(error("未查到分镜数据"));
 41:     const storyIds = storyboardData.map((i) => i.id);
 42:     if (compulsory) {
 43:       await u.db("o_storyboard").whereIn("id", storyIds).where("scriptId", scriptId).update({ state: "生成中", shouldGenerateImage: 1 });
 44:     } else {
 45:       await u.db("o_storyboard").whereIn("id", storyIds).where("scriptId", scriptId).where("shouldGenerateImage", 0).update({ state: "未生成" });
 46:       await u.db("o_storyboard").whereIn("id", storyIds).where("scriptId", scriptId).where("shouldGenerateImage", 1).update({ state: "生成中" });
 47:     }
 48: 
 49:     const projectSettingData = await u.db("o_project").where("id", projectId).select("imageModel", "imageQuality", "artStyle", "videoRatio").first();
 50: 
 51:     // 按 rowid 顺序查出每个 storyboard 关联的 assetId 有序列表
 52:     const assets2StoryboardRows = await u
 53:       .db("o_assets2Storyboard")
 54:       .whereIn("storyboardId", storyIds)
 55:       .orderBy("rowid")
 56:       .select("storyboardId", "assetId");
 57: 
 58:     // 收集所有 assetId，批量查对应的 imageId
 59:     const allAssetIds = [...new Set(assets2StoryboardRows.map((r: any) => r.assetId))];
 60:     const assetImageMap: Record<number, number> = {};
 61:     if (allAssetIds.length > 0) {
 62:       const assetRows = await u.db("o_assets").whereIn("id", allAssetIds).select("id", "imageId");
 63:       assetRows.forEach((row: any) => {
 64:         assetImageMap[row.id] = row.imageId;
 65:       });
 66:     }
 67: 
 68:     // 按 rowid 顺序重建 assetRecord，值为有序的 imageId 列表
 69:     const assetRecord: Record<number, number[]> = {};
 70:     assets2StoryboardRows.forEach((item: any) => {
 71:       if (!assetRecord[item.storyboardId]) {
 72:         assetRecord[item.storyboardId] = [];
 73:       }
 74:       const imageId = assetImageMap[item.assetId];
 75:       if (imageId != null) {
 76:         assetRecord[item.storyboardId].push(imageId);
 77:       }
 78:     });
 79:     const realStoryData = await u.db("o_storyboard").where("scriptId", scriptId).where("projectId", projectId).whereIn("id", storyIds);
 80:     res.status(200).send(
 81:       success(
 82:         realStoryData.map((i) => ({
 83:           id: i.id,
 84:           prompt: i.prompt,
 85:           associateAssetsIds: assetRecord[i.id!],
 86:           src: null,
 87:           state: i.state,
 88:           videoDesc: i.videoDesc,
 89:           shouldGenerateImage: i.shouldGenerateImage,
 90:         })),
 91:       ),
 92:     );
 93: 
 94:     const generateTask = async (item: (typeof storyboardData)[number]) => {
 95:       const repeloadObj = {
 96:         prompt: item.prompt!,
 97:         size: projectSettingData?.imageQuality as "1K" | "2K" | "4K",
 98:         aspectRatio: projectSettingData?.videoRatio as `${number}:${number}`,
 99:       };
100:       try {
101:         const imageCls = await u.Ai.Image(projectSettingData?.imageModel as `${string}:${string}`).run(
102:           {
103:             referenceList: await getAssetsImageBase64(assetRecord[item.id!] || []),
104:             ...repeloadObj,
105:           },
106:           {
107:             taskClass: "生成分镜图片",
108:             describe: "分镜图片生成",
109:             relatedObjects: JSON.stringify(repeloadObj),
110:             projectId: projectId,
111:           },
112:         );
113:         const savePath = `/${projectId}/assets/${scriptId}/${u.uuid()}.jpg`;
114:         await imageCls.save(savePath);
115:         await u.db("o_storyboard").where("id", item.id).update({
116:           filePath: savePath,
117:           state: "已完成",
118:         });
119:       } catch (e) {
120:         u.db("o_storyboard")
121:           .where("id", item.id)
122:           .update({
123:             filePath: "",
124:             reason: u.error(e).message,
125:             state: "生成失败",
126:           });
127:       }
128:     };
129:     // 按 concurrentCount 控制并发数，分批执行；跳过 shouldGenerateImage === 0 的分镜
130:     let generateList = [];
131:     if (compulsory) {
132:       generateList = storyboardData;
133:     } else {
134:       generateList = storyboardData.filter((item) => item.shouldGenerateImage !== 0);
135:     }
136:     for (let i = 0; i < generateList.length; i += concurrentCount) {
137:       const batch = generateList.slice(i, i + concurrentCount);
138:       await Promise.all(batch.map(generateTask));
139:     }
140:   },
141: );
142: async function getAssetsImageBase64(imageIds: number[]) {
143:   if (!imageIds.length) return [];
144: 
145:   const imagePaths = await u.db("o_image").whereIn("o_image.id", imageIds).select("o_image.id", "o_image.filePath");
146: 
147:   // 建立 id 到 filePath 的映射
148:   const id2Path = new Map<number, string>();
149:   for (const row of imagePaths) {
150:     id2Path.set(row.id, row.filePath);
151:   }
152: 
153:   // 保证输出顺序与 imageIds 一致
154:   const imageUrls = await Promise.all(
155:     imageIds.map(async (id) => {
156:       const filePath = id2Path.get(id);
157:       if (filePath) {
158:         try {
159:           return await u.oss.getImageBase64(filePath);
160:         } catch {
161:           return null;
162:         }
163:       }
164:       return null;
165:     }),
166:   );
167:   // 保留顺序，并且过滤掉无效项
168:   return (imageUrls.filter(Boolean) as string[]).map((url) => ({ type: "image" as const, base64: url }));
169: }
