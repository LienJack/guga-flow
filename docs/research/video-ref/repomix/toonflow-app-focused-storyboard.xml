<file path="src/routes/production/editImage/uploadImage.ts">
 1: import express from "express";
 2: import u from "@/utils";
 3: import { success, error } from "@/lib/responseFormat";
 4: import { validateFields } from "@/middleware/middleware";
 5: import { z } from "zod";
 6: import { v4 as uuid } from "uuid";
 7: const router = express.Router();
 8: 
 9: // 文件上传（支持图片、音频、视频）
10: export default router.post(
11:   "/",
12:   validateFields({
13:     projectId: z.number(),
14:     scriptId: z.number(),
15:     base64Data: z.string(),
16:   }),
17:   async (req, res) => {
18:     const { base64Data, projectId, scriptId } = req.body;
19:     function getExtFromBase64(base64Data: string): string {
20:       const mime = base64Data.match(/^data:([^;]+);base64,/)?.[1] ?? "";
21:       const mimeMap: Record<string, string> = {
22:         // 图片
23:         "image/jpeg": "jpeg",
24:         "image/jpg": "jpg",
25:         "image/png": "png",
26:         // 音频
27:         "audio/mpeg": "mp3",
28:         "audio/mp3": "mp3",
29:         "audio/wav": "wav",
30:         // 视频
31:         "video/mp4": "mp4",
32:         "video/webm": "webm",
33:       };
34:       return mimeMap[mime] ?? "bin";
35:     }
36:     const ext = getExtFromBase64(base64Data);
37:     if (!["jpeg", "jpg", "png"].includes(ext)) {
38:       return res.status(400).send(error("不支持的文件类型"));
39:     }
40:     const savePath = `/${projectId}/imageFlow/${scriptId}/${uuid()}.${ext}`;
41: 
42:     await u.oss.writeFile(savePath, Buffer.from(base64Data.match(/base64,([A-Za-z0-9+/=]+)/)[1] ?? "", "base64"));
43:     const url = await u.oss.getSmallImageUrl(savePath);
44:     res.status(200).send(success(url));
45:   },
46: );
</file>

