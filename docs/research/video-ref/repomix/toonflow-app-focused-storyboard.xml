  5: import { validateFields } from "@/middleware/middleware";
  6: const router = express.Router();
  7: export default router.post(
  8:   "/",
  9:   validateFields({
 10:     data: z.array(
 11:       z.object({
 12:         prompt: z.string(),
 13:         duration: z.number(),
 14:         track: z.string(),
 15:         state: z.string(),
 16:         src: z.string().nullable(),
 17:         videoDesc: z.string(),
 18:         shouldGenerateImage: z.number(),
 19:         associateAssetsIds: z.array(z.number()),
 20:       }),
 21:     ),
 22:     scriptId: z.number(),
 23:     projectId: z.number(),
 24:   }),
 25:   async (req, res) => {
 26:     const { data, scriptId, projectId } = req.body;
 27:     if (!data.length) return res.status(400).send({ success: false, message: "数据不能为空" });
 28:     for (const item of data) {
 29:       const [id] = await u.db("o_storyboard").insert({
 30:         prompt: item.prompt,
 31:         duration: String(item.duration),
 32:         state: item.state,
 33:         scriptId,
 34:         projectId,
 35:         track: item.track,
 36:         videoDesc: item.videoDesc,
 37:         shouldGenerateImage: item.shouldGenerateImage,
 38:         createTime: Date.now(),
 39:       });
 40:       if (item.associateAssetsIds?.length) {
 41:         await u.db("o_assets2Storyboard").insert(
 42:           item.associateAssetsIds.map((assetId: number) => ({
 43:             assetId,
 44:             storyboardId: id,
 45:           })),
 46:         );
 47:       }
 48:       item.id = id;
 49:     }
 50:     const lastStoryboard = await u.db("o_storyboard").where("scriptId", scriptId);
 51:     if (!lastStoryboard || !lastStoryboard.length) return res.status(400).send(error("未查到分镜数据"));
 52:     //根据track分组
 53:     const storyboardGroupByTrack: Record<string, number[]> = {};
 54:     lastStoryboard.forEach((item: any) => {
 55:       if (!storyboardGroupByTrack[item.track]) {
 56:         storyboardGroupByTrack[item.track] = [];
 57:       }
 58:       storyboardGroupByTrack[item.track].push(item.id);
 59:     });
 60: 
 61:     //循环：先查询数据库中是否已存在相同track名称的trackId，有则复用，没有则新建
 62:     for (const track in storyboardGroupByTrack) {
 63:       const storyboardIds = storyboardGroupByTrack[track] ?? [];
 64: 
 65:       // 计算该track下所有分镜的duration总和
 66:       const trackDuration = lastStoryboard
 67:         .filter((item: any) => item.track == track)
 68:         .reduce((sum: number, item: any) => sum + Number(item.duration), 0);
 69: 
 70:       // 查找该scriptId下是否已有相同track名称且已分配trackId的分镜记录
 71:       const existingStoryboard = await u.db("o_storyboard").where({ scriptId, track }).whereNotNull("trackId").first();
 72: 
 73:       let trackId: number;
 74:       if (existingStoryboard?.trackId) {
 75:         // 已存在相同track名称的trackId，直接复用，并更新duration
 76:         trackId = existingStoryboard.trackId;
 77:         await u.db("o_videoTrack").where("id", trackId).update({ duration: trackDuration });
 78:       } else {
 79:         // 不存在，新建videoTrack
 80:         const newTrackId = Date.now()
 81:         await u.db("o_videoTrack").insert({
 82:           id: newTrackId,
 83:           scriptId,
 84:           projectId,
 85:           duration: trackDuration,
 86:         });
 87:         trackId = newTrackId;
 88:       }
 89: 
 90:       await u.db("o_storyboard").whereIn("id", storyboardIds).update({ trackId });
 91:     }
 92: 
 93:     const storyboardData = await Promise.all(
 94:       lastStoryboard.map(async (i) => {
 95:         return {
 96:           associateAssetsIds: await u.db("o_assets2Storyboard").where("storyboardId", i.id).orderBy("rowid").select("assetId").pluck("assetId"),
 97:           src: i.filePath ? await u.oss.getSmallImageUrl(i.filePath) : "",
 98:           id: i.id,
 99:           trackId: i.trackId,
100:           prompt: i.prompt,
101:           duration: Number(i.duration),
102:           state: i.state,
103:           scriptId: i.scriptId,
104:           reason: i.reason,
105:           videoDesc: i.videoDesc
106:         };
107:       }),
108:     );
109:     return res.status(200).send(success(storyboardData));
110:   },
111: );
