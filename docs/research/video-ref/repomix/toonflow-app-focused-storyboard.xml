49: async function initKnexType(knexDb: any) {
50:   const { Client } = await import("@rmp135/sql-ts");
51:   const outFile = "src/types/database.d.ts";
52:   const dbClient = Client.fromConfig({
53:     interfaceNameFormat: "${table}",
54:     typeMap: {
55:       number: ["bigint"],
56:       string: ["text", "varchar", "char"],
57:     },
58:   }).fetchDatabase(knexDb);
59:   const declarations = await dbClient.toTypescript();
60:   const dbObject = await dbClient.toObject();
61:   const customHeader = `//该文件由脚本自动生成，请勿手动修改`;
62:   // 清除上次的注释头
63:   let declBody = declarations.replace(/^\/\*[\s\S]*?\*\/\s*/, "");
64:   declBody = declBody.replace(/(\n\s*)\/\*([^*][\s\S]*?)\*\//g, "$1/**$2*/");
65:   const tableInterfaces = dbObject.schemas.flatMap((schema) => schema.tables.map((table) => table.interfaceName));
66:   const aggregateTypes = `
67: export interface DB {
68: ${tableInterfaces.map((name) => `  ${JSON.stringify(name)}: ${name};`).join("\n")}
69: }
70: `;
71:   // 哈希仅基于结构化信息，header和空格不算
72:   const hashSource = JSON.stringify({
73:     tableInterfaces,
74:     declBody,
75:   });
76:   const hash = crypto.createHash("md5").update(hashSource).digest("hex");
77:   // 文件内容
78:   const content = `// @db-hash ${hash}\n${customHeader}\n\n` + declBody + aggregateTypes;
79:   let needWrite = true;
80:   try {
81:     const current = await readFile(outFile, "utf8");
82:     // 文件头已存在相同 hash，不需要写
83:     const match = current.match(/^\/\/\s*@db-hash\s*([a-zA-Z0-9]+)\n/);
84:     const currentHash = match ? match[1] : null;
85:     if (currentHash === hash) {
86:       needWrite = false;
87:     }
88:   } catch (err) {
89:     needWrite = true;
90:   }
91:   if (needWrite) await writeFile(outFile, content, "utf8");
92: }
