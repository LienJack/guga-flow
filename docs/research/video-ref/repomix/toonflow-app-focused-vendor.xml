118: async function getVendorTemplateFn(fnName: FnName, modelName: `${string}:${string}`): Promise<any> {
119:   const [id, name] = modelName.split(/:(.+)/);
120:   const vendorConfigData = await u.db("o_vendorConfig").where("id", id).first();
121:   if (!vendorConfigData) throw new Error(`未找到供应商配置 id=${id}`);
122:   const modelList = await u.vendor.getModelList(id);
123:   const selectedModel = modelList.find((i: any) => i.modelName == name);
124:   if (!selectedModel) throw new Error(`未找到模型 ${name} id=${id}`);
125:   const code = u.vendor.getCode(id);
126:   const jsCode = transform(code, { transforms: ["typescript"] }).code;
127:   const running = u.vm(jsCode);
128:   if (running.vendor) {
129:     Object.assign(running.vendor.inputValues, JSON.parse(vendorConfigData.inputValues ?? "{}"));
130:     running.vendor.models = modelList;
