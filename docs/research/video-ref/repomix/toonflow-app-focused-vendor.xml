22: export async function getModelList(id: string): Promise<Array<any>> {
23:   const models = await u.db("o_vendorConfig").where("id", id).select("models").first();
24:   if (!models || !models.models) return [];
25:   const code = getCode(id);
26:   const jsCode = transform(code, { transforms: ["typescript"] }).code;
27:   const vendorData = u.vm(jsCode);
28:   if(!vendorData || !vendorData.vendor || !vendorData.vendor.models) return [];
29:   const combined = [...JSON.parse(JSON.stringify(vendorData.vendor.models)), ...JSON.parse(models?.models ?? "[]")];
30:   const map = new Map<string, any>();
31:   for (const m of combined) {
32:     map.set(m.modelName, m);
33:   }
34:   return [...map.values()];
