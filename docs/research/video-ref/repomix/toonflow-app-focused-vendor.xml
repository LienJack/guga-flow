<file path="src/routes/setting/about/checkUpdate.ts">
 1: import express from "express";
 2: import { success, error } from "@/lib/responseFormat";
 3: import { validateFields } from "@/middleware/middleware";
 4: import { z } from "zod";
 5: const router = express.Router();
 6: 
 7: import fs from "fs";
 8: import path from "path";
 9: 
10: declare const __APP_VERSION__: string | undefined;
11: 
12: const APP_VERSION: string = (() => {
13:   if (typeof __APP_VERSION__ !== "undefined") {
14:     return __APP_VERSION__;
15:   }
16:   // 开发环境回退：从 package.json 读取
17:   const pkgPath = path.resolve(process.cwd(), "package.json");
18:   const pkg = JSON.parse(fs.readFileSync(pkgPath, "utf8"));
19:   return pkg.version;
20: })();
21: 
22: export default router.post(
23:   "/",
24:   validateFields({
25:     source: z.enum(["toonflow", "github", "gitee", "atomgit"]),
26:     url: z.url().nullable().optional(),
27:   }),
28:   async (req, res) => {
29:     const { source, url } = req.body;
30: 
31:     const getUrl = url ?? "https://toonflow.oss-cn-beijing.aliyuncs.com/update.json";
32: 
33:     const versionInfo = await fetch(getUrl).then((res) => res.json());
34:     if (!versionInfo) return res.status(400).send(error("无法获取版本信息"));
35:     const { version: tagger, time, data } = versionInfo;
36: 
37:     const sourceData = data[source];
38:     if (!sourceData) return res.status(400).send(error("无法获取该源的下载信息"));
39: 
40:     const platformType: Record<string, string> = {
41:       win32: "windows",
42:       darwin: "macos",
43:       linux: "linux",
44:     };
45: 
46:     const zipItem = sourceData.find((d: any) => d.type === "zip");
47:     const installerItem = sourceData.find((d: any) => d.type === platformType[process.platform]);
48: 
49:     const taggerList = tagger.split(".").map(Number);
50:     const currentVersionList = APP_VERSION.split(".").map(Number);
51:     //对比Major
52:     if (taggerList[0] > currentVersionList[0]) {
53:       if (!installerItem) return res.status(400).send(error("该源暂无适用于当前系统的安装包"));
54:       return res
55:         .status(200)
56:         .send(success({ needUpdate: true, latestVersion: tagger, reinstall: true, time, url: installerItem.url, version: tagger }));
57:     }
58:     //对比Minor
59:     if (taggerList[1] > currentVersionList[1]) {
60:       if (!installerItem) return res.status(400).send(error("该源暂无适用于当前系统的安装包"));
61:       return res
62:         .status(200)
63:         .send(success({ needUpdate: true, latestVersion: tagger, reinstall: true, time, url: installerItem.url, version: tagger }));
64:     }
65:     //Patch
66:     if (taggerList[2] > currentVersionList[2]) {
67:       if (!zipItem) return res.status(400).send(error("该源暂无增量更新包"));
68:       return res.status(200).send(success({ needUpdate: true, latestVersion: tagger, reinstall: false, time, url: zipItem.url, version: tagger }));
69:     }
70:     return res.status(200).send(success({ needUpdate: false, latestVersion: tagger, reinstall: false, time, version: tagger }));
71:   },
72: );
</file>

<file path="src/routes/setting/about/downloadApp.ts">
 1: import express from "express";
 2: import z from "zod";
 3: import { validateFields } from "@/middleware/middleware";
 4: import u from "@/utils";
 5: import fs from "fs";
 6: import axios from "axios";
 7: import compressing from "compressing";
 8: import { success } from "@/lib/responseFormat";
 9: const router = express.Router();
10: 
11: export default router.post(
