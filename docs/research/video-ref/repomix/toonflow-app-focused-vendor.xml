 62: /**
 63:  * 压缩图片，目标字节数不高于 size
 64:  */
 65: export async function zipImage(completeBase64: string, size: number): Promise<string> {
 66:   let quality = 80;
 67:   let buffer = Buffer.from(completeBase64.split(",")[1], "base64");
 68:   let output = await sharp(buffer).jpeg({ quality }).toBuffer();
 69:   while (output.length > size && quality > 10) {
 70:     quality -= 10;
 71:     output = await sharp(buffer).jpeg({ quality }).toBuffer();
 72:   }
 73:   return "data:image/jpeg;base64," + output.toString("base64");
 74: }
