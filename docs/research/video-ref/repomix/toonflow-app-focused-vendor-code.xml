190: /**
191:  * 压缩Buffer到指定大小以内
192:  */
193: async function compressToSize(imageBuffer: Buffer, maxBytes: number, originalWidth: number, originalHeight: number): Promise<Buffer> {
194:   let quality = 90;
195:   let scale = 1;
196: 
197:   while (true) {
198:     const targetWidth = Math.round(originalWidth * scale);
199:     const targetHeight = Math.round(originalHeight * scale);
200: 
201:     const resultBuffer = await sharp(imageBuffer).resize(targetWidth, targetHeight, { fit: "fill" }).jpeg({ quality }).toBuffer();
202: 
203:     if (resultBuffer.length <= maxBytes) {
204:       return resultBuffer;
205:     }
206: 
207:     if (quality > 10) {
208:       quality -= 10;
209:     } else {
210:       quality = 90;
211:       scale *= 0.8;
212:     }
213:   }
214: }
