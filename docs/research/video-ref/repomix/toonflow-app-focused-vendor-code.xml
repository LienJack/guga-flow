187:     const switchAiDevTool = await u.db("o_setting").where("key", "switchAiDevTool").first();
188:     const modelName = await resolveModelName(this.AiType);
189:     const sdkFn = await getVendorTemplateFn("textRequest", modelName);
190:     const baseModel = await sdkFn(this.think, this.thinkLevel);
191:     const mws = [
192:       ...(switchAiDevTool?.value === "1" ? [devToolsMiddleware()] : []),
193:       ...(middleware ? (Array.isArray(middleware) ? middleware : [middleware]) : []),
194:     ];
195:     return mws.length > 0 ? wrapLanguageModel({ model: baseModel, middleware: mws.length === 1 ? mws[0] : mws }) : baseModel;
196:   }
197:   async invoke(input: Omit<Parameters<typeof generateText>[0], "model">) {
198:     const config = await getModelConfig(this.AiType);
199: 
200:     return generateText({
201:       ...(input.tools && { stopWhen: stepCountIs(Object.keys(input.tools).length * 50) }),
202:       ...input,
203:       model: await this.resolveModel(),
204:       ...(config?.temperature && { temperature: config.temperature }),
205:       ...(config?.maxOutputTokens && { maxOutputTokens: config.maxOutputTokens }),
206:     } as Parameters<typeof generateText>[0]);
207:   }
208:   async stream(input: Omit<Parameters<typeof streamText>[0], "model">) {
