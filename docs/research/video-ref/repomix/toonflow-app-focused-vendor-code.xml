10: declare const __APP_VERSION__: string | undefined;
11: 
12: const APP_VERSION: string = (() => {
13:   if (typeof __APP_VERSION__ !== "undefined") {
14:     return __APP_VERSION__;
15:   }
16:   // 开发环境回退：从 package.json 读取
17:   const pkgPath = path.resolve(process.cwd(), "package.json");
18:   const pkg = JSON.parse(fs.readFileSync(pkgPath, "utf8"));
19:   return pkg.version;
20: })();
