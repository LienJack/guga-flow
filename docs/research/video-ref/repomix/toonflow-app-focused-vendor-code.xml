 9: const router = express.Router();
10: 
11: export default router.post(
12:   "/",
13:   validateFields({
14:     url: z.url(),
15:     reinstall: z.boolean(),
16:     version: z.string(),
17:   }),
18:   async (req, res) => {
19:     const { reinstall, url, version } = req.body;
20:     if (reinstall) {
21:       res.status(200).send(success("请在浏览器中手动下载并安装最新版本"));
22:     } else {
23:       const rootDir = u.getPath(["temp"]);
24:       fs.mkdirSync(rootDir, { recursive: true });
25:       const zip = await axios.get(url, { responseType: "arraybuffer" }).then((res) => res.data);
26:       fs.writeFileSync(`${rootDir}/latest.zip`, zip);
27:       await compressing.zip.uncompress(`${rootDir}/latest.zip`, rootDir);
28:       const dataDir = u.getPath();
29:       fs.cpSync(rootDir, dataDir, { recursive: true, force: true });
30:       fs.rmSync(rootDir, { recursive: true, force: true });
31:       res.status(200).send(success(`更新${version}成功，5秒后重启`));
32:     }
33:   },
34: );
