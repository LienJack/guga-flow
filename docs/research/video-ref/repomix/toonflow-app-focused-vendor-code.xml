164: async function urlToBase64(url: string, retries = 3, delay = 1000): Promise<string> {
165:   for (let attempt = 1; attempt <= retries; attempt++) {
166:     try {
167:       const res = await axios.get(url, { responseType: "arraybuffer" });
168:       const base64 = Buffer.from(res.data).toString("base64");
169:       return `${base64}`;
170:     } catch (e) {
171:       if (attempt === retries) throw e;
172:       await new Promise((resolve) => setTimeout(resolve, delay * attempt));
173:     }
174:   }
175:   throw new Error("urlToBase64 failed");
176: }
