109: /**
110:  * 将多张图片横向拼接为一张，并确保输出大小不超过指定限制
111:  * @param imageBase64List - base64编码的图片数组
112:  * @param maxSize - 最大输出大小，支持格式如 "10mb", "5MB", "1024kb" 等
113:  * @returns 拼接后的图片base64字符串
114:  */
115: export async function mergeImages(imageBase64List: string[], maxSize = "10mb"): Promise<string> {
116:   if (imageBase64List.length === 0) {
117:     throw new Error("图片列表不能为空");
118:   }
119: 
120:   const maxBytes = parseSize(maxSize);
121:   const imageBuffers = imageBase64List.map(base64ToBuffer);
122:   const imageMetadatas = await Promise.all(imageBuffers.map((buffer) => sharp(buffer).metadata()));
123:   const maxHeight = Math.max(...imageMetadatas.map((m) => m.height || 0));
124: 
125:   // 计算各图片调整后的宽度
126:   const imageWidths = imageMetadatas.map((metadata) => {
127:     const aspectRatio = (metadata.width || 1) / (metadata.height || 1);
128:     return Math.round(maxHeight * aspectRatio);
129:   });
130:   const totalWidth = imageWidths.reduce((sum, w) => sum + w, 0);
131: 
132:   // 拼接图片
133:   const resizedImages = await Promise.all(
134:     imageBuffers.map(async (buffer, index) => {
135:       return sharp(buffer).resize(imageWidths[index], maxHeight, { fit: "cover" }).toBuffer();
136:     }),
137:   );
138: 
139:   let currentX = 0;
140:   const compositeInputs = resizedImages.map((buffer, index) => {
141:     const input = { input: buffer, left: currentX, top: 0 };
142:     currentX += imageWidths[index];
143:     return input;
144:   });
145: 
146:   const mergedBuffer = await sharp({
147:     create: {
148:       width: totalWidth,
149:       height: maxHeight,
150:       channels: 4,
151:       background: { r: 255, g: 255, b: 255, alpha: 1 },
152:     },
153:   })
154:     .composite(compositeInputs)
155:     .jpeg({ quality: 90 })
156:     .toBuffer();
157: 
158:   // 复用压缩逻辑
159:   const resultBuffer = await compressToSize(mergedBuffer, maxBytes, totalWidth, maxHeight);
160:   return resultBuffer.toString("base64");
161: }
162: 
163: /**
164:  * 解析大小字符串为字节数
165:  */
166: function parseSize(size: string): number {
167:   const match = size.toLowerCase().match(/^(\d+(?:\.\d+)?)\s*(kb|mb|gb|b)?$/);
168:   if (!match) {
169:     throw new Error(`无效的大小格式: ${size}`);
170:   }
171:   const value = parseFloat(match[1]);
172:   const unit = match[2] || "b";
173:   const multipliers: Record<string, number> = {
174:     b: 1,
175:     kb: 1024,
176:     mb: 1024 * 1024,
177:     gb: 1024 * 1024 * 1024,
178:   };
179:   return Math.floor(value * multipliers[unit]);
180: }
181: 
182: /**
183:  * 将base64字符串转换为Buffer
184:  */
185: function base64ToBuffer(base64: string): Buffer {
186:   const base64Data = base64.replace(/^data:image\/\w+;base64,/, "");
187:   return Buffer.from(base64Data, "base64");
188: }
