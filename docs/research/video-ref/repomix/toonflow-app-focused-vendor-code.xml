<file path="src/routes/setting/dbConfig/importData.ts">
 1: import express from "express";
 2: import { success, error } from "@/lib/responseFormat";
 3: import { db } from "@/utils/db";
 4: import initDB from "@/lib/initDB";
 5: 
 6: const router = express.Router();
 7: 
 8: export default router.post("/", async (req, res) => {
 9:   try {
10:     const { tables: importTables } = req.body;
11:     if (!importTables || typeof importTables !== "object") {
12:       return res.status(400).send(error("无效的导入数据格式"));
13:     }
14: 
15:     // 删除所有现有表
16:     const existingTables: { name: string }[] = await db.raw(
17:       `SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' AND name NOT LIKE 'knex_%'`,
18:     );
19: 
20:     await db.raw("PRAGMA foreign_keys = OFF");
21:     for (const table of existingTables) {
22:       await db.schema.dropTableIfExists(table.name);
23:     }
24:     await db.raw("PRAGMA foreign_keys = ON");
25: 
26:     // 重新初始化表结构
27:     await initDB(db as any);
28: 
29:     // 导入数据
30:     await db.raw("PRAGMA foreign_keys = OFF");
31:     for (const [tableName, rows] of Object.entries(importTables)) {
32:       if (!Array.isArray(rows) || rows.length === 0) continue;
33: 
34:       // 验证表名合法性（防止SQL注入）
35:       const tableExists = await db.raw(
36:         `SELECT name FROM sqlite_master WHERE type='table' AND name=?`,
37:         [tableName],
38:       );
39:       if (tableExists.length === 0) continue;
40: 
41:       // 清空表数据后插入导入数据
42:       await db.raw(`DELETE FROM "${tableName}"`);
43:       // 分批插入，每批100条
44:       for (let i = 0; i < rows.length; i += 100) {
45:         const batch = rows.slice(i, i + 100);
46:         await db(tableName).insert(batch);
47:       }
48:     }
49:     await db.raw("PRAGMA foreign_keys = ON");
50: 
51:     res.status(200).send(success("数据库导入成功"));
52:   } catch (err: any) {
53:     res.status(500).send(error(err?.message || "导入失败"));
54:   }
55: });
</file>

