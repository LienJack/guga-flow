<file path="src/routes/setting/vendorConfig/addVendor.ts">
  1: import express from "express";
  2: import { success, error } from "@/lib/responseFormat";
  3: import { validateFields } from "@/middleware/middleware";
  4: import u from "@/utils";
  5: import { z } from "zod";
  6: import { transform } from "sucrase";
  7: const router = express.Router();
  8: 
  9: const vendorConfigSchema = z.object({
 10:   id: z.string(),
 11:   author: z.string(),
 12:   description: z.string().optional(),
 13:   name: z.string(),
 14:   icon: z.string().optional(),
 15:   inputs: z.array(
 16:     z.object({
 17:       key: z.string(),
 18:       label: z.string(),
 19:       type: z.enum(["text", "password", "url"]),
 20:       required: z.boolean(),
 21:       placeholder: z.string().optional(),
 22:     }),
 23:   ),
 24:   inputValues: z.record(z.string(), z.string()),
 25:   models: z.array(
 26:     z.discriminatedUnion("type", [
 27:       z.object({
 28:         name: z.string(),
 29:         modelName: z.string(),
 30:         type: z.literal("text"),
 31:         think: z.boolean(),
 32:       }),
 33:       z.object({
 34:         name: z.string(),
 35:         modelName: z.string(),
 36:         type: z.literal("image"),
 37:         mode: z.array(z.enum(["text", "singleImage", "multiReference"])),
 38:       }),
 39:       z.object({
 40:         name: z.string(),
 41:         modelName: z.string(),
 42:         type: z.literal("video"),
 43:         mode: z.array(
 44:           z.union([
 45:             z.enum(["singleImage", "startEndRequired", "endFrameOptional", "startFrameOptional", "text", "audioReference", "videoReference"]),
 46:             z.array(z.string().regex(/^(videoReference|imageReference|audioReference):\d+$/)),
 47:           ]),
 48:         ),
 49:         audio: z.union([z.literal("optional"), z.boolean()]),
 50:         durationResolutionMap: z.array(
 51:           z.object({
 52:             duration: z.array(z.number()),
 53:             resolution: z.array(z.string()),
 54:           }),
 55:         ),
 56:       }),
 57:     ]),
 58:   ),
 59: });
 60: 
 61: export default router.post(
 62:   "/",
 63:   validateFields({
 64:     tsCode: z.string(),
 65:   }),
 66:   async (req, res) => {
 67:     const { tsCode } = req.body;
 68:     const jsCode = transform(tsCode, { transforms: ["typescript"] }).code;
 69:     const exports = u.vm(jsCode);
 70:     if (!exports) return res.status(400).send(success("脚本文件必须导出对象"));
 71:     if (!exports.textRequest) return res.status(400).send(success("脚本文件必须导出文本请求对象"));
 72:     if (!exports.imageRequest) return res.status(400).send(success("脚本文件必须导出图像请求对象"));
 73:     if (!exports.videoRequest) return res.status(400).send(success("脚本文件必须导出视频请求对象"));
 74:     if (!exports.vendor) return res.status(400).send(success("脚本文件必须导出vendor对象"));
 75:     const vendor = exports.vendor;
 76:     const result = vendorConfigSchema.safeParse(vendor);
 77:     if (!result.success) {
 78:       const issueLines = result.error.issues.map((issue, index) => {
 79:         const path = issue.path.length ? issue.path.join(".") : "root";
 80:         let detail = issue.message;
 81: 
 82:         if (issue.code === "invalid_union") {
 83:           const unionDetails = [
 84:             ...new Set(
 85:               issue.errors
 86:                 .flat()
 87:                 .map((e) => e.message)
 88:                 .filter(Boolean),
 89:             ),
 90:           ];
 91:           if (unionDetails.length > 0) {
 92:             detail = `${issue.message}（${unionDetails.join("；")}）`;
 93:           }
 94:         }
 95:         return `${index + 1}. ${path}: ${detail}`;
 96:       });
 97: 
 98:       return res.status(400).send(error(`vendor配置校验失败，共 ${issueLines.length} 处:\n${issueLines.join("\n")}`));
 99:     }
100: 
101:     if ((vendor.id as string).includes(":")) return res.status(400).send(error("id不能包含英文冒号"));
102:     const data = await u.db("o_vendorConfig").where("id", vendor.id).first();
103:     if (data) return res.status(500).send(error("供应商id已存在"));
104:     const [id] = await u.db("o_vendorConfig").insert({
105:       id: vendor.id,
106:       inputValues: JSON.stringify(vendor.inputValues ?? {}),
107:       models: JSON.stringify([]),
108:       enable: vendor.id == "toonflow" ? 1 : 0,
109:     });
110:     u.vendor.writeCode(vendor.id, tsCode);
111:     res.status(200).send(success(result.data));
112:   },
113: );
</file>

