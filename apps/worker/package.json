{
  "name": "@guga-flow/worker",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts --queue",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "worker:once": "tsx src/index.ts --once",
    "mock:workflow": "tsx src/index.ts"
  },
  "dependencies": {
    "@guga-flow/provider-contracts": "workspace:*",
    "@guga-flow/shared-types": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
