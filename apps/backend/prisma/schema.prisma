generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CanvasNodeType {
  novel
  scene_frame
  scene
  shot
  character_asset
  location_asset
  style_asset
  prop_asset
  image
  video
  editor_package
  note
}

enum CanvasEdgeRelation {
  derived_from
  story_seed
  belongs_to_scene
  references_character
  references_location
  references_style
  references_prop
  generated_image
  generated_video
  first_frame_for
  selected_version_for
  sent_to_editor
  sequence_next
}

enum NodeStatus {
  draft
  queued
  running
  provider_waiting
  succeeded
  failed
  cancelled
}

enum AssetType {
  image
  video
  audio
  document
  package
}

enum AssetPurpose {
  uploaded
  shot_keyframe
  shot_audio
  character_reference
  voice_reference
  location_reference
  style_reference
  background_music
  shot_clip
  editor_package
  canvas_fragment
}

enum GenerationJobStatus {
  queued
  running
  provider_waiting
  succeeded
  failed
  cancelled
}

enum GenerationOperation {
  novel_to_storyboard
  asset_caption
  asset_classification
  shot_to_image
  character_to_image
  location_to_image
  image_refinement
  image_to_video
  shot_to_video
  workflow_run
  batch_shots_to_images
  batch_images_to_videos
  editor_export
  agent_canvas_action
}

enum EditorExportStatus {
  queued
  running
  succeeded
  failed
}

enum ProviderKind {
  llm
  image
  video
  editor
}

enum StoryboardDraftStatus {
  draft
  valid
  invalid
  ready
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id                 String              @id @default(cuid())
  ownerUserId        String
  title              String
  description        String?
  defaultAspectRatio String              @default("9:16")
  generationSettingsJson Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  owner              User                @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  novels             NovelDocument[]
  storyboardDrafts   StoryboardDraft[]
  canvasDocuments    CanvasDocument[]
  nodes              CanvasNode[]
  edges              CanvasEdge[]
  assets             Asset[]
  assetCollections   AssetCollection[]
  assetTags          AssetTag[]
  generationJobs     GenerationJob[]
  editorExports      EditorExport[]
  providerConfigs    ProviderConfig[]
  workflowDefinitions WorkflowDefinition[]
  canvasFragmentImports CanvasFragmentImport[]
  programmableProviders ProgrammableProvider[]
  agentMemories      AgentMemory[]
  agentDeployment    AgentDeployment?
  skillTemplates     SkillTemplate[]
  novelEventGraphs   NovelEventGraph[]
  scriptDrafts       ScriptDraft[]

  @@index([ownerUserId])
}

model NovelDocument {
  id         String   @id @default(cuid())
  projectId  String
  title      String
  content    String
  sourceType String
  wordCount  Int
  language   String   @default("zh")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drafts     StoryboardDraft[]
  eventGraphs NovelEventGraph[]
  scriptDrafts ScriptDraft[]

  @@index([projectId])
}

model NovelEventGraph {
  id              String        @id @default(cuid())
  projectId       String
  novelDocumentId String
  chaptersJson    Json          @default("[]")
  eventsJson      Json          @default("[]")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  novelDocument   NovelDocument @relation(fields: [novelDocumentId], references: [id], onDelete: Cascade)

  @@index([projectId, novelDocumentId])
  @@index([novelDocumentId, createdAt])
}

model ScriptDraft {
  id              String        @id @default(cuid())
  projectId       String
  novelDocumentId String
  version         Int
  title           String
  strategy        String
  status          String        @default("draft")
  scriptJson      Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  novelDocument   NovelDocument @relation(fields: [novelDocumentId], references: [id], onDelete: Cascade)

  @@unique([novelDocumentId, version])
  @@index([projectId, novelDocumentId])
}

model StoryboardDraft {
  id                   String                @id @default(cuid())
  projectId            String
  novelDocumentId      String
  status               StoryboardDraftStatus @default(draft)
  storyboardJson       Json?
  validationIssuesJson Json                  @default("[]")
  provider             String
  model                String?
  errorMessage         String?
  readyForImport       Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  novelDocument        NovelDocument         @relation(fields: [novelDocumentId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([novelDocumentId])
}

model CanvasDocument {
  id           String       @id @default(cuid())
  projectId    String
  snapshotJson Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes        CanvasNode[]
  edges        CanvasEdge[]

  @@unique([projectId])
}

model CanvasNode {
  id               String             @id @default(cuid())
  projectId        String
  canvasDocumentId String
  tldrawShapeId    String
  type             CanvasNodeType
  title            String?
  x                Float              @default(0)
  y                Float              @default(0)
  width            Float              @default(320)
  height           Float              @default(220)
  zIndex           Int                @default(0)
  status           NodeStatus         @default(draft)
  dataJson         Json               @default("{}")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canvasDocument   CanvasDocument     @relation(fields: [canvasDocumentId], references: [id], onDelete: Cascade)
  sourceEdges      CanvasEdge[]       @relation("SourceNodeEdges")
  targetEdges      CanvasEdge[]       @relation("TargetNodeEdges")
  sourceJobs       GenerationJob[]    @relation("SourceNodeJobs")
  targetJobs       GenerationJob[]    @relation("TargetNodeJobs")
  versions         NodeVersion[]

  @@unique([canvasDocumentId, tldrawShapeId])
  @@index([projectId, type])
  @@index([canvasDocumentId])
}

model CanvasEdge {
  id                 String             @id @default(cuid())
  projectId          String
  canvasDocumentId   String
  sourceNodeId       String
  targetNodeId       String
  sourceShapeId      String?
  targetShapeId      String?
  visualArrowShapeId String?
  relation           CanvasEdgeRelation
  dataJson           Json?
  createdAt          DateTime           @default(now())
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canvasDocument     CanvasDocument     @relation(fields: [canvasDocumentId], references: [id], onDelete: Cascade)
  sourceNode         CanvasNode         @relation("SourceNodeEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode         CanvasNode         @relation("TargetNodeEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([projectId, relation])
  @@index([canvasDocumentId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model Asset {
  id               String          @id @default(cuid())
  projectId        String
  collectionId     String?
  type             AssetType
  purpose          AssetPurpose
  storageKey       String
  mimeType         String
  originalFilename String?
  sizeBytes        Int?
  width            Int?
  height           Int?
  durationMs       Int?
  metadataJson     Json?
  createdAt        DateTime        @default(now())
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collection       AssetCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  tagAssignments   AssetTagAssignment[]
  editorExports    EditorExport[]

  @@unique([projectId, storageKey])
  @@index([projectId, type])
  @@index([projectId, collectionId])
}

model AssetCollection {
  id        String            @id @default(cuid())
  projectId String
  name      String
  parentId  String?
  kind      String            @default("manual")
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    AssetCollection?  @relation("AssetCollectionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  AssetCollection[] @relation("AssetCollectionTree")
  assets    Asset[]

  @@index([projectId, parentId])
  @@unique([projectId, name])
}

model AssetTag {
  id          String               @id @default(cuid())
  projectId   String
  name        String
  color       String?
  createdAt   DateTime             @default(now())
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments AssetTagAssignment[]

  @@index([projectId])
  @@unique([projectId, name])
}

model AssetTagAssignment {
  assetId    String
  tagId      String
  assignedAt DateTime @default(now())
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag        AssetTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@index([tagId])
}

model GenerationJob {
  id             String              @id @default(cuid())
  projectId      String
  operation      GenerationOperation
  status         GenerationJobStatus @default(queued)
  provider       String
  model          String?
  sourceNodeId   String?
  targetNodeId   String?
  providerTaskId String?
  inputJson      Json                @default("{}")
  outputJson     Json?
  errorMessage   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceNode     CanvasNode?         @relation("SourceNodeJobs", fields: [sourceNodeId], references: [id], onDelete: SetNull)
  targetNode     CanvasNode?         @relation("TargetNodeJobs", fields: [targetNodeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([providerTaskId])
}

model EditorExport {
  id            String             @id @default(cuid())
  projectId     String
  packageAssetId String?
  status        EditorExportStatus @default(queued)
  timelineJson  Json               @default("{}")
  storyboardCsv String?
  errorMessage  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  packageAsset  Asset?             @relation(fields: [packageAssetId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

model NodeVersion {
  id        String     @id @default(cuid())
  nodeId    String
  label     String?
  dataJson  Json       @default("{}")
  createdAt DateTime   @default(now())
  node      CanvasNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
}

model ProviderConfig {
  id           String       @id @default(cuid())
  projectId    String
  kind         ProviderKind
  provider     String
  enabled      Boolean      @default(false)
  displayName  String?
  defaultModel String?
  paramsJson   Json?
  secretJson   Json?
  lastTestStatus String?
  lastTestedAt DateTime?
  lastTestModel String?
  lastTestMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, provider])
  @@index([kind, provider])
}

model WorkflowDefinition {
  id              String                      @id @default(cuid())
  projectId       String
  kind            String
  provider        String
  displayName     String
  status          String                      @default("draft")
  activeVersionId String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  project         Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions        WorkflowDefinitionVersion[] @relation("WorkflowDefinitionVersions")
  activeVersion   WorkflowDefinitionVersion?  @relation("ActiveWorkflowDefinitionVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  @@unique([projectId, provider])
  @@index([projectId, kind])
  @@index([activeVersionId])
}

model WorkflowDefinitionVersion {
  id                   String               @id @default(cuid())
  workflowDefinitionId String
  version              Int
  sourceJson           Json
  mappingJson          Json
  diagnosticsJson      Json                 @default("[]")
  createdAt            DateTime             @default(now())
  workflowDefinition   WorkflowDefinition   @relation("WorkflowDefinitionVersions", fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  activeFor            WorkflowDefinition[] @relation("ActiveWorkflowDefinitionVersion")

  @@unique([workflowDefinitionId, version])
  @@index([workflowDefinitionId])
}

model CanvasFragmentImport {
  id            String   @id @default(cuid())
  projectId     String
  schemaVersion Int
  status        String
  summaryJson   Json     @default("{}")
  errorMessage  String?
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, createdAt])
}

model AgentMemory {
  id        String   @id @default(cuid())
  projectId String
  scope     String   @default("project")
  title     String
  content   String
  summary   String
  tagsJson  Json     @default("[]")
  source    String   @default("manual")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, enabled])
  @@index([projectId, scope])
}

model AgentDeployment {
  id        String   @id @default(cuid())
  projectId String   @unique
  mode      String   @default("simple")
  rolesJson Json     @default("{}")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SkillTemplate {
  id              String                 @id @default(cuid())
  projectId       String
  kind            String
  slug            String
  displayName     String
  description     String?
  enabled         Boolean                @default(true)
  activeVersionId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions        SkillTemplateVersion[] @relation("SkillTemplateVersions")
  activeVersion   SkillTemplateVersion?  @relation("ActiveSkillTemplateVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  @@unique([projectId, kind, slug])
  @@index([projectId, kind])
  @@index([activeVersionId])
}

model SkillTemplateVersion {
  id              String          @id @default(cuid())
  skillTemplateId String
  version         Int
  sourceText      String
  status          String
  diagnosticsJson Json            @default("[]")
  createdAt       DateTime        @default(now())
  skillTemplate   SkillTemplate   @relation("SkillTemplateVersions", fields: [skillTemplateId], references: [id], onDelete: Cascade)
  activeFor       SkillTemplate[] @relation("ActiveSkillTemplateVersion")

  @@unique([skillTemplateId, version])
  @@index([skillTemplateId])
  @@index([status])
}

model ProgrammableProvider {
  id              String                        @id @default(cuid())
  projectId       String
  kind            ProviderKind
  provider        String
  displayName     String
  description     String?
  activeVersionId String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  project         Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions        ProgrammableProviderVersion[] @relation("ProgrammableProviderVersions")
  activeVersion   ProgrammableProviderVersion?  @relation("ActiveProgrammableProviderVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  @@unique([projectId, kind, provider])
  @@index([projectId, kind])
  @@index([activeVersionId])
}

model ProgrammableProviderVersion {
  id                   String                 @id @default(cuid())
  programmableProviderId String
  version              Int
  sourceCode           String
  manifestJson         Json?
  status               String
  diagnosticsJson      Json                   @default("[]")
  createdAt            DateTime               @default(now())
  programmableProvider ProgrammableProvider   @relation("ProgrammableProviderVersions", fields: [programmableProviderId], references: [id], onDelete: Cascade)
  activeFor            ProgrammableProvider[] @relation("ActiveProgrammableProviderVersion")

  @@unique([programmableProviderId, version])
  @@index([programmableProviderId])
  @@index([status])
}
